# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
# Production requires a canonical HTTPS origin; development may use localhost HTTP.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://boarded_app:replace-password@127.0.0.1:5432/boarded
UPLOAD_DIR=/absolute/path/outside-public/boarded-uploads
# Fixed server-owned upload ceilings (not browser/environment overrides):
# 250 MiB / 500 files per account; 10 GiB / 10,000 files across the deployment.
# All purposes, unattached uploads and retained ownerless files count.
# Two in-flight uploads/decodes per Node process, one per account across processes.
# Capacity conflicts return 429; stored byte/count quota exhaustion returns 413.
# Keep the standalone deployment single-process for the shared decoder admission bound.

# Maintained email verification and password recovery require authenticated TLS SMTP.
# SMTP_PORT accepts any integer from 1 to 65535; SMTP_SECURE is required: false uses mandatory STARTTLS, true uses implicit TLS.
# Standard examples are 587/false and 465/true; authenticated relays may use high ports such as 1587.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-smtp-user
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM=Boarded <noreply@example.com>

# Public release identifier only, not a credential.
NEXT_PUBLIC_BUILD_ID=local-development

# Operator-only: provide separately to npm run db:migrate, NEVER to the runtime service.
# DATABASE_MIGRATION_URL=postgresql://boarded_migrator:replace-password@127.0.0.1:5432/boarded
