#!/bin/sh
set -eu
. "$(dirname "$0")/common.sh"
usage() { echo 'Usage: bin/generate-secrets [output-file]'; }
case "${1:-}" in -h|--help) usage; exit 0;; esac
[ "$#" -le 1 ] || { echo 'Unexpected arguments' >&2; exit 2; }
OUT=${1:-$ROOT/.env}
case "$OUT" in '') echo 'Output path must not be empty' >&2; exit 2;; */) echo 'Output path must name a file' >&2; exit 2;; esac
[ ! -e "$OUT" ] && [ ! -L "$OUT" ] || { echo "Refusing to overwrite $OUT" >&2; exit 1; }
dir=$(CDPATH= cd -P -- "$(dirname -- "$OUT")" && pwd) || { echo "Output directory does not exist: $(dirname -- "$OUT")" >&2; exit 1; }
base=$(basename -- "$OUT")
out_path=$dir/$base
require_trusted_ancestors "$dir" 'Output directory'
require_owned "$dir" 'Output directory'
command -v python3 >/dev/null 2>&1 || { echo 'python3 is required to generate secrets' >&2; exit 1; }
umask 077
tmp=
jwt_key=$(mktemp "$dir/.${base}.jwt.XXXXXX")
trap 'rm -f "$tmp" "$jwt_key"' EXIT HUP INT TERM
chmod 600 "$jwt_key"
openssl rand -hex 32 > "$jwt_key"
tmp=$(mktemp "$dir/.${base}.tmp.XXXXXX")
chmod 600 "$tmp"
url_secret() { openssl rand -base64 36 | tr '+/' '-_' | tr -d '=\n'; }
password=$(url_secret)
make_jwt() {
  role=$1; now=$(date +%s); exp=$((now + 315360000))
  header=$(printf '{"alg":"HS256","typ":"JWT"}' | openssl base64 -A | tr '+/' '-_' | tr -d '=')
  payload=$(printf '{"role":"%s","iss":"supabase","iat":%s,"exp":%s}' "$role" "$now" "$exp" | openssl base64 -A | tr '+/' '-_' | tr -d '=')
  sig=$(printf '%s.%s' "$header" "$payload" |
    python3 -c 'import base64, hashlib, hmac, pathlib, sys; key = pathlib.Path(sys.argv[1]).read_bytes().rstrip(b"\n"); sys.stdout.write(base64.urlsafe_b64encode(hmac.new(key, sys.stdin.buffer.read(), hashlib.sha256).digest()).rstrip(b"=").decode())' "$jwt_key")
  printf '%s.%s.%s' "$header" "$payload" "$sig"
}
{
  printf 'POSTGRES_PASSWORD=%s\nJWT_SECRET=' "$password"
  cat "$jwt_key"
  printf 'AUTHENTICATOR_DB_PASSWORD=%s\n' "$(url_secret)"
  printf 'SUPABASE_AUTH_ADMIN_PASSWORD=%s\n' "$(url_secret)"
  printf 'SUPABASE_STORAGE_ADMIN_PASSWORD=%s\n' "$(url_secret)"
  printf 'SUPABASE_FUNCTIONS_ADMIN_PASSWORD=%s\n' "$(url_secret)"
  printf 'PGBOUNCER_PASSWORD=%s\n' "$(url_secret)"
  printf 'ANON_KEY=%s\n' "$(make_jwt anon)"
  printf 'SERVICE_ROLE_KEY=%s\n' "$(make_jwt service_role)"
  cat <<'EOF'
API_PORT=8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
PGRST_DB_SCHEMAS=public,storage,graphql_public
EOF
} > "$tmp"
[ ! -e "$out_path" ] && [ ! -L "$out_path" ] || { echo "Refusing to overwrite $out_path" >&2; exit 1; }
# Same-directory rename publishes the fully written mode-0600 file atomically.
mv "$tmp" "$out_path"
tmp=
rm -f "$jwt_key"
jwt_key=
trap - EXIT HUP INT TERM
printf 'Wrote mode-0600 environment file: %s\n' "$out_path"
