# Copy to .env, chmod 600, and replace every required blank value.
# Prefer: bin/generate-secrets .env (writes locally without printing secrets).
POSTGRES_PASSWORD=
AUTHENTICATOR_DB_PASSWORD=
SUPABASE_AUTH_ADMIN_PASSWORD=
SUPABASE_STORAGE_ADMIN_PASSWORD=
SUPABASE_FUNCTIONS_ADMIN_PASSWORD=
PGBOUNCER_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Gateway is always bound to 127.0.0.1.
API_PORT=8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# Outgoing SMTP for signup confirmation (and recovery/invite) email.
# Leave SMTP_HOST empty only while email signup is effectively unusable:
# GoTrue then sends nothing (no-op mail client), so unconfirmed users can
# never sign in. SMTP_ADMIN_EMAIL/SMTP_SENDER_NAME form the From address.
# SMTP values are read by the strict preflight parser: addresses may contain
# `@`; SMTP_HOST, SMTP_PORT, SMTP_PASS, and SMTP_SENDER_NAME accept only
# letters, digits, and `_.:,/-` (no spaces, `$`, quotes, or metacharacters).
# SMTP_PORT must be numeric (1-65535) when set and otherwise defaults to 587.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=
PGRST_DB_SCHEMAS=public,storage,graphql_public
