+/// Custom tabs own presentation and accessibility; the native tab controller
+/// retains destination state and computes the unobscured content safe area.
+private struct NativeTabBarAccessibilityBoundary: UIViewControllerRepresentable {
+    func makeUIViewController(context: Context) -> Controller {
+        Controller()
+    }
+
+    func updateUIViewController(_ controller: Controller, context: Context) {
+        controller.hideNativeTabAccessibility()
+    }
+
+    final class Controller: UIViewController {
+        override func loadView() {
+            view = UIView()
+            view.backgroundColor = .clear
+            view.isUserInteractionEnabled = false
+        }
+
+        override func didMove(toParent parent: UIViewController?) {
+            super.didMove(toParent: parent)
+            hideNativeTabAccessibility()
+        }
+
+        override func viewDidAppear(_ animated: Bool) {
+            super.viewDidAppear(animated)
+            hideNativeTabAccessibility()
+        }
+
+        override func viewDidLayoutSubviews() {
+            super.viewDidLayoutSubviews()
+            hideNativeTabAccessibility()
+        }
+
+        func hideNativeTabAccessibility() {
+            guard let tabBarController else { return }
+            if #available(iOS 18.0, *), !tabBarController.isTabBarHidden {
+                tabBarController.setTabBarHidden(true, animated: false)
+            }
+            tabBarController.tabBar.accessibilityElementsHidden = true
+        }
     }
 }
