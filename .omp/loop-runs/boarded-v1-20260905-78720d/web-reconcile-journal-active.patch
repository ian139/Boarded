+'use client';
+
+import { useState, useEffect, useRef, useCallback } from 'react';
+import { createClient } from '@/lib/supabase/client';
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+import type { ClimbingSession, ClimbAttempt } from '@boarded/shared/types';
+import { cn } from '@/lib/utils';
+
+interface SessionDetailModalProps {
+  session: ClimbingSession | null;
+  isOpen: boolean;
+  onClose: () => void;
+  onPublish?: (session: ClimbingSession) => void;
+}
+
+export function SessionDetailModal({
+  session,
+  isOpen,
+  onClose,
+  onPublish,
+}: SessionDetailModalProps) {
+  const [attempts, setAttempts] = useState<ClimbAttempt[]>([]);
+  const [isLoading, setIsLoading] = useState(false);
+  const [isPublished, setIsPublished] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const requestGenRef = useRef(0);
+
+  const loadSessionDetail = useCallback(async () => {
+    if (!session || !isOpen) return;
+    const currentSessionId = session.id;
+    const currentGen = ++requestGenRef.current;
+
+    setIsLoading(true);
+    setError(null);
+    try {
+      const supabase = createClient();
+      // Fetch attempts
+      const { data: atts, error: attsError } = await supabase
+        .from('climb_attempts')
+        .select('*')
+        .eq('session_id', currentSessionId)
+        .order('attempt_number', { ascending: true });
+
+      if (currentGen !== requestGenRef.current || session.id !== currentSessionId) return;
+      if (attsError) throw attsError;
+
+      // Check if published
+      const { data: post, error: postError } = await supabase
+        .from('session_posts')
+        .select('id')
+        .eq('session_id', currentSessionId)
+        .maybeSingle();
+
+      if (currentGen !== requestGenRef.current || session.id !== currentSessionId) return;
+      if (postError) throw postError;
+
+      setAttempts((atts || []) as ClimbAttempt[]);
+      setIsPublished(Boolean(post));
+      setError(null);
+    } catch (err: unknown) {
+      if (currentGen === requestGenRef.current && session.id === currentSessionId) {
+        const msg = err instanceof Error ? err.message : 'Unable to load session details';
+        setError(msg);
+      }
+    } finally {
+      if (currentGen === requestGenRef.current && session.id === currentSessionId) {
+        setIsLoading(false);
+      }
+    }
+  }, [session?.id, isOpen]);
+
+  useEffect(() => {
+    if (!session || !isOpen) {
+      requestGenRef.current++;
+      setAttempts([]);
+      setError(null);
+      return;
+    }
+
+    loadSessionDetail();
+    return () => {
+      requestGenRef.current++;
+    };
+  }, [session?.id, isOpen, loadSessionDetail]);
+
+  if (!session) return null;
+
+  const durationMinutes =
+    session.started_at && session.ended_at
+      ? Math.max(1, Math.round((new Date(session.ended_at).getTime() - new Date(session.started_at).getTime()) / 60000))
+      : null;
+
+  const sendsCount = attempts.filter((a) => a.outcome === 'sent').length;
+
+  return (
+    <Dialog open={isOpen} onOpenChange={(open) => !open && onClose()}>
+      <DialogContent className="sm:max-w-lg bg-[#0D0F14] border-divider text-[#F4F2EB] p-6 max-h-[85vh] overflow-y-auto">
+        <DialogHeader className="mb-3">
+          <div className="flex items-center justify-between gap-2 flex-wrap">
+            <span className="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-[#171A22] border border-divider text-[#345CFF]">
+              Private Session Detail
+            </span>
+            {isPublished ? (
+              <span className="text-[10px] uppercase font-bold tracking-wider text-[#32D583]">
+                Published to Feed
+              </span>
+            ) : onPublish ? (
+              <button
+                type="button"
+                onClick={() => {
+                  onClose();
+                  onPublish(session);
+                }}
+                className="text-xs font-semibold text-[#345CFF] hover:underline"
+              >
+                + Publish to Feed
+              </button>
+            ) : null}
+          </div>
+          <DialogTitle className="font-display text-2xl font-semibold italic text-[#F4F2EB] mt-1">
+            {session.venue_name}
+          </DialogTitle>
+          <p className="text-xs text-[#A8ABB3]">
+            {new Date(session.started_at).toLocaleDateString(undefined, {
+              weekday: 'short',
+              month: 'short',
+              day: 'numeric',
+              year: 'numeric',
+            })}
+            {durationMinutes && ` · ${durationMinutes} min session`}
+          </p>
+        </DialogHeader>
+
+        {/* Private session context */}
+        {(session.conditions || session.notes) && (
+          <div className="p-3.5 rounded-xl border border-divider bg-[#171A22]/50 text-xs text-[#A8ABB3] space-y-1 mb-4">
+            {session.conditions && (
+              <p>
+                <strong className="text-[#F4F2EB]/90">Conditions:</strong> {session.conditions}
+              </p>
+            )}
+            {session.notes && (
+              <p>
+                <strong className="text-[#F4F2EB]/90">Notes:</strong> {session.notes}
+              </p>
+            )}
+          </div>
+        )}
+
+        {/* Stats strip */}
+        <div className="grid grid-cols-2 gap-3 mb-4">
+          <div className="p-3 rounded-xl border border-divider bg-[#171A22] text-center">
+            <span className="font-display text-2xl font-semibold italic text-[#32D583] tabular-nums">
+              {error ? '—' : sendsCount}
+            </span>
+            <p className="text-[11px] text-[#A8ABB3] mt-0.5">Total Sends</p>
+          </div>
+          <div className="p-3 rounded-xl border border-divider bg-[#171A22] text-center">
+            <span className="font-display text-2xl font-semibold italic text-[#F4F2EB] tabular-nums">
+              {error ? '—' : attempts.length}
+            </span>
+            <p className="text-[11px] text-[#A8ABB3] mt-0.5">Total Attempts</p>
+          </div>
+        </div>
+
+        {/* Recorded Attempts List */}
+        <div className="space-y-2">
+          <h4 className="text-xs font-semibold text-[#F4F2EB] uppercase tracking-wide mb-2">
+            Recorded Climbs ({attempts.length})
+          </h4>
+          {isLoading ? (
+            <div className="p-8 text-center text-xs text-[#A8ABB3] animate-pulse">
+              Loading attempt timeline...
+            </div>
+          ) : error ? (
+            <div className="p-6 text-center border border-red-500/20 bg-red-500/10 rounded-xl space-y-2">
+              <p className="text-xs text-red-400 font-medium">{error}</p>
+              <button
+                type="button"
+                onClick={loadSessionDetail}
+                className="text-xs font-semibold text-[#345CFF] hover:underline"
+              >
+                Retry
+              </button>
+            </div>
+          ) : attempts.length === 0 ? (
+            <div className="p-6 text-center border border-divider rounded-xl text-xs text-[#A8ABB3]">
+              No attempts recorded in this session.
+            </div>
+          ) : (
+            attempts.map((att) => (
+              <div
+                key={att.id}
+                className="flex items-start justify-between p-3 rounded-xl border border-divider bg-[#171A22]/30 gap-3"
+              >
+                <div className="flex items-start gap-3 min-w-0 flex-1">
+                  <span
+                    className={cn(
+                      'h-6 w-6 rounded-full flex items-center justify-center text-[11px] font-bold tabular-nums flex-shrink-0 mt-0.5',
+                      att.outcome === 'sent'
+                        ? 'bg-[#32D583]/20 text-[#32D583] border border-[#32D583]/40'
+                        : att.outcome === 'fell'
+                        ? 'bg-[#FF6B64]/20 text-[#FF6B64] border border-[#FF6B64]/40'
+                        : 'bg-white/10 text-[#A8ABB3]'
+                    )}
+                  >
+                    #{att.attempt_number}
+                  </span>
+                  <div className="min-w-0 flex-1">
+                    <p className="text-xs font-semibold text-[#F4F2EB]">
+                      {att.route_name}
+                    </p>
+                    <p className="text-[11px] text-[#A8ABB3]">
+                      {att.grade_label} · <span className="capitalize">{att.outcome}</span>
+                    </p>
+                    {att.notes && (
+                      <p className="text-[11px] text-[#A8ABB3]/90 mt-1.5 whitespace-pre-wrap break-words rounded-lg bg-[#171A22] border border-divider/60 p-2 italic">
+                        "{att.notes}"
+                      </p>
+                    )}
+                  </div>
+                </div>
+
+                <time className="text-[10px] text-[#A8ABB3] tabular-nums flex-shrink-0 mt-0.5">
+                  {new Date(att.occurred_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
+                </time>
+              </div>
+            ))
+          )}
+        </div>
+      </DialogContent>
+    </Dialog>
+  );
+}
