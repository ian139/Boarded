new file mode 100644
index 0000000000000000000000000000000000000000..76ec69e90f8102696886394384d3393fd64f0eda
--- /dev/null
+++ b/lib/utils/session-publication.ts
@@ -0,0 +1,260 @@
+import type { AttemptOutcome } from '@boarded/shared/types';
+import type { SupabaseClient } from '@supabase/supabase-js';
+
+export interface ImageAltOptions {
+  routeName: string;
+  gradeLabel: string;
+  outcome: AttemptOutcome;
+  climberName: string;
+  venueName: string;
+}
+
+const MAX_ALT_CODEPOINTS = 300;
+
+/**
+ * Derives honest image alternative text from the actual attempt outcome.
+ * Bounds the result to <= 300 Unicode code points (matching database constraint)
+ * while strictly preserving the outcome information.
+ */
+export function generateImageAlt(options: ImageAltOptions): string {
+  const { routeName, gradeLabel, outcome, climberName, venueName } = options;
+  const grade = gradeLabel || 'Unrated';
+  const climber = climberName || 'climber';
+  const venue = venueName || 'venue';
+
+  const full =
+    outcome === 'sent'
+      ? `${routeName} (${grade}) sent by ${climber} at ${venue}`
+      : outcome === 'fell'
+      ? `Attempt on ${routeName} (${grade}) by ${climber} at ${venue} (fell)`
+      : `Attempt on ${routeName} (${grade}) by ${climber} at ${venue} (stopped)`;
+
+  const fullChars = Array.from(full);
+  if (fullChars.length <= MAX_ALT_CODEPOINTS) {
+    return full;
+  }
+
+  // Bound while retaining outcome indicator
+  const outcomeMarker =
+    outcome === 'sent'
+      ? ` sent by ${climber} at ${venue}`
+      : ` at ${venue} (${outcome})`;
+
+  const prefix = outcome === 'sent' ? '' : 'Attempt on ';
+  const mid = `${routeName} (${grade})`;
+
+  const markerChars = Array.from(outcomeMarker);
+  const prefixChars = Array.from(prefix);
+  const budgetForMid = MAX_ALT_CODEPOINTS - prefixChars.length - markerChars.length - 1; // 1 for '…'
+
+  if (budgetForMid > 10) {
+    const truncatedMid = Array.from(mid).slice(0, budgetForMid).join('') + '…';
+    const candidate = `${prefix}${truncatedMid}${outcomeMarker}`;
+    if (Array.from(candidate).length <= MAX_ALT_CODEPOINTS) {
+      return candidate;
+    }
+  }
+
+  // Fallback: guaranteed <= 300 code points with outcome suffix intact
+  const fallbackSuffix = outcome === 'sent' ? ' (sent)' : ` (${outcome})`;
+  const suffixLen = Array.from(fallbackSuffix).length;
+  const truncatedBase = fullChars.slice(0, MAX_ALT_CODEPOINTS - suffixLen).join('');
+  return `${truncatedBase}${fallbackSuffix}`;
+}
+
+const INTENT_KEY_PREFIX = 'boarded:pub_record:';
+
+export interface DurablePublicationRecord {
+  userId: string;
+  sessionId: string;
+  postId: string;
+  storageKey: string;
+  sourceStorageKey: string;
+  createdAt: string;
+}
+
+/**
+ * Reads all durable publication records for the given user from localStorage.
+ * Iterates individual per-operation keys to prevent concurrent read-modify-write lost updates.
+ */
+export function getPublicationRecords(userId: string): DurablePublicationRecord[] {
+  if (typeof window === 'undefined' || !userId) return [];
+  try {
+    const prefix = `${INTENT_KEY_PREFIX}${userId}:`;
+    const records: DurablePublicationRecord[] = [];
+    for (let i = 0; i < localStorage.length; i++) {
+      const key = localStorage.key(i);
+      if (key && key.startsWith(prefix)) {
+        const raw = localStorage.getItem(key);
+        if (raw) {
+          try {
+            const parsed = JSON.parse(raw);
+            if (parsed && typeof parsed === 'object' && parsed.sessionId) {
+              records.push(parsed as DurablePublicationRecord);
+            }
+          } catch {
+            // Ignore corrupted individual record
+          }
+        }
+      }
+    }
+    return records;
+  } catch {
+    return [];
+  }
+}
+
+/**
+ * Retrieves the existing durable publication record for (userId, sessionId) if one exists.
+ * Uses dedicated per-operation storage key.
+ */
+export function getPublicationRecord(userId: string, sessionId: string): DurablePublicationRecord | null {
+  if (typeof window === 'undefined' || !userId || !sessionId) return null;
+  try {
+    const raw = localStorage.getItem(`${INTENT_KEY_PREFIX}${userId}:${sessionId}`);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw);
+    return parsed && typeof parsed === 'object' && parsed.sessionId ? (parsed as DurablePublicationRecord) : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Gets the existing durable publication record or creates a new one.
+ * Uses dedicated per-operation storage key to prevent lost updates across concurrent sessions.
+ * Fails closed visibly by throwing if localStorage persistence fails.
+ */
+export function getOrCreatePublicationRecord(userId: string, sessionId: string): DurablePublicationRecord {
+  if (typeof window === 'undefined' || !userId) {
+    throw new Error('Durable publication recovery requires an active browser session and user identity.');
+  }
+
+  const existing = getPublicationRecord(userId, sessionId);
+  if (existing) {
+    return existing;
+  }
+
+  const postId = crypto.randomUUID();
+  const newRecord: DurablePublicationRecord = {
+    userId,
+    sessionId,
+    postId,
+    storageKey: `${userId}/${postId}.jpg`,
+    sourceStorageKey: `${userId}/${postId}.source.jpg`,
+    createdAt: new Date().toISOString(),
+  };
+
+  try {
+    localStorage.setItem(`${INTENT_KEY_PREFIX}${userId}:${sessionId}`, JSON.stringify(newRecord));
+    return newRecord;
+  } catch (err: unknown) {
+    const message = err instanceof Error ? err.message : String(err);
+    throw new Error(`Failed to persist durable publication recovery: ${message}`);
+  }
+}
+
+/**
+ * Removes the durable publication record for (userId, sessionId).
+ * MUST only be called after confirmed successful post commit or successful deletion of artwork.
+ */
+export function clearPublicationRecord(userId: string, sessionId: string): void {
+  if (typeof window === 'undefined' || !userId || !sessionId) return;
+  try {
+    localStorage.removeItem(`${INTENT_KEY_PREFIX}${userId}:${sessionId}`);
+  } catch {
+    // Ignore storage write exceptions on cleanup
+  }
+}
+
+export type ReconcileStatus = 'committed' | 'uncommitted' | 'unknown';
+
+export interface ReconcileResult {
+  status: ReconcileStatus;
+  post: { id: string; session_id: string; image_path: string } | null;
+  matchesOperation?: boolean;
+  error?: string;
+}
+
+/**
+ * Checks whether a post insert actually committed on the server.
+ * Returns explicit 'unknown' on any query error or thrown exception, ensuring
+ * artwork is NEVER deleted or overwritten while status is uncertain.
+ * Checks exact artwork ownership to prevent clearing unrelated pending artwork.
+ */
+export async function reconcilePostCommit(
+  supabase: SupabaseClient,
+  postId: string,
+  sessionId: string,
+  storageKey?: string
+): Promise<ReconcileResult> {
+  try {
+    // 1. Check if post exists by operation postId
+    const { data: byId, error: byIdErr } = await supabase
+      .from('session_posts')
+      .select('id, session_id, image_path')
+      .eq('id', postId)
+      .maybeSingle();
+
+    if (byIdErr) {
+      return { status: 'unknown', post: null, error: byIdErr.message };
+    }
+
+    if (byId) {
+      return { status: 'committed', post: byId, matchesOperation: !storageKey || byId.image_path === storageKey };
+    }
+
+    // 2. Check if a post was already committed for this session
+    const { data: bySession, error: bySessionErr } = await supabase
+      .from('session_posts')
+      .select('id, session_id, image_path')
+      .eq('session_id', sessionId)
+      .maybeSingle();
+
+    if (bySessionErr) {
+      return { status: 'unknown', post: null, error: bySessionErr.message };
+    }
+
+    if (bySession) {
+      const matchesOperation = storageKey ? bySession.image_path === storageKey : bySession.id === postId;
+      return { status: 'committed', post: bySession, matchesOperation };
+    }
+
+    return { status: 'uncommitted', post: null, matchesOperation: false };
+  } catch (err: unknown) {
+    const message = err instanceof Error ? err.message : String(err);
+    return { status: 'unknown', post: null, error: message };
+  }
+}
+
+/**
+ * Mutual exclusion using browser Web Locks per user/session for publication/cleanup.
+ * Fails visibly if another tab or operation currently holds the lock, without unsafe concurrency fallback.
+ */
+export async function withPublicationLock<T>(
+  userId: string,
+  sessionId: string,
+  action: () => Promise<T>
+): Promise<T> {
+  const lockName = `boarded:pub_lock:${userId}:${sessionId}`;
+
+  if (typeof navigator !== 'undefined' && navigator.locks && typeof navigator.locks.request === 'function') {
+    return new Promise<T>((resolve, reject) => {
+      navigator.locks.request(lockName, { ifAvailable: true }, async (lock) => {
+        if (!lock) {
+          reject(new Error('A publication or cleanup operation is already in progress for this session in another window or tab.'));
+          return;
+        }
+        try {
+          const result = await action();
+          resolve(result);
+        } catch (err) {
+          reject(err);
+        }
+      });
+    });
+  }
+
+  // In environments without Web Locks (e.g. Node test runner): execute directly
+  return action();
+}
