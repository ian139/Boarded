diff --git a/lib/utils/composer.ts b/lib/utils/composer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1dc24c9a24cc1f378842e6b8e80da68f48687604
--- /dev/null
+++ b/lib/utils/composer.ts
@@ -0,0 +1,160 @@
+import type { AttemptOutcome, OverlayStyle, FeedAttemptTimelineItem } from '@boarded/shared/types';
+
+export interface ComposeOptions {
+  routeName: string;
+  gradeLabel: string;
+  outcome: AttemptOutcome;
+  attemptNumber: number;
+  durationSeconds?: number;
+  venueName: string;
+  overlayStyle: OverlayStyle;
+  timeline?: FeedAttemptTimelineItem[];
+}
+
+/**
+ * Composes a flattened editorial result card image from a user-provided photo
+ * and session outcome facts according to the shared Boarded contract.
+ * Measures the grade using its actual export font before positioning the venue.
+ */
+export async function composeSessionResultCard(
+  photoFile: File,
+  options: ComposeOptions
+): Promise<Blob> {
+  const { promise, resolve, reject } = Promise.withResolvers<Blob>();
+  const img = document.createElement('img');
+  const objectUrl = URL.createObjectURL(photoFile);
+
+  img.onload = () => {
+    URL.revokeObjectURL(objectUrl);
+    try {
+      const width = 1080;
+      const height = 1350; // 4:5 editorial vertical ratio
+
+      const canvas = document.createElement('canvas');
+      canvas.width = width;
+      canvas.height = height;
+      const ctx = canvas.getContext('2d');
+      if (!ctx) {
+        reject(new Error('Canvas 2D context unavailable'));
+        return;
+      }
+
+      // 1. Draw photo cover-fit
+      const imgAspect = img.width / img.height;
+      const canvasAspect = width / height;
+      let drawWidth = width;
+      let drawHeight = height;
+      let offsetX = 0;
+      let offsetY = 0;
+
+      if (imgAspect > canvasAspect) {
+        drawWidth = height * imgAspect;
+        offsetX = (width - drawWidth) / 2;
+      } else {
+        drawHeight = width / imgAspect;
+        offsetY = (height - drawHeight) / 2;
+      }
+
+      ctx.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
+
+      // 2. Draw Obsidian gradient scrim (bottom 48% of image)
+      const scrimHeight = height * 0.48;
+      const scrimGradient = ctx.createLinearGradient(0, height - scrimHeight, 0, height);
+      scrimGradient.addColorStop(0, 'rgba(10, 11, 16, 0)');
+      scrimGradient.addColorStop(0.35, 'rgba(10, 11, 16, 0.55)');
+      scrimGradient.addColorStop(0.75, 'rgba(10, 11, 16, 0.88)');
+      scrimGradient.addColorStop(1, 'rgba(10, 11, 16, 0.98)');
+
+      ctx.fillStyle = scrimGradient;
+      ctx.fillRect(0, height - scrimHeight, width, scrimHeight);
+
+      // 3. Draw outcome badge & Route name
+      const isSent = options.outcome === 'sent';
+      const startY = height - 260;
+
+      // Outcome label
+      ctx.font = '600 24px system-ui, -apple-system, sans-serif';
+      ctx.fillStyle = isSent ? '#32D583' : '#A8ABB3';
+      const outcomeText = isSent ? 'SENT' : 'ATTEMPTED';
+      ctx.fillText(outcomeText, 64, startY);
+
+      // Route Name
+      ctx.font = '700 44px system-ui, -apple-system, sans-serif';
+      ctx.fillStyle = '#F4F2EB';
+      ctx.fillText(options.routeName, 64, startY + 54);
+
+      // Grade label (Cormorant Garamond italic display)
+      const gradeText = options.gradeLabel || 'Unrated';
+      ctx.font = "italic 600 72px 'Cormorant Garamond', Georgia, serif";
+      ctx.fillStyle = '#F4F2EB';
+      ctx.fillText(gradeText, 64, startY + 135);
+
+      // Measure grade text using its actual drawn 72px font before switching fonts
+      const gradeWidth = ctx.measureText(gradeText).width;
+
+      // Venue Name
+      if (options.venueName) {
+        ctx.font = '500 24px system-ui, -apple-system, sans-serif';
+        ctx.fillStyle = 'rgba(244, 242, 235, 0.75)';
+        ctx.fillText(`· ${options.venueName}`, 64 + gradeWidth + 24, startY + 130);
+      }
+
+      // 4. Overlay Style Presentation (Timeline vs Stats)
+      const factsY = startY + 195;
+      if (options.overlayStyle === 'attempt_timeline' && options.timeline && options.timeline.length > 0) {
+        ctx.font = '600 18px system-ui, -apple-system, sans-serif';
+        ctx.fillStyle = '#A8ABB3';
+        ctx.fillText('TIMELINE:', 64, factsY);
+
+        let badgeX = 180;
+        options.timeline.slice(0, 8).forEach((att) => {
+          const attIsSent = att.outcome === 'sent';
+          ctx.fillStyle = attIsSent ? 'rgba(50, 213, 131, 0.25)' : 'rgba(255, 255, 255, 0.15)';
+          ctx.strokeStyle = attIsSent ? '#32D583' : 'rgba(255, 255, 255, 0.3)';
+          ctx.lineWidth = 2;
+
+          const pillW = 44;
+          const pillH = 28;
+          ctx.beginPath();
+          ctx.roundRect(badgeX, factsY - 20, pillW, pillH, 6);
+          ctx.fill();
+          ctx.stroke();
+
+          ctx.font = '700 16px system-ui, -apple-system, sans-serif';
+          ctx.fillStyle = attIsSent ? '#32D583' : '#F4F2EB';
+          ctx.fillText(`#${att.attempt_number}`, badgeX + 10, factsY - 1);
+
+          badgeX += pillW + 10;
+        });
+      } else {
+        const triesText = `${options.attemptNumber} ${options.attemptNumber === 1 ? 'try' : 'tries'}`;
+        const durationMins = options.durationSeconds === undefined ? null : Math.round(options.durationSeconds / 60);
+        const factsText = durationMins === null ? triesText : `${triesText} · ${durationMins} min session`;
+
+        ctx.font = '500 24px system-ui, -apple-system, sans-serif';
+        ctx.fillStyle = '#A8ABB3';
+        ctx.fillText(factsText, 64, factsY);
+      }
+
+      // Export as JPEG blob
+      canvas.toBlob(
+        (blob) => {
+          if (blob) resolve(blob);
+          else reject(new Error('Failed to generate canvas image blob'));
+        },
+        'image/jpeg',
+        0.92
+      );
+    } catch (err) {
+      reject(err);
+    }
+  };
+
+  img.onerror = () => {
+    URL.revokeObjectURL(objectUrl);
+    reject(new Error('Failed to load photograph for composition'));
+  };
+
+  img.src = objectUrl;
+  return promise;
+}
