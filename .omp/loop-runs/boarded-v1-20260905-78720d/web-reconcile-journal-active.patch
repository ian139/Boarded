+describe('Canonical authenticated journal recovery', () => {
+  const viewer = '11111111-1111-4111-8111-111111111111';
+  const routeId = '22222222-2222-4222-8222-222222222222';
+  type TableName = 'climbing_sessions' | 'climb_attempts' | 'session_posts' | 'route_bookmarks';
+  type Row = Record<string, unknown>;
+  let tables: Record<TableName, Row[]>;
+  let offline = false;
+  let storage: MockLocalStorage;
+  const runtime = globalThis as unknown as { window?: unknown };
+  let originalWindow: unknown;
+  let originalFetch: typeof fetch;
+  let originalUrl: string | undefined;
+  let originalKey: string | undefined;
+
+  // A stateful PostgREST boundary: canonical write constraints, bookmark grants,
+  // and featured-attempt cascades are enforced independently of the store.
+  const transport: typeof fetch = async (input, init) => {
+    if (offline) return Response.json({ code: 'PGRST000', message: 'Remote data unavailable' }, { status: 400 });
+    const request = new Request(input, init);
+    const url = new URL(request.url);
+    const table = url.pathname.split('/').at(-1);
+    if (table !== 'climbing_sessions' && table !== 'climb_attempts' && table !== 'session_posts' && table !== 'route_bookmarks') {
+      throw new Error(`Unexpected fixture endpoint: ${url.pathname}`);
+    }
+    const matches = (row: Row) => [...url.searchParams].every(([column, value]) => !value.startsWith('eq.') || row[column] === value.slice(3));
+    const failure = (code: string, message: string, status = 400) => Response.json({ code, message }, { status });
+    if (request.method === 'GET') return Response.json(tables[table].filter(matches));
+    if (request.method === 'DELETE') {
+      const deleted = tables[table].filter(matches);
+      tables[table] = tables[table].filter((row) => !matches(row));
+      if (table === 'climb_attempts') {
+        tables.session_posts = tables.session_posts.filter((post) => !deleted.some((attempt) => attempt.id === post.featured_attempt_id));
+      }
+      return new Response(null, { status: 204 });
+    }
+    if (request.method !== 'POST') throw new Error(`Unexpected fixture write: ${request.method}`);
+    const parsed: unknown = await request.json();
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('Expected one record');
+    const row: Row = Object.fromEntries(Object.entries(parsed));
+    const bounded = (value: unknown, maximum: number) => typeof value === 'string' && [...value.trim()].length > 0 && [...value.trim()].length <= maximum;
+    if (table === 'climbing_sessions' && !bounded(row.venue_name, 120)) return failure('23514', 'Invalid venue');
