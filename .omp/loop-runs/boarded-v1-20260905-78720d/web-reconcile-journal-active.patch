+import { describe, it, beforeEach, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import type { SupabaseClient } from '@supabase/supabase-js';
+import {
+  generateImageAlt,
+  getPublicationRecord,
+  getOrCreatePublicationRecord,
+  clearPublicationRecord,
+  getPublicationRecords,
+  reconcilePostCommit,
+} from './session-publication.ts';
+
+// Mock browser boundary for Node environment
+const originalWindow = globalThis.window;
+const originalLocalStorage = globalThis.localStorage;
+
+class MockLocalStorage {
+  private store = new Map<string, string>();
+
+  get length(): number {
+    return this.store.size;
+  }
+
+  key(index: number): string | null {
+    const keys = Array.from(this.store.keys());
+    return keys[index] || null;
+  }
+
+  getItem(key: string): string | null {
+    return this.store.get(key) || null;
+  }
+
+  setItem(key: string, value: string): void {
+    this.store.set(key, value);
+  }
+
+  removeItem(key: string): void {
+    this.store.delete(key);
+  }
+
+  clear(): void {
+    this.store.clear();
+  }
+}
+
+describe('session-publication', () => {
+  let mockStorage: MockLocalStorage;
+
+  beforeEach(() => {
+    mockStorage = new MockLocalStorage();
+    (globalThis as unknown as { window: unknown }).window = globalThis;
+    (globalThis as unknown as { localStorage: unknown }).localStorage = mockStorage;
+  });
+
+  afterEach(() => {
+    (globalThis as unknown as { window: unknown }).window = originalWindow;
+    (globalThis as unknown as { localStorage: unknown }).localStorage = originalLocalStorage;
+  });
+
+  describe('generateImageAlt', () => {
+    it('generates honest sent alternative text', () => {
+      const alt = generateImageAlt({
+        routeName: 'Redpoint Ridge',
+        gradeLabel: '5.12a',
+        outcome: 'sent',
+        climberName: 'Alex R.',
+        venueName: 'Stonegate',
+      });
+      assert.equal(alt, 'Redpoint Ridge (5.12a) sent by Alex R. at Stonegate');
+      assert.ok(Array.from(alt).length <= 300);
+    });
+
+    it('generates honest fell alternative text', () => {
+      const alt = generateImageAlt({
+        routeName: 'Steep Circuit',
+        gradeLabel: 'V6',
+        outcome: 'fell',
+        climberName: 'Alex R.',
+        venueName: 'Bishop',
+      });
+      assert.equal(alt, 'Attempt on Steep Circuit (V6) by Alex R. at Bishop (fell)');
+      assert.ok(Array.from(alt).length <= 300);
+    });
+
+    it('generates honest stopped alternative text', () => {
+      const alt = generateImageAlt({
+        routeName: 'Golden Hour',
+        gradeLabel: '5.11c',
+        outcome: 'stopped',
+        climberName: 'Alex R.',
+        venueName: 'Stonegate',
+      });
+      assert.equal(alt, 'Attempt on Golden Hour (5.11c) by Alex R. at Stonegate (stopped)');
+      assert.ok(Array.from(alt).length <= 300);
+    });
+
+    it('bounds overly long strings to <= 300 Unicode code points while retaining outcome indicator', () => {
+      const longRoute = 'Supercalifragilisticexpialidocious Ultra Extreme Climbing Route '.repeat(6);
+      const longVenue = 'The Most Incredible Fantastic Crag In The World Area '.repeat(4);
+      const alt = generateImageAlt({
+        routeName: longRoute,
+        gradeLabel: '5.14d',
+        outcome: 'fell',
+        climberName: 'Alexander Supertramp Climber of the High Sierra Range',
+        venueName: longVenue,
+      });
+
+      const codepoints = Array.from(alt);
+      assert.ok(codepoints.length <= 300, `Expected <= 300 codepoints, got ${codepoints.length}`);
+      assert.ok(alt.includes('(fell)'), 'Must retain fell outcome indicator');
+    });
+  });
+
+  describe('durable publication storage', () => {
+    it('returns null when no record exists', () => {
+      const record = getPublicationRecord('user-1', 'session-1');
+      assert.equal(record, null);
+    });
+
+    it('creates and retrieves a durable publication record', () => {
+      const created = getOrCreatePublicationRecord('user-1', 'session-1');
+      assert.equal(created.userId, 'user-1');
+      assert.equal(created.sessionId, 'session-1');
+      assert.ok(created.postId);
+      assert.equal(created.storageKey, `user-1/${created.postId}.jpg`);
+      assert.equal(created.sourceStorageKey, `user-1/${created.postId}.source.jpg`);
+
+      const retrieved = getPublicationRecord('user-1', 'session-1');
+      assert.deepEqual(retrieved, created);
+    });
+
+    it('isolates concurrent sessions using per-operation keys to prevent lost updates', () => {
+      const rec1 = getOrCreatePublicationRecord('user-1', 'session-1');
+      const rec2 = getOrCreatePublicationRecord('user-1', 'session-2');
+
+      assert.notEqual(rec1.sessionId, rec2.sessionId);
+      assert.notEqual(rec1.postId, rec2.postId);
+
+      // Both must exist independently
+      const read1 = getPublicationRecord('user-1', 'session-1');
+      const read2 = getPublicationRecord('user-1', 'session-2');
+      assert.deepEqual(read1, rec1);
+      assert.deepEqual(read2, rec2);
+
+      // Clearing session 1 must not clear session 2
+      clearPublicationRecord('user-1', 'session-1');
+      assert.equal(getPublicationRecord('user-1', 'session-1'), null);
+      assert.deepEqual(getPublicationRecord('user-1', 'session-2'), rec2);
+
+      // Listing user-1 records must return remaining session 2
+      const all = getPublicationRecords('user-1');
+      assert.equal(all.length, 1);
+      assert.equal(all[0].sessionId, 'session-2');
+    });
+  });
+
+  describe('reconcilePostCommit', () => {
+    it('detects committed status when post exists by postId', async () => {
+      const mockSupabase = {
+        from: (table: string) => ({
+          select: () => ({
+            eq: (_field: string, value: string) => ({
+              maybeSingle: async () => {
+                if (table === 'session_posts' && value === 'post-uuid-1') {
+                  return {
+                    data: { id: 'post-uuid-1', session_id: 'session-1', image_path: 'user-1/post-uuid-1.jpg' },
+                    error: null,
+                  };
+                }
+                return { data: null, error: null };
+              },
+            }),
+          }),
+        }),
+      } as unknown as SupabaseClient;
+
+      const res = await reconcilePostCommit(mockSupabase, 'post-uuid-1', 'session-1', 'user-1/post-uuid-1.jpg');
+      assert.equal(res.status, 'committed');
+      assert.equal(res.matchesOperation, true);
+      assert.equal(res.post?.id, 'post-uuid-1');
+    });
+
+    it('detects committed status by sessionId with exact artwork ownership check', async () => {
+      const mockSupabase = {
+        from: (table: string) => ({
+          select: () => ({
+            eq: (_field: string, value: string) => ({
+              maybeSingle: async () => {
+                if (table === 'session_posts' && value === 'session-1') {
+                  return {
+                    data: { id: 'post-uuid-prev', session_id: 'session-1', image_path: 'user-1/post-uuid-prev.jpg' },
+                    error: null,
+                  };
+                }
+                return { data: null, error: null };
+              },
+            }),
+          }),
+        }),
+      } as unknown as SupabaseClient;
+
+      // When checking a different post ID on the same session, matchesOperation must be false
+      const res = await reconcilePostCommit(mockSupabase, 'post-uuid-new', 'session-1', 'user-1/post-uuid-new.jpg');
+      assert.equal(res.status, 'committed');
+      assert.equal(res.matchesOperation, false);
+      assert.equal(res.post?.id, 'post-uuid-prev');
+    });
+
+    it('returns unknown status when query fails or errors, protecting artwork', async () => {
+      const mockSupabase = {
+        from: () => ({
+          select: () => ({
+            eq: () => ({
+              maybeSingle: async () => ({
+                data: null,
+                error: { message: 'Database connection failed' },
+              }),
+            }),
+          }),
+        }),
+      } as unknown as SupabaseClient;
+
+      const res = await reconcilePostCommit(mockSupabase, 'post-uuid-err', 'session-err');
+      assert.equal(res.status, 'unknown');
+      assert.equal(res.post, null);
+      assert.match(res.error || '', /Database connection failed/);
+    });
+
+    it('returns unknown status when query throws an exception', async () => {
+      const mockSupabase = {
+        from: () => ({
+          select: () => ({
+            eq: () => ({
+              maybeSingle: async () => {
+                throw new Error('Socket timeout');
+              },
+            }),
+          }),
+        }),
+      } as unknown as SupabaseClient;
+
+      const res = await reconcilePostCommit(mockSupabase, 'post-uuid-throw', 'session-throw');
+      assert.equal(res.status, 'unknown');
+      assert.equal(res.post, null);
+      assert.match(res.error || '', /Socket timeout/);
+    });
+
+    it('detects uncommitted state only when queries succeed and confirm no post exists', async () => {
+      const mockSupabase = {
+        from: () => ({
+          select: () => ({
+            eq: () => ({
+              maybeSingle: async () => ({ data: null, error: null }),
+            }),
+          }),
+        }),
+      } as unknown as SupabaseClient;
+
+      const res = await reconcilePostCommit(mockSupabase, 'post-unknown', 'session-empty');
+      assert.equal(res.status, 'uncommitted');
+      assert.equal(res.post, null);
+    });
+  });
+});
