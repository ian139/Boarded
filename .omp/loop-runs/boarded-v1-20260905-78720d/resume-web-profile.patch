+const GRADES_BY_SYSTEM: Record<GradeSystem, readonly string[]> = {
+  v_scale: V_SCALE_GRADES,
+  font: FONT_GRADES,
+  yds: YDS_GRADES,
+  custom: [],
+};
+
+function formatGradeWithSystem(label: string, system: GradeSystem): string {
+  switch (system) {
+    case 'v_scale':
+      return label;
+    case 'font':
+      return `Font ${label}`;
+    case 'yds':
+      return `YDS ${label}`;
+    case 'custom':
+      return `Custom: ${label}`;
+  }
+}
+
+function getCanonicalGrade(label: string | null | undefined, system: GradeSystem): string | null {
+  if (typeof label !== 'string') return null;
+  const trimmed = label.trim();
+  if (!trimmed) return null;
+  if (system === 'custom') return trimmed;
+
+  const catalog = GRADES_BY_SYSTEM[system];
+  const found = catalog.find((g) => g.toLowerCase() === trimmed.toLowerCase());
+  return found ?? null;
+}
+
+function getGradeRank(label: string | null | undefined, system: GradeSystem): number {
+  const canonical = getCanonicalGrade(label, system);
+  if (!canonical) return -1;
+  const catalog = GRADES_BY_SYSTEM[system];
+  const index = catalog.indexOf(canonical);
+  return index >= 0 ? index : -1;
+}
 
