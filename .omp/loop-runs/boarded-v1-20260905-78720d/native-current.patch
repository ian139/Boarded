+            await load()
+        }
+    }
+
+    private func climberHeader(_ climber: CommunityClimber) -> some View {
+        VStack(alignment: .leading, spacing: AppSpacing.space16) {
+            HStack(spacing: AppSpacing.space16) {
+                BoardedAvatar(name: climber.displayName, size: 56)
+                VStack(alignment: .leading, spacing: AppSpacing.space4) {
+                    Text(climber.displayName)
+                        .font(AppTypography.titleL)
+                        .foregroundStyle(AppColor.textPrimary)
+                    if let username = climber.username {
+                        Text("@\(username)")
+                            .font(AppTypography.bodyM)
+                            .foregroundStyle(AppColor.textSecondary)
+                    }
+                    if let home = climber.homeArea {
+                        Label(home, systemImage: "mappin")
+                            .font(AppTypography.caption)
+                            .foregroundStyle(AppColor.textSecondary)
+                    }
+                }
+            }
+
+            if let bio = climber.bio, !bio.isEmpty {
+                Text(bio)
+                    .font(AppTypography.bodyM)
+                    .foregroundStyle(AppColor.textPrimary)
+            }
+
+            HStack(spacing: AppSpacing.space24) {
+                statCounter(count: climber.followerCount, label: "Followers")
+                statCounter(count: climber.followingCount, label: "Following")
+                Spacer()
+                Button(action: { Task { await toggleFollow() } }) {
+                    Text(isFollowing ? "Following" : "Follow")
+                        .font(AppTypography.labelM)
+                        .foregroundStyle(isFollowing ? AppColor.textSecondary : AppColor.accentOnAccent)
+                        .padding(.horizontal, AppSpacing.space16)
+                        .padding(.vertical, AppSpacing.space8)
+                        .background(isFollowing ? AppColor.backgroundElevated : AppColor.accentDefault)
+                        .clipShape(AppRadius.control)
+                        .frame(minHeight: 44)
+                }
+                .buttonStyle(.plain)
+                .disabled(isTogglingFollow)
+            }
+        }
+        .padding(AppLayout.featureCardPadding)
+        .boardedSurface(in: AppRadius.card())
+    }
+
+    private func statCounter(count: Int, label: String) -> some View {
+        VStack(alignment: .leading, spacing: AppSpacing.space2) {
+            Text("\(count)")
+                .font(AppTypography.titleM)
+                .foregroundStyle(AppColor.textPrimary)
+            Text(label)
+                .font(AppTypography.caption)
+                .foregroundStyle(AppColor.textTertiary)
+        }
+    }
+
+    private func load() async {
+        isLoading = true
+        errorMessage = nil
+        defer { isLoading = false }
+        do {
+            async let fetchedClimber = repository.fetchClimber(userID: climberID)
+            async let fetchedSessions = repository.fetchClimberSessions(userID: climberID)
+            let (c, s) = try await (fetchedClimber, fetchedSessions)
+            climber = c
+            sessions = s
+            isFollowing = c?.isFollowed ?? false
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    private func toggleFollow() async {
+        guard auth.isAuthenticated else {
+            auth.requestAuthentication()
+            return
+        }
+        guard !isTogglingFollow else { return }
+        isTogglingFollow = true
+        defer { isTogglingFollow = false }
+        do {
+            let next = try await repository.toggleFollow(climberID: climberID)
+            isFollowing = next
+            if var c = climber {
+                c.isFollowed = next
+                c.followerCount += next ? 1 : -1
+                climber = c
+            }
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+}
