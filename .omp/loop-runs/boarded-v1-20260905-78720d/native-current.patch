+// MARK: - Route Creation Form
+
+struct RouteFormView: View {
+    @Environment(\.dismiss) private var dismiss
+    let venues: [CommunityVenue]
+    let onSave: (CommunityRoute) -> Void
+
+    @State private var name = ""
+    @State private var discipline: ClimbDiscipline = .sport
+    @State private var gradeSystem: GradeSystem = .yds
+    @State private var gradeLabel = ""
+    @State private var heightText = ""
+    @State private var rockType = ""
+    @State private var terrain: RouteTerrain? = nil
+    @State private var selectedVenueID: UUID?
+    @State private var isSaving = false
+    @State private var errorMessage: String?
+
+    private let repository = AppServices.communityRepository
+
+    var body: some View {
+        Form {
+            Section(header: Text("Route Details")) {
+                TextField("Route Name", text: $name)
+                Picker("Discipline", selection: $discipline) {
+                    ForEach(ClimbDiscipline.allCases, id: \.self) { d in
+                        Text(d.title).tag(d)
+                    }
+                }
+                Picker("Grade System", selection: $gradeSystem) {
+                    ForEach(GradeSystem.allCases, id: \.self) { s in
+                        Text(s.title).tag(s)
+                    }
+                }
+                TextField("Grade (e.g. 5.12a or V6)", text: $gradeLabel)
+            }
+
+            Section(header: Text("Venue")) {
+                Picker("Venue / Crag", selection: $selectedVenueID) {
+                    Text("None / Outdoor").tag(nil as UUID?)
+                    ForEach(venues) { venue in
+                        Text(venue.name).tag(venue.id as UUID?)
+                    }
+                }
+            }
+
+            Section(header: Text("Physical Attributes")) {
+                TextField("Height in meters (optional)", text: $heightText)
+                    .keyboardType(.decimalPad)
+                TextField("Rock Type (e.g. Limestone, Granite)", text: $rockType)
+                Picker("Terrain", selection: $terrain) {
+                    Text("Unspecified").tag(nil as RouteTerrain?)
+                    ForEach(RouteTerrain.allCases, id: \.self) { t in
+                        Text(t.rawValue.capitalized).tag(t as RouteTerrain?)
+                    }
+                }
+            }
+            if let error = errorMessage {
+                Section {
+                    Text(error).foregroundStyle(AppColor.danger)
+                }
+            }
+        }
+        .navigationTitle("Create Route")
+        .navigationBarTitleDisplayMode(.inline)
+        .toolbar {
+            ToolbarItem(placement: .cancellationAction) {
+                Button("Cancel") { dismiss() }
+            }
+            ToolbarItem(placement: .confirmationAction) {
+                Button("Save") {
+                    Task { await saveRoute() }
+                }
+                .disabled(name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || isSaving)
+            }
+        }
+    }
+
+    private func saveRoute() async {
+        isSaving = true
+        errorMessage = nil
+        let heightM = Double(heightText.trimmingCharacters(in: .whitespacesAndNewlines))
+        do {
+            let created = try await repository.createRoute(
+                venueID: selectedVenueID,
+                name: name.trimmingCharacters(in: .whitespacesAndNewlines),
+                discipline: discipline,
+                gradeSystem: gradeSystem,
+                gradeLabel: gradeLabel.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : gradeLabel.trimmingCharacters(in: .whitespacesAndNewlines),
+                heightM: heightM,
+                rockType: rockType.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : rockType.trimmingCharacters(in: .whitespacesAndNewlines),
+                terrain: terrain
+            )
+            onSave(created)
+            dismiss()
+        } catch {
+            errorMessage = error.localizedDescription
+            isSaving = false
+        }
+    }
+}
+
+// MARK: - Venue Creation Form
+
+struct VenueFormView: View {
+    @Environment(\.dismiss) private var dismiss
+    let onSave: (CommunityVenue) -> Void
+
+    @State private var name = ""
+    @State private var kind: VenueKind = .crag
+    @State private var area = ""
+    @State private var description = ""
+    @State private var isSaving = false
+    @State private var errorMessage: String?
+
+    private let repository = AppServices.communityRepository
+
+    var body: some View {
+        Form {
+            Section(header: Text("Venue Information")) {
+                TextField("Venue Name", text: $name)
+                Picker("Kind", selection: $kind) {
+                    ForEach(VenueKind.allCases, id: \.self) { k in
+                        Text(k.rawValue.capitalized).tag(k)
+                    }
+                }
+                TextField("Area / Location", text: $area)
+                TextField("Description (optional)", text: $description)
+            }
+
+            if let error = errorMessage {
+                Section {
+                    Text(error).foregroundStyle(AppColor.danger)
+                }
+            }
+        }
+        .navigationTitle("Add Venue")
+        .navigationBarTitleDisplayMode(.inline)
+        .toolbar {
+            ToolbarItem(placement: .cancellationAction) {
+                Button("Cancel") { dismiss() }
+            }
+            ToolbarItem(placement: .confirmationAction) {
+                Button("Save") {
+                    Task { await saveVenue() }
+                }
+                .disabled(name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || isSaving)
+            }
+        }
+    }
+
+    private func saveVenue() async {
+        isSaving = true
+        errorMessage = nil
+        do {
+            let created = try await repository.createVenue(
+                name: name.trimmingCharacters(in: .whitespacesAndNewlines),
+                kind: kind,
+                area: area.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : area.trimmingCharacters(in: .whitespacesAndNewlines),
+                description: description.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? nil : description.trimmingCharacters(in: .whitespacesAndNewlines)
+            )
+            onSave(created)
+            dismiss()
+        } catch {
+            errorMessage = error.localizedDescription
+            isSaving = false
+        }
+    }
+}
