+import SwiftUI
+
+struct ActivityView: View {
+    @EnvironmentObject private var navigation: AppNavigation
+    @StateObject private var model = ActivityViewModel()
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: AppSpacing.space16) {
+                if model.isLoading {
+                    BoardedFeedCardSkeleton()
+                } else if let error = model.errorMessage {
+                    BoardedInlineError(message: error) {
+                        Task { await model.load() }
+                    }
+                } else if model.events.isEmpty {
+                    BoardedEmptyState(
+                        title: "Quiet on the line",
+                        message: "When other climbers send kudos, comment on your sends, or follow your journey, you'll see them here.",
+                        actionTitle: "Explore Community",
+                        action: {
+                            navigation.selectedTab = .explore
+                        }
+                    )
+                } else {
+                    if model.unreadCount > 0 {
+                        HStack {
+                            Circle()
+                                .fill(AppColor.accentDefault)
+                                .frame(width: 8, height: 8)
+                            Text("\(model.unreadCount) unread notifications")
+                                .font(AppTypography.labelM)
+                                .foregroundStyle(AppColor.textSecondary)
+                            Spacer()
+                            Button("Mark all as read") {
+                                Task { await model.markAllRead() }
+                            }
+                            .font(AppTypography.caption.weight(.medium))
+                            .foregroundStyle(AppColor.accentDefault)
+                        }
+                        .padding(.horizontal, AppSpacing.space12)
+                        .padding(.vertical, AppSpacing.space8)
+                        .boardedSurface(in: AppRadius.control)
+                    }
+
+                    LazyVStack(spacing: 0) {
+                        ForEach(model.events) { event in
+                            ActivityRow(event: event) {
+                                Task {
+                                    await model.markRead(eventID: event.id)
+                                    navigation.unreadActivityCount = model.unreadCount
+                                }
+                                handleNavigation(for: event)
+                            }
+                        }
+                        if model.canLoadMore, let last = model.events.last {
+                            Color.clear
+                                .frame(height: 1)
+                                .onAppear {
+                                    if model.events.last?.id == last.id {
+                                        Task { await model.loadMore() }
+                                    }
+                                }
+                        }
+                    }
+                    .clipShape(AppRadius.card())
+                }
+            }
+            .boardedContentWidth()
+            .frame(maxWidth: .infinity)
+        }
+        .navigationTitle("Activity")
+        .boardedPageBackground()
+        .toolbar {
+            if model.unreadCount > 0 {
+                ToolbarItem(placement: .primaryAction) {
+                    Button("Read All") {
+                        Task { await model.markAllRead() }
+                    }
+                    .font(AppTypography.labelM)
+                    .foregroundStyle(AppColor.textSecondary)
+                }
+            }
+        }
+        .task {
+            await model.load()
+            navigation.unreadActivityCount = model.unreadCount
+        }
+        .onChange(of: model.unreadCount) { _, count in
+            navigation.unreadActivityCount = count
+        }
+    }
+
+    private func handleNavigation(for event: ActivityEvent) {
+        switch event.kind {
+        case .follow:
+            navigation.activeClimberProfile = event.actor.id
+        case .like, .comment, .crewSend:
+            if let postId = event.postId {
+                navigation.activePostDetail = postId
+            }
+        }
+    }
+}
+
+// MARK: - Activity Row
+
+struct ActivityRow: View {
+    let event: ActivityEvent
+    let onTap: () -> Void
+
+    var body: some View {
+        Button(action: onTap) {
+            HStack(spacing: AppSpacing.space12) {
+                // Unread dot indicator
+                Circle()
+                    .fill(event.isRead ? Color.clear : AppColor.accentDefault)
+                    .frame(width: 8, height: 8)
+
+                BoardedAvatar(name: event.actor.displayName, size: 40)
+
+                VStack(alignment: .leading, spacing: AppSpacing.space2) {
+                    Group {
+                        Text(event.actor.displayName)
+                            .fontWeight(.semibold)
+                            .foregroundStyle(AppColor.textPrimary)
+                        +
+                        Text(" \(eventDescription)")
+                            .foregroundStyle(AppColor.textSecondary)
+                    }
+                    .font(AppTypography.bodyM)
+                    .lineLimit(2)
+
+                    Text(BoardedFormat.relative(event.createdAt))
+                        .font(AppTypography.caption)
+                        .foregroundStyle(AppColor.textTertiary)
+                }
+
+                Spacer()
+
+                Image(systemName: iconName)
+                    .font(AppTypography.labelM)
+                    .foregroundStyle(iconColor)
+                    .frame(width: 28, height: 28)
+            }
+            .padding(AppLayout.cardPadding)
+            .frame(minHeight: AppLayout.listRowMinHeight)
+            .background(event.isRead ? AppColor.surfaceCard : AppColor.backgroundElevated)
+            .overlay(alignment: .bottom) {
+                Divider().background(AppColor.divider)
+            }
+        }
+        .buttonStyle(.plain)
+    }
+
+    private var eventDescription: String {
+        switch event.kind {
+        case .like:
+            return "sent kudos on your session"
+        case .comment:
+            return "commented on your session"
+        case .follow:
+            return "started following you"
+        case .crewSend:
+            return "sent a route with your crew"
+        }
+    }
+
+    private var iconName: String {
+        switch event.kind {
+        case .like:
+            return "heart.fill"
+        case .comment:
+            return "bubble.left.fill"
+        case .follow:
+            return "person.badge.plus"
+        case .crewSend:
+            return "checkmark.circle.fill"
+        }
+    }
+
+    private var iconColor: Color {
+        switch event.kind {
+        case .like:
+            return AppColor.textSecondary
+        case .comment:
+            return AppColor.accentDefault
+        case .follow:
+            return AppColor.accentDefault
+        case .crewSend:
+            return AppColor.success
+        }
+    }
+}
