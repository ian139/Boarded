+++ b/apps/ios/Boarded/ViewModels/ExploreViewModel.swift
@@ -0,0 +1,160 @@
+import Foundation
+import Combine
+
+enum ExploreCategory: String, CaseIterable, Identifiable {
+    case all = "All"
+    case routes = "Routes"
+    case venues = "Venues"
+    case climbers = "Climbers"
+    case saved = "Saved"
+
+    var id: String { rawValue }
+}
+
+@MainActor
+final class ExploreViewModel: ObservableObject {
+    @Published var query: String = ""
+    @Published var selectedCategory: ExploreCategory = .all
+    @Published private(set) var routes: [CommunityRoute] = []
+    @Published private(set) var venues: [CommunityVenue] = []
+    @Published private(set) var climbers: [CommunityClimber] = []
+    @Published private(set) var isLoading = false
+    @Published private(set) var isLoadingMore = false
+    @Published private(set) var canLoadMore = true
+    @Published private(set) var errorMessage: String?
+    private let pageSize = 40
+    private let repository: any CommunityRepository
+    private var generation = 0
+
+    init(repository: any CommunityRepository = AppServices.communityRepository) {
+        self.repository = repository
+    }
+
+    func load() async {
+        generation += 1
+        let req = generation
+        isLoading = true
+        errorMessage = nil
+        canLoadMore = true
+        defer {
+            if req == generation { isLoading = false }
+        }
+        do {
+            async let fetchedRoutes = repository.fetchExploreRoutes(
+                searchText: query,
+                venueFilter: nil,
+                savedOnly: selectedCategory == .saved,
+                beforeCreatedAt: nil,
+                beforeID: nil,
+                pageSize: pageSize
+            )
+            async let fetchedVenues = repository.fetchVenues(query: query.isEmpty ? nil : query)
+            async let fetchedClimbers = repository.searchClimbers(query: query, pageSize: 30)
+
+            let (r, v, c) = try await (fetchedRoutes, fetchedVenues, fetchedClimbers)
+            guard req == generation else { return }
+            routes = r
+            venues = v
+            climbers = c
+            canLoadMore = r.count >= pageSize
+        } catch is CancellationError {
+            return
+        } catch {
+            guard req == generation else { return }
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func loadMore() async {
+        guard canLoadMore, !isLoadingMore, let last = routes.last else { return }
+        isLoadingMore = true
+        defer { isLoadingMore = false }
+        do {
+            let older = try await repository.fetchExploreRoutes(
+                searchText: query,
+                venueFilter: nil,
+                savedOnly: selectedCategory == .saved,
+                beforeCreatedAt: last.createdAt,
+                beforeID: last.id,
+                pageSize: pageSize
+            )
+            let existing = Set(routes.map(\.id))
+            let additions = older.filter { !existing.contains($0.id) }
+            routes.append(contentsOf: additions)
+            canLoadMore = older.count >= pageSize
+        } catch is CancellationError {
+            return
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func toggleBookmark(routeID: UUID) async {
+        do {
+            let isSaved = try await repository.toggleBookmark(routeID: routeID)
+            if AppLaunchConfiguration.isUITestFixture {
+                _ = SharedFixtureStore.shared.toggleBookmark(routeID)
+            }
+            if let idx = routes.firstIndex(where: { $0.id == routeID }) {
+                routes[idx].isSaved = isSaved
+            }
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func toggleFollow(climberID: UUID) async {
+        do {
+            let isFollowed = try await repository.toggleFollow(climberID: climberID)
+            if AppLaunchConfiguration.isUITestFixture {
+                _ = SharedFixtureStore.shared.toggleFollow(climberID)
+            }
+            if let idx = climbers.firstIndex(where: { $0.id == climberID }) {
+                climbers[idx].isFollowed = isFollowed
+                climbers[idx].followerCount += isFollowed ? 1 : -1
+            }
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func createVenue(
+        name: String,
+        kind: VenueKind,
+        area: String?,
+        description: String?
+    ) async throws -> CommunityVenue {
+        let venue = try await repository.createVenue(
+            name: name,
+            kind: kind,
+            area: area,
+            description: description
+        )
+        venues.insert(venue, at: 0)
+        return venue
+    }
+
+    func createRoute(
+        venueID: UUID?,
+        name: String,
+        discipline: ClimbDiscipline,
+        gradeSystem: GradeSystem,
+        gradeLabel: String?,
+        heightM: Double?,
+        rockType: String?,
+        terrain: RouteTerrain?
+    ) async throws -> CommunityRoute {
+        let route = try await repository.createRoute(
+            venueID: venueID,
+            name: name,
+            discipline: discipline,
+            gradeSystem: gradeSystem,
+            gradeLabel: gradeLabel,
+            heightM: heightM,
+            rockType: rockType,
+            terrain: terrain
+        )
+        routes.insert(route, at: 0)
+        return route
+    }
+}
