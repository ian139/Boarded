+struct SupabaseCommunityRepository: CommunityRepository, Sendable {
+    private let client: SupabaseClient?
+
+    init(client: SupabaseClient? = SupabaseClientProvider.client) {
+        self.client = client
+    }
+
+    func fetchExploreRoutes(
+        searchText: String,
+        venueFilter: UUID?,
+        savedOnly: Bool,
+        beforeCreatedAt: Date?,
+        beforeID: UUID?,
+        pageSize: Int
+    ) async throws -> [CommunityRoute] {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let params = CommunityExploreParams(
+            search_text: searchText,
+            venue_filter: venueFilter,
+            saved_only: savedOnly,
+            before_created_at: beforeCreatedAt,
+            before_id: beforeID,
+            page_size: min(max(pageSize, 1), 50)
+        )
+        let routes: [CommunityRoute] = try await client.rpc("get_explore_routes", params: params)
+            .execute()
+            .value
+        return routes
+    }
+
+    func fetchVenues(query: String?) async throws -> [CommunityVenue] {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        var request = client.from("venues").select("*")
+        if let query = query?.trimmingCharacters(in: .whitespacesAndNewlines), !query.isEmpty {
+            request = request.ilike("name", value: "%\(query)%")
+        }
+        let venues: [CommunityVenue] = try await request
+            .order("name", ascending: true)
+            .limit(50)
+            .execute()
+            .value
+        return venues
+    }
+
+    func searchClimbers(query: String, pageSize: Int) async throws -> [CommunityClimber] {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let params = CommunitySearchClimbersParams(
+            search_text: query,
+            page_size: min(max(pageSize, 1), 50)
+        )
+        let climbers: [CommunityClimber] = try await client.rpc("search_climbers", params: params)
+            .execute()
+            .value
+        return climbers
+    }
+
+    func toggleBookmark(routeID: UUID) async throws -> Bool {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        let existing: [RouteBookmark] = try await client.from("route_bookmarks")
+            .select("*")
+            .eq("route_id", value: routeID.uuidString)
+            .eq("user_id", value: userID.uuidString)
+            .limit(1)
+            .execute()
+            .value
+        if existing.isEmpty {
+            _ = try await client.from("route_bookmarks")
+                .insert(["user_id": userID.uuidString, "route_id": routeID.uuidString])
+                .execute()
+            return true
+        } else {
+            _ = try await client.from("route_bookmarks")
+                .delete()
+                .eq("route_id", value: routeID.uuidString)
+                .eq("user_id", value: userID.uuidString)
+                .execute()
+            return false
+        }
+    }
+
+    func toggleFollow(climberID: UUID) async throws -> Bool {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        let existing: [Follow] = try await client.from("follows")
+            .select("*")
+            .eq("follower_id", value: userID.uuidString)
+            .eq("following_id", value: climberID.uuidString)
+            .limit(1)
+            .execute()
+            .value
+        if existing.isEmpty {
+            _ = try await client.from("follows")
+                .insert(["follower_id": userID.uuidString, "following_id": climberID.uuidString])
+                .execute()
+            return true
+        } else {
+            _ = try await client.from("follows")
+                .delete()
+                .eq("follower_id", value: userID.uuidString)
+                .eq("following_id", value: climberID.uuidString)
+                .execute()
+            return false
+        }
+    }
+
+    func createVenue(
+        name: String,
+        kind: VenueKind,
+        area: String?,
+        description: String?
+    ) async throws -> CommunityVenue {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        let payload = CommunityInsertVenuePayload(
+            name: name,
+            kind: kind.rawValue,
+            area: area,
+            description: description,
+            user_id: userID,
+            is_public: true
+        )
+        let rows: [CommunityVenue] = try await client.from("venues")
+            .insert(payload)
+            .select("*")
+            .execute()
+            .value
+        guard let row = rows.first else { throw CommunityRepositoryError.notFound }
+        return row
+    }
+
+    func createRoute(
+        venueID: UUID?,
+        name: String,
+        discipline: ClimbDiscipline,
+        gradeSystem: GradeSystem,
+        gradeLabel: String?,
+        heightM: Double?,
+        rockType: String?,
+        terrain: RouteTerrain?
+    ) async throws -> CommunityRoute {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        let payload = CommunityInsertRoutePayload(
+            venue_id: venueID,
+            name: name,
+            discipline: discipline.rawValue,
+            grade_system: gradeSystem.rawValue,
+            grade_label: gradeLabel,
+            height_m: heightM,
+            rock_type: rockType,
+            terrain: terrain?.rawValue,
+            user_id: userID
+        )
+        let rows: [CommunityInsertedRouteRow] = try await client.from("routes")
+            .insert(payload)
+            .select("*")
+            .execute()
+            .value
+        guard let row = rows.first else { throw CommunityRepositoryError.notFound }
+        var matchingVenue: CommunityVenue? = nil
+        if let venueID {
+            let venues = try? await fetchVenues(query: nil)
+            matchingVenue = venues?.first(where: { $0.id == venueID })
+        }
+        return CommunityRoute(
+            id: row.id,
+            name: row.name,
+            description: row.description,
+            discipline: row.discipline,
+            gradeSystem: row.grade_system,
+            gradeLabel: row.grade_label,
+            heightM: row.height_m,
+            rockType: row.rock_type,
+            terrain: row.terrain,
+            imageUrl: row.image_url,
+            holds: nil,
+            venue: matchingVenue,
+            authorId: row.user_id,
+            isSaved: false,
+            createdAt: row.created_at
+        )
+    }
+
+    func fetchActivity(
+        beforeCreatedAt: Date?,
+        beforeID: UUID?,
+        pageSize: Int
+    ) async throws -> [ActivityEvent] {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let params = CommunityActivityParams(
+            before_created_at: beforeCreatedAt,
+            before_id: beforeID,
+            page_size: min(max(pageSize, 1), 50)
+        )
+        let events: [ActivityEvent] = try await client.rpc("get_activity", params: params)
+            .execute()
+            .value
+        return events
+    }
+    func markActivityRead(eventID: UUID) async throws {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        _ = try await client.from("activity_events")
+            .update(["read_at": Date().ISO8601Format()])
+            .eq("id", value: eventID.uuidString)
+            .eq("recipient_id", value: userID.uuidString)
+            .execute()
+    }
+
+    func markAllActivityRead() async throws {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        _ = try await client.from("activity_events")
+            .update(["read_at": Date().ISO8601Format()])
+            .eq("recipient_id", value: userID.uuidString)
+            .is("read_at", value: nil)
+            .execute()
+    }
+
+    func fetchUnreadActivityCount() async throws -> Int {
+        guard let client else { throw CommunityRepositoryError.unavailable }
+        let userID = try await client.auth.session.user.id
+        let count = try await client.from("activity_events")
+            .select("*", head: true, count: .exact)
+            .eq("recipient_id", value: userID.uuidString)
+            .is("read_at", value: nil)
+            .execute()
+            .count
+        return count ?? 0
+    }
+}
