+    private var climbersList: some View {
+        LazyVStack(spacing: AppSpacing.space12) {
+            ForEach(model.climbers) { climber in
+                ClimberRow(climber: climber, onFollowToggle: {
+                    if auth.isAuthenticated {
+                        Task { await model.toggleFollow(climberID: climber.id) }
+                    } else {
+                        auth.requestAuthentication()
+                    }
+                }, onSelect: {
+                    navigation.activeClimberProfile = climber.id
