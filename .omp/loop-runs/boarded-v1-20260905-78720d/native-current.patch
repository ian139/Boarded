+                RouteFormView(venues: model.venues) { newRoute in
+                    Task { await model.load() }
+                }
+            }
+        }
+        .sheet(isPresented: $showingCreateVenue) {
+            NavigationStack {
+                VenueFormView { newVenue in
+                    Task { await model.load() }
+                }
+            }
+        }
+        .sheet(item: $selectedRoute) { route in
+            NavigationStack {
+                RouteDetailView(route: route) {
+                    selectedRoute = nil
+                }
+            }
+        }
+        .task {
+            await model.load()
+        }
+    }
+
+    private var filterChips: some View {
+        ScrollView(.horizontal, showsIndicators: false) {
+            HStack(spacing: AppSpacing.space8) {
+                ForEach(ExploreCategory.allCases) { category in
+                    BoardedFilterControl(
+                        title: category.rawValue,
+                        isSelected: model.selectedCategory == category
+                    ) {
+                        model.selectedCategory = category
+                        Task { await model.load() }
+                    }
+                }
+            }
+        }
+    }
+
+    private var isEmpty: Bool {
+        switch model.selectedCategory {
+        case .all:
+            return model.routes.isEmpty && model.venues.isEmpty && model.climbers.isEmpty
+        case .routes, .saved:
+            return model.routes.isEmpty
+        case .venues:
+            return model.venues.isEmpty
+        case .climbers:
+            return model.climbers.isEmpty
+        }
+    }
+
+    @ViewBuilder
+    private var contentSections: some View {
+        switch model.selectedCategory {
+        case .all:
+            if !model.routes.isEmpty {
+                BoardedSectionHeading(title: "Featured Routes")
+                routesList
+            }
+            if !model.venues.isEmpty {
+                BoardedSectionHeading(title: "Venues & Crags")
+                venuesList
+            }
+            if !model.climbers.isEmpty {
+                BoardedSectionHeading(title: "Climbers")
+                climbersList
+            }
+        case .routes, .saved:
+            routesList
+        case .venues:
+            venuesList
+        case .climbers:
+            climbersList
+        }
+    }
+
+    private var routesList: some View {
+        LazyVStack(spacing: AppSpacing.space12) {
+            ForEach(model.routes) { route in
+                RouteCard(route: route, onSelect: {
+                    selectedRoute = route
+                }, onBookmarkToggle: {
+                    if auth.isAuthenticated {
+                        Task { await model.toggleBookmark(routeID: route.id) }
+                    } else {
+                        auth.requestAuthentication()
+                    }
+                })
+            }
+            if model.canLoadMore, let last = model.routes.last {
+                Color.clear
+                    .frame(height: 1)
+                    .onAppear {
