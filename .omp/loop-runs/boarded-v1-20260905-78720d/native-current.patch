diff --git a/apps/ios/Boarded/ViewModels/ActivityViewModel.swift b/apps/ios/Boarded/ViewModels/ActivityViewModel.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ea231e48109c954a12abe949235981a8b335574f
--- /dev/null
+++ b/apps/ios/Boarded/ViewModels/ActivityViewModel.swift
@@ -0,0 +1,94 @@
+import Foundation
+import Combine
+
+@MainActor
+final class ActivityViewModel: ObservableObject {
+    @Published private(set) var events: [ActivityEvent] = []
+    @Published private(set) var unreadCount: Int = 0
+    @Published private(set) var isLoading = false
+    @Published private(set) var isLoadingMore = false
+    @Published private(set) var canLoadMore = true
+    @Published private(set) var errorMessage: String?
+
+    private let repository: any CommunityRepository
+    private let pageSize = 30
+
+    init(repository: any CommunityRepository = AppServices.communityRepository) {
+        self.repository = repository
+    }
+
+    func load() async {
+        isLoading = true
+        errorMessage = nil
+        canLoadMore = true
+        defer { isLoading = false }
+        do {
+            async let fetchedEvents = repository.fetchActivity(beforeCreatedAt: nil, beforeID: nil, pageSize: pageSize)
+            async let count = repository.fetchUnreadActivityCount()
+            let (evs, unread) = try await (fetchedEvents, count)
+            events = evs
+            unreadCount = unread
+            canLoadMore = evs.count >= pageSize
+        } catch is CancellationError {
+            return
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func loadMore() async {
+        guard canLoadMore, !isLoadingMore, let last = events.last else { return }
+        isLoadingMore = true
+        defer { isLoadingMore = false }
+        do {
+            let older = try await repository.fetchActivity(
+                beforeCreatedAt: last.createdAt,
+                beforeID: last.id,
+                pageSize: pageSize
+            )
+            let existing = Set(events.map(\.id))
+            let unique = older.filter { !existing.contains($0.id) }
+            events.append(contentsOf: unique)
+            canLoadMore = older.count >= pageSize
+        } catch is CancellationError {
+            return
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func markRead(eventID: UUID) async {
+        guard let index = events.firstIndex(where: { $0.id == eventID && $0.readAt == nil }) else { return }
+        let now = Date()
+        events[index].readAt = now
+        unreadCount = max(0, unreadCount - 1)
+        do {
+            try await repository.markActivityRead(eventID: eventID)
+        } catch {
+            if let rollbackIndex = events.firstIndex(where: { $0.id == eventID }) {
+                events[rollbackIndex].readAt = nil
+                unreadCount += 1
+            }
+            errorMessage = error.localizedDescription
+        }
+    }
+
+    func markAllRead() async {
+        let previousEvents = events
+        let previousUnread = unreadCount
+        let now = Date()
+        for index in events.indices {
+            if events[index].readAt == nil {
+                events[index].readAt = now
+            }
+        }
+        unreadCount = 0
+        do {
+            try await repository.markAllActivityRead()
+        } catch {
+            events = previousEvents
+            unreadCount = previousUnread
+            errorMessage = error.localizedDescription
+        }
+    }
+}
