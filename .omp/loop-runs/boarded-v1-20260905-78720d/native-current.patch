+final class SharedFixtureStore: @unchecked Sendable {
+    static let shared = SharedFixtureStore()
+    private let lock = NSLock()
+    var savedRouteIDs: Set<UUID> = [UITestFixtures.redpointRidgeID]
+    var followedClimberIDs: Set<UUID> = [UITestFixtures.otherID, UITestFixtures.jordanID]
+
+    func isRouteSaved(_ id: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        return savedRouteIDs.contains(id)
+    }
+
+    func toggleBookmark(_ id: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        if savedRouteIDs.contains(id) {
+            savedRouteIDs.remove(id)
+            return false
+        } else {
+            savedRouteIDs.insert(id)
+            return true
+        }
+    }
+
+    func isClimberFollowed(_ id: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        return followedClimberIDs.contains(id)
+    }
+
+    func toggleFollow(_ id: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        if followedClimberIDs.contains(id) {
+            followedClimberIDs.remove(id)
+            return false
+        } else {
+            followedClimberIDs.insert(id)
+            return true
+        }
+    }
 }
