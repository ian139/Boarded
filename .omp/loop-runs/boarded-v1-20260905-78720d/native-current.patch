index 0000000000000000000000000000000000000000..55b1cab54624bb03bb623ff92a88273ee028a2a0
--- /dev/null
+++ b/apps/ios/Boarded/Boarded/Services/CommunityRepository.swift
@@ -0,0 +1,559 @@
+import Foundation
+
+protocol CommunityRepository: Sendable {
+    func fetchExploreRoutes(
+        searchText: String,
+        venueFilter: UUID?,
+        savedOnly: Bool,
+        beforeCreatedAt: Date?,
+        beforeID: UUID?,
+        pageSize: Int
+    ) async throws -> [CommunityRoute]
+
+    func fetchVenues(query: String?) async throws -> [CommunityVenue]
+    func searchClimbers(query: String, pageSize: Int) async throws -> [CommunityClimber]
+    func toggleBookmark(routeID: UUID) async throws -> Bool
+    func toggleFollow(climberID: UUID) async throws -> Bool
+
+    func createVenue(
+        name: String,
+        kind: VenueKind,
+        area: String?,
+        description: String?
+    ) async throws -> CommunityVenue
+
+    func createRoute(
+        venueID: UUID?,
+        name: String,
+        discipline: ClimbDiscipline,
+        gradeSystem: GradeSystem,
+        gradeLabel: String?,
+        heightM: Double?,
+        rockType: String?,
+        terrain: RouteTerrain?
+    ) async throws -> CommunityRoute
+
+    func fetchActivity(
+        beforeCreatedAt: Date?,
+        beforeID: UUID?,
+        pageSize: Int
+    ) async throws -> [ActivityEvent]
+
+    func markActivityRead(eventID: UUID) async throws
+    func markAllActivityRead() async throws
+    func fetchUnreadActivityCount() async throws -> Int
+}
+
+enum CommunityRepositoryError: LocalizedError, Equatable {
+    case unavailable
+    case notFound
+    case unauthenticated
+    case invalidData
+
+    var errorDescription: String? {
+        switch self {
+        case .unavailable: return "Community services are unavailable. Check your network or configuration."
+        case .notFound: return "The requested community item could not be found."
+        case .unauthenticated: return "Sign in to perform this action."
+        case .invalidData: return "Please enter valid community details."
+        }
+    }
+}
+
+// MARK: - Mock Implementation for Fixtures and Previews
+
+final class MockCommunityRepository: CommunityRepository, @unchecked Sendable {
+    private let lock = NSLock()
+    private var routes: [CommunityRoute]
+    private var venues: [CommunityVenue]
+    private var climbers: [CommunityClimber]
+    private var activityEvents: [ActivityEvent]
+    private var savedRouteIDs: Set<UUID>
+    private var followedClimberIDs: Set<UUID>
+    let currentUserID: UUID
+    let now: Date
+
+    init(
+        routes: [CommunityRoute] = [],
+        venues: [CommunityVenue] = [],
+        climbers: [CommunityClimber] = [],
+        activityEvents: [ActivityEvent] = [],
+        savedRouteIDs: Set<UUID> = [],
+        followedClimberIDs: Set<UUID> = [],
+        currentUserID: UUID = UUID(uuidString: "11111111-1111-4111-8111-111111111111")!,
+        now: Date = Date(timeIntervalSince1970: 1_800_000_000)
+    ) {
+        self.routes = routes
+        self.venues = venues
+        self.climbers = climbers
+        self.activityEvents = activityEvents
+        self.savedRouteIDs = savedRouteIDs
+        self.followedClimberIDs = followedClimberIDs
+        self.currentUserID = currentUserID
+        self.now = now
+    }
+
+    func fetchExploreRoutes(
+        searchText: String,
+        venueFilter: UUID?,
+        savedOnly: Bool,
+        beforeCreatedAt: Date?,
+        beforeID: UUID?,
+        pageSize: Int
+    ) async throws -> [CommunityRoute] {
+        lock.lock(); defer { lock.unlock() }
+        var result = routes
+        if savedOnly {
+            result = result.filter { SharedFixtureStore.shared.isRouteSaved($0.id) }
+        }
+        if let venueFilter {
+            result = result.filter { $0.venue?.id == venueFilter }
+        }
+        let query = searchText.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        if !query.isEmpty {
+            result = result.filter { route in
+                route.name.lowercased().contains(query) ||
+                (route.gradeLabel?.lowercased().contains(query) ?? false) ||
+                (route.venue?.name.lowercased().contains(query) ?? false) ||
+                (route.rockType?.lowercased().contains(query) ?? false)
+            }
+        }
+        for index in result.indices {
+            result[index].isSaved = SharedFixtureStore.shared.isRouteSaved(result[index].id)
+        }
+        return Array(result.prefix(pageSize))
+    }
+
+    func fetchVenues(query: String?) async throws -> [CommunityVenue] {
+        lock.lock(); defer { lock.unlock() }
+        guard let query = query?.trimmingCharacters(in: .whitespacesAndNewlines).lowercased(), !query.isEmpty else {
+            return venues
+        }
+        return venues.filter {
+            $0.name.lowercased().contains(query) || ($0.area?.lowercased().contains(query) ?? false)
+        }
+    }
+
+    func searchClimbers(query: String, pageSize: Int) async throws -> [CommunityClimber] {
+        lock.lock(); defer { lock.unlock() }
+        let trimmed = query.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        guard !trimmed.isEmpty else {
+            return Array(climbers.prefix(pageSize))
+        }
+        return Array(climbers.filter { climber in
+            (climber.username?.lowercased().contains(trimmed) ?? false) ||
+            (climber.fullName?.lowercased().contains(trimmed) ?? false) ||
+            (climber.homeArea?.lowercased().contains(trimmed) ?? false)
+        }.prefix(pageSize))
+    }
+
+    func toggleBookmark(routeID: UUID) async throws -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        let nowSaved = SharedFixtureStore.shared.toggleBookmark(routeID)
+        savedRouteIDs = SharedFixtureStore.shared.savedRouteIDs
+        for index in routes.indices {
+            if routes[index].id == routeID {
+                routes[index].isSaved = nowSaved
+            }
+        }
+        return nowSaved
+    }
+
+    func toggleFollow(climberID: UUID) async throws -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        let isFollowing = SharedFixtureStore.shared.toggleFollow(climberID)
+        followedClimberIDs = SharedFixtureStore.shared.followedClimberIDs
+        for index in climbers.indices {
+            if climbers[index].id == climberID {
+                climbers[index].isFollowed = isFollowing
+                climbers[index].followerCount += isFollowing ? 1 : -1
+            }
+        }
+        return isFollowing
+    }
+
+    func createVenue(
+        name: String,
+        kind: VenueKind,
+        area: String?,
+        description: String?
+    ) async throws -> CommunityVenue {
+        lock.lock(); defer { lock.unlock() }
+        let venue = CommunityVenue(
+            id: UUID(),
+            name: name,
+            kind: kind,
+            area: area,
+            description: description,
+            imageUrl: nil,
+            userId: currentUserID,
+            isPublic: true,
+            createdAt: now,
+            updatedAt: now
+        )
+        venues.insert(venue, at: 0)
+        return venue
+    }
+
+    func createRoute(
+        venueID: UUID?,
+        name: String,
+        discipline: ClimbDiscipline,
+        gradeSystem: GradeSystem,
+        gradeLabel: String?,
+        heightM: Double?,
+        rockType: String?,
+        terrain: RouteTerrain?
+    ) async throws -> CommunityRoute {
+        lock.lock(); defer { lock.unlock() }
+        let matchingVenue = venueID.flatMap { vid in venues.first(where: { $0.id == vid }) }
+        let route = CommunityRoute(
+            id: UUID(),
+            name: name,
+            description: nil,
+            discipline: discipline,
+            gradeSystem: gradeSystem,
+            gradeLabel: gradeLabel,
+            heightM: heightM,
+            rockType: rockType,
+            terrain: terrain,
+            imageUrl: nil,
+            holds: nil,
+            venue: matchingVenue,
+            authorId: currentUserID,
+            isSaved: false,
+            createdAt: now
+        )
+        routes.insert(route, at: 0)
+        return route
+    }
+
+    func fetchActivity(
+        beforeCreatedAt: Date?,
+        beforeID: UUID?,
+        pageSize: Int
+    ) async throws -> [ActivityEvent] {
+        lock.lock(); defer { lock.unlock() }
+        var result = activityEvents.sorted(by: { $0.createdAt > $1.createdAt })
+        if let beforeCreatedAt {
+            result = result.filter { $0.createdAt < beforeCreatedAt }
+        }
+        return Array(result.prefix(pageSize))
+    }
+
+    func markActivityRead(eventID: UUID) async throws {
+        lock.lock(); defer { lock.unlock() }
+        if let index = activityEvents.firstIndex(where: { $0.id == eventID }) {
+            activityEvents[index].readAt = now
+        }
+    }
+
+    func markAllActivityRead() async throws {
+        lock.lock(); defer { lock.unlock() }
+        for index in activityEvents.indices {
+            if activityEvents[index].readAt == nil {
+                activityEvents[index].readAt = now
+            }
+        }
+    }
+
+    func fetchUnreadActivityCount() async throws -> Int {
+        lock.lock(); defer { lock.unlock() }
+        return activityEvents.filter { $0.readAt == nil }.count
+    }
+}
