index 9e5966a06f5ab6f7f9fc51a7fcef2286ed65393b..8c79b6b8dae044dc66dd1ecc68bc604d4b8af0a2 100644
--- a/apps/ios/Boarded/Boarded/Services/SessionSyncService.swift
+++ b/apps/ios/Boarded/Boarded/Services/SessionSyncService.swift
@@ -222,6 +222,92 @@ final class SessionSyncService: ObservableObject {
     }
 
 
+    /// Account-scoped completed sessions stored on this device.
+    func completedSessions() -> [PendingSession] {
+        let activeUserID = userID
+        let descriptor = FetchDescriptor<PendingSession>(
+            predicate: #Predicate { $0.userId == activeUserID && $0.endedAt != nil },
+            sortBy: [SortDescriptor(\.startedAt, order: .reverse)]
+        )
+        return (try? modelContext.fetch(descriptor)) ?? []
+    }
+
+    /// Account-scoped attempts for a session stored on this device.
+    func attempts(for sessionID: UUID) -> [PendingAttempt] {
+        let activeUserID = userID
+        let descriptor = FetchDescriptor<PendingAttempt>(
+            predicate: #Predicate { $0.sessionId == sessionID && $0.userId == activeUserID },
+            sortBy: [SortDescriptor(\.occurredAt, order: .reverse)]
+        )
+        return (try? modelContext.fetch(descriptor)) ?? []
+    }
+
+    /// Merges account-scoped local and remote history, preserving pending local edits and failure states.
+    func mergedSessions() async -> (sessions: [ClimbingSession], syncStates: [UUID: SyncState], remoteError: Error?) {
+        let localCompleted = completedSessions()
+        var localMap: [UUID: PendingSession] = [:]
+        var states: [UUID: SyncState] = [:]
+        for s in localCompleted {
+            localMap[s.id] = s
+            states[s.id] = s.syncState
+        }
+
+        var remoteSessions: [ClimbingSession]?
+        var remoteError: Error?
+        do {
+            remoteSessions = try await repository.fetchSessions(userID: userID)
+        } catch {
+            remoteError = error
+        }
+
+        var mergedMap: [UUID: ClimbingSession] = [:]
+        if let remoteSessions {
+            for s in remoteSessions {
+                mergedMap[s.id] = s
+                if states[s.id] == nil {
+                    states[s.id] = .synced
+                }
+            }
+        }
+        for (id, local) in localMap {
+            if local.syncState != .synced || mergedMap[id] == nil {
+                mergedMap[id] = local.remote
+            }
+        }
+        let sorted = Array(mergedMap.values).sorted(by: { $0.startedAt > $1.startedAt })
+        return (sorted, states, remoteError)
+    }
+
+    /// Merges local and remote attempts for a session.
+    func mergedAttempts(for sessionID: UUID) async -> (attempts: [ClimbAttempt], remoteError: Error?) {
+        let localAttempts = attempts(for: sessionID)
+        var localMap: [UUID: PendingAttempt] = [:]
+        for a in localAttempts {
+            localMap[a.id] = a
+        }
+        var remoteAttempts: [ClimbAttempt]?
+        var remoteError: Error?
+        do {
+            remoteAttempts = try await repository.fetchAttempts(sessionID: sessionID)
+        } catch {
+            remoteError = error
+        }
+
+        var mergedMap: [UUID: ClimbAttempt] = [:]
+        if let remoteAttempts {
+            for a in remoteAttempts {
+                mergedMap[a.id] = a
+            }
+        }
+        for (id, local) in localMap {
+            if local.syncState != .synced || mergedMap[id] == nil {
+                mergedMap[id] = local.remote
+            }
+        }
+        let sorted = Array(mergedMap.values).sorted(by: { $0.attemptNumber < $1.attemptNumber })
+        return (sorted, remoteError)
+    }
+
