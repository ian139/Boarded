+                .font(AppTypography.dataM)
+                .foregroundStyle(AppColor.textPrimary)
+            Text(label)
+                .font(AppTypography.caption)
+                .foregroundStyle(AppColor.textSecondary)
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+
+    private var attemptsSection: some View {
+        VStack(alignment: .leading, spacing: AppSpacing.space12) {
+            BoardedSectionHeading(title: "Attempts (\(attempts.count))")
+            if isLoadingAttempts {
+                ProgressView("Loading attempts…")
+                    .frame(maxWidth: .infinity)
+            } else if let error = attemptsError, attempts.isEmpty {
+                BoardedInlineError(message: error) {
+                    Task { await loadAttempts() }
+                }
+            } else if attempts.isEmpty {
+                Text("No attempts recorded in this session.")
+                    .font(AppTypography.bodyM)
+                    .foregroundStyle(AppColor.textSecondary)
+            } else {
+                ForEach(attempts) { attempt in
+                    attemptRow(attempt)
+                }
+            }
+        }
+    }
+
+    private func attemptRow(_ attempt: ClimbAttempt) -> some View {
+        VStack(alignment: .leading, spacing: AppSpacing.space6) {
+            HStack {
+                Text("#\(attempt.attemptNumber)")
+                    .font(AppTypography.caption.weight(.bold))
+                    .foregroundStyle(AppColor.textSecondary)
+                Text(attempt.routeName)
+                    .font(AppTypography.labelL)
+                    .foregroundStyle(AppColor.textPrimary)
+                Spacer()
+                outcomeBadge(attempt.outcome)
+            }
+            HStack(spacing: AppSpacing.space8) {
+                Text("\(attempt.discipline.title) · \(attempt.gradeLabel)")
+                    .font(AppTypography.caption)
+                    .foregroundStyle(AppColor.textSecondary)
+                Spacer()
+                Text(BoardedFormat.timeOnly(attempt.occurredAt))
+                    .font(AppTypography.caption)
+                    .foregroundStyle(AppColor.textTertiary)
+            }
+            if let notes = attempt.notes, !notes.isEmpty {
+                Text(notes)
+                    .font(AppTypography.caption)
+                    .foregroundStyle(AppColor.textSecondary)
+            }
+        }
+        .padding(AppLayout.cardPadding)
+        .boardedSurface(in: AppRadius.card())
+        .accessibilityIdentifier("attempt-row-\(attempt.attemptNumber)")
+    }
+
+    private func outcomeBadge(_ outcome: AttemptOutcome) -> some View {
+        HStack(spacing: 4) {
+            if outcome == .sent {
+                Text("✓").font(.system(size: 12, weight: .bold))
+            }
+            Text(outcome.title)
+        }
+        .font(AppTypography.caption.weight(.semibold))
+        .foregroundStyle(outcome == .sent ? AppColor.success : AppColor.textSecondary)
+        .padding(.horizontal, AppSpacing.space8)
+        .padding(.vertical, AppSpacing.space4)
+        .background(outcome == .sent ? AppColor.success.opacity(0.15) : AppColor.surfaceCard, in: Capsule())
+    }
+
+    private func loadAttempts() async {
+        guard isOwner else {
+            isLoadingAttempts = false
+            return
+        }
+        isLoadingAttempts = true
+        attemptsError = nil
+        defer { isLoadingAttempts = false }
+
+        let sessionID = climbingSession.id
+        let sessionUserID = climbingSession.userId
+        let descriptor = FetchDescriptor<PendingAttempt>(
+            predicate: #Predicate { $0.sessionId == sessionID && $0.userId == sessionUserID },
+            sortBy: [SortDescriptor(\.occurredAt, order: .forward)]
+        )
+        let localAttempts = (try? modelContext.fetch(descriptor)) ?? []
+
+        var remoteAttempts: [ClimbAttempt]?
+        var remoteError: Error?
+        do {
+            remoteAttempts = try await AppServices.sessionRepository.fetchAttempts(sessionID: sessionID)
+        } catch {
+            remoteError = error
+        }
+
+        var merged: [UUID: ClimbAttempt] = [:]
+        if let remoteAttempts {
+            for a in remoteAttempts { merged[a.id] = a }
+        }
+        for a in localAttempts {
+            if a.syncState != .synced || merged[a.id] == nil {
+                merged[a.id] = a.remote
+            }
+        }
+
+        attempts = Array(merged.values).sorted(by: { $0.attemptNumber < $1.attemptNumber })
+        if attempts.isEmpty, let remoteError {
+            attemptsError = "Unable to load attempts: \(remoteError.localizedDescription)"
+        }
+    }
+}
