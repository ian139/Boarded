+    func testFixtureStateScopedPerInstanceHonoringExplicitSeeds() async throws {
+        let routeID = UITestFixtures.redpointRidgeID
+        let climberID = UITestFixtures.otherID
+        let route = CommunityRoute(
+            id: routeID,
+            name: "Redpoint Ridge",
+            discipline: .sport,
+            gradeSystem: .yds,
+            gradeLabel: "5.12a",
+            venue: nil,
+            isSaved: false
+        )
+        let climber = CommunityClimber(
+            id: climberID,
+            username: "mayak",
+            fullName: "Maya K.",
+            isFollowed: false,
+            followerCount: 10,
+            followingCount: 5
+        )
+
+        // Seeded empty: must NOT be contaminated by any global defaults
+        let isolatedRepo = MockCommunityRepository(
+            routes: [route],
+            climbers: [climber],
+            savedRouteIDs: [],
+            followedClimberIDs: []
+        )
+        let routes = try await isolatedRepo.fetchExploreRoutes(
+            searchText: "",
+            venueFilter: nil,
+            savedOnly: false,
+            beforeCreatedAt: nil,
+            beforeID: nil,
+            pageSize: 10
+        )
+        let climbers = try await isolatedRepo.searchClimbers(query: "", pageSize: 10)
+
+        XCTAssertEqual(routes.first?.isSaved, false)
+        XCTAssertEqual(climbers.first?.isFollowed, false)
+
+        // Toggling in isolatedRepo changes only its isolated store
+        let saved = try await isolatedRepo.toggleBookmark(routeID: routeID)
+        XCTAssertTrue(saved)
+
+        // A second repository with separate seed remains independent
+        let otherRepo = MockCommunityRepository(
+            routes: [route],
+            climbers: [climber],
+            savedRouteIDs: [],
+            followedClimberIDs: []
+        )
+        let otherRoutes = try await otherRepo.fetchExploreRoutes(
+            searchText: "",
+            venueFilter: nil,
+            savedOnly: false,
+            beforeCreatedAt: nil,
+            beforeID: nil,
+            pageSize: 10
+        )
+        XCTAssertEqual(otherRoutes.first?.isSaved, false)
+    }
+
+    func testConsistentProjectionsAcrossSharedFixtureRepositories() async throws {
