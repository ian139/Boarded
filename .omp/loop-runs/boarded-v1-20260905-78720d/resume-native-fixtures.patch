+        XCTAssertTrue(isSaved)
+
+        let communityRoutes = try await communityRepo.fetchExploreRoutes(
+            searchText: "",
+            venueFilter: nil,
+            savedOnly: false,
+            beforeCreatedAt: nil,
+            beforeID: nil,
+            pageSize: 10
+        )
+        XCTAssertEqual(communityRoutes.first?.isSaved, true)
+
+        // Follow climber in Community -> Feed reflects it and includes in followingOnly
