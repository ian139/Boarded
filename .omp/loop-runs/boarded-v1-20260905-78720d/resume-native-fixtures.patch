+        let climber = UITestFixtures.climbers.first(where: { $0.id == climberID }) ?? CommunityClimber(
+            id: climberID,
+            username: "mayak",
+            fullName: "Maya K.",
+            isFollowed: false,
+            followerCount: 10,
+            followingCount: 5
+        )
+
+        let communityRepo = MockCommunityRepository(
+            routes: [route],
+            climbers: [climber],
+            fixtureStore: store
+        )
+        let feedRepo = MockFeedRepository(
+            items: [feedItem],
+            currentUserID: UUID(),
+            fixtureStore: store
+        )
+
+        // Initial projection: neither saved nor followed
+        let initialFeed = try await feedRepo.fetchFeed(cursor: nil, authorFilter: nil, pageSize: 10, followingOnly: false)
+        XCTAssertEqual(initialFeed.items.first?.isSaved, false)
+        XCTAssertEqual(initialFeed.items.first?.author.isFollowed, false)
+
+        // Save route in Feed -> Community reflects it as saved
