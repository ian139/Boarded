diff --git a/apps/ios/Boarded/BoardedUITests/BoardedUITests.swift b/apps/ios/Boarded/BoardedUITests/BoardedUITests.swift
index 81075e864df5742ce7657e864eefe7081f430a04..fbb75df3c0c17ab39ea61de8692a446310c0d533 100644
--- a/apps/ios/Boarded/BoardedUITests/BoardedUITests.swift
+++ b/apps/ios/Boarded/BoardedUITests/BoardedUITests.swift
@@ -416,4 +416,67 @@ final class BoardedUITests: XCTestCase {
         XCTAssertTrue(app.textFields["profile-username"].exists)
         XCTAssertTrue(app.textFields["profile-display-name"].exists)
     }
+
+    func testMultilineCaptionAndLongRouteNameLayoutGrowthAtStandardDynamicType() {
+        // Control: default fixture at ordinary Large Dynamic Type.
+        app.terminate()
+        launch(["-UIPreferredContentSizeCategoryName", "UICTContentSizeCategoryL"])
+        XCTAssertTrue(element("feed-list").waitForExistence(timeout: 5))
+        let controlRoute = app.buttons["post-route"].firstMatch
+        XCTAssertTrue(controlRoute.waitForExistence(timeout: 5))
+        reveal(controlRoute, forInteraction: false)
+        let controlRouteHeight = controlRoute.frame.height
+
+        openFirstPost()
+        let controlCaption = element("session-post-caption")
+        reveal(controlCaption, forInteraction: false)
+        XCTAssertTrue(controlCaption.waitForExistence(timeout: 5))
+        let controlCaptionHeight = controlCaption.frame.height
+
+        // Expanded: opt-in long-content fixture, same explicit Large size.
+        app.terminate()
+        launch(["--boarded-ui-long-content", "-UIPreferredContentSizeCategoryName", "UICTContentSizeCategoryL"])
+        XCTAssertTrue(element("feed-list").waitForExistence(timeout: 5))
+        let routeAction = app.buttons["post-route"].firstMatch
+        XCTAssertTrue(routeAction.waitForExistence(timeout: 5))
+        reveal(routeAction, forInteraction: false)
+        XCTAssertTrue(routeAction.label.contains("The Directissima Great Roof Extension and Upper Headwall Traverse"))
+        XCTAssertGreaterThan(routeAction.frame.height, controlRouteHeight)
+
+        openFirstPost()
+        let caption = element("session-post-caption")
+        reveal(caption, forInteraction: false)
+        XCTAssertTrue(caption.waitForExistence(timeout: 5))
+        XCTAssertTrue(caption.label.contains("Six tries on the directissima extension."))
+        XCTAssertTrue(caption.label.contains("Quiet feet through the technical crux."))
+        XCTAssertTrue(caption.label.contains("Then daylight over the lip."))
+        XCTAssertGreaterThan(caption.frame.height, controlCaptionHeight)
+
+        capture("multiline-long-content")
+    }
+
+    func testRaisedLogUpperStripActivationNavigatesToLogDestination() {
+        XCTAssertTrue(element("main-tabs").waitForExistence(timeout: 5))
+        let logTab = app.buttons["Log"]
+        XCTAssertTrue(logTab.waitForExistence(timeout: 5))
+        let nonLogTab = app.buttons["Feed"]
+        XCTAssertTrue(nonLogTab.waitForExistence(timeout: 5))
+
+        // Compute y relative to non-Log tab top (minus 6), x at Log center.
+        // Do not blindly subtract 6 from Log AX frame as it may already include overhang.
+        let targetY = nonLogTab.frame.minY - 6.0
+        let targetX = logTab.frame.midX
+
+        let window = app.windows.firstMatch
+        let origin = window.coordinate(withNormalizedOffset: .zero)
+        let tapTarget = origin.withOffset(CGVector(dx: targetX - window.frame.minX, dy: targetY - window.frame.minY))
+        tapTarget.tap()
+
+        let venue = app.textFields["Venue"]
+        XCTAssertTrue(venue.waitForExistence(timeout: 5))
+        XCTAssertTrue(app.buttons["start-session"].waitForExistence(timeout: 5))
+        XCTAssertTrue(app.navigationBars["Log"].waitForExistence(timeout: 5))
+
+        capture("log-upper-strip-activation")
+    }
 }
