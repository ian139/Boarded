+
+  IF v_climber_row IS NULL OR (v_climber_row->>'username') <> 'climber_one' THEN
+    RAISE EXCEPTION 'FAILED: search_climbers failed';
+  END IF;
+
+  IF (v_climber_row->>'is_followed')::boolean IS NOT TRUE OR (v_climber_row->>'follower_count')::int <> 1 THEN
+    RAISE EXCEPTION 'FAILED: search_climbers did not return accurate is_followed or follower_count';
+  END IF;
+
+  -- 12. Test RPC get_activity
