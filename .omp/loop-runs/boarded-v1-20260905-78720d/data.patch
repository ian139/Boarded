 export type GradeInput = string | null | undefined;
 
+/**
+ * Returns the ordered canonical list of grade labels for a system.
+ * Custom grades have no intrinsic ordering and return an empty list.
+ */
+export const gradesForSystem = (system: GradeSystem): readonly string[] => {
+  switch (system) {
+    case 'v_scale':
+      return V_GRADES;
+    case 'font':
+      return FONT_GRADES;
+    case 'yds':
+      return YDS_GRADES;
+    case 'custom':
+      return [];
+  }
+};
+
+/**
+ * Returns the canonical label for a grade within its system, or null when
+ * the label is not a member of the system's catalog. Custom labels are trimmed.
+ */
+export const canonicalGrade = (
+  label: GradeInput,
+  system: GradeSystem
+): string | null => {
+  if (typeof label !== 'string') return null;
+  const trimmed = label.trim();
+  if (!trimmed) return null;
+  if (system === 'custom') return trimmed;
+
+  const catalog = gradesForSystem(system);
+  const found = catalog.find((g) => g.toLowerCase() === trimmed.toLowerCase());
+  return found ?? null;
+};
+
+/**
+ * Zero-based rank within the system's ordering, or -1 for unknown/custom.
+ */
+export const gradeRank = (
+  label: GradeInput,
+  system: GradeSystem
+): number => {
+  const canonical = canonicalGrade(label, system);
+  if (!canonical) return -1;
+  const catalog = gradesForSystem(system);
+  const index = catalog.indexOf(canonical);
+  return index >= 0 ? index : -1;
+};
+
+/**
+ * Returns the grade label for a zero-based rank within a system, or null if out of range.
+ */
+export const gradeLabelForRank = (
+  rank: number,
+  system: GradeSystem
+): string | null => {
+  const catalog = gradesForSystem(system);
+  if (rank >= 0 && rank < catalog.length) {
+    return catalog[rank];
+  }
+  return null;
+};
