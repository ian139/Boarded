+++ b/supabase/migrations/014_community_prerequisites.sql
@@ -0,0 +1,890 @@
+-- 014_community_prerequisites.sql
+-- Additive migration implementing the V1 community contract:
+-- 1. Venues catalog with honest nullable metadata
+-- 2. Extended route catalog (outdoor/crag support, nullable wall_id, venue_id, discipline, grade system, metadata)
+-- 3. Cutover climb_attempts.board_route_id to route_id
+-- 4. Private climbing session conditions & notes
+-- 5. Public social follows table and relationship counts
+-- 6. Owner-only route bookmarks
+-- 7. Activity events inbox driven by real social transitions
+-- 8. Updated get_session_feed RPC (author.is_followed, top-level route, attempt.route_id, following_only filter)
+-- 9. Community discovery RPCs: get_explore_routes, search_climbers, get_activity
+
+-- ============================================================================
+-- 1. VENUES TABLE
+-- ============================================================================
+CREATE TABLE IF NOT EXISTS public.venues (
+  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
+  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
+  name TEXT NOT NULL CHECK (length(trim(name)) >= 1 AND length(name) <= 120),
+  kind TEXT NOT NULL CHECK (kind IN ('crag', 'gym', 'board')),
+  area TEXT CHECK (area IS NULL OR (length(trim(area)) >= 1 AND length(area) <= 120)),
+  description TEXT CHECK (description IS NULL OR length(description) <= 2000),
+  image_url TEXT CHECK (image_url IS NULL OR length(image_url) <= 1000),
+  is_public BOOLEAN NOT NULL DEFAULT true,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS idx_venues_is_public ON public.venues(is_public);
+CREATE INDEX IF NOT EXISTS idx_venues_user_id ON public.venues(user_id);
+CREATE INDEX IF NOT EXISTS idx_venues_kind ON public.venues(kind);
+
+ALTER TABLE public.venues ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "venues_select_visible" ON public.venues
+  FOR SELECT TO anon, authenticated
+  USING (
+    is_public = true
+    OR auth.uid() = user_id
+    OR public.is_moderator()
+  );
+
+CREATE POLICY "venues_insert_owner" ON public.venues
+  FOR INSERT TO authenticated
+  WITH CHECK (auth.uid() = user_id);
+
+CREATE POLICY "venues_update_owner" ON public.venues
+  FOR UPDATE TO authenticated
+  USING (auth.uid() = user_id OR public.is_moderator())
+  WITH CHECK (auth.uid() = user_id OR public.is_moderator());
+
+CREATE POLICY "venues_delete_owner" ON public.venues
+  FOR DELETE TO authenticated
+  USING (auth.uid() = user_id OR public.is_moderator());
+
+GRANT SELECT ON TABLE public.venues TO anon, authenticated;
+GRANT INSERT, UPDATE, DELETE ON TABLE public.venues TO authenticated;
+
+-- ============================================================================
+-- 2. EXTEND ROUTES TABLE
+-- ============================================================================
+-- wall_id is nullable for outdoor/crag routes (no fake wall IDs)
+ALTER TABLE public.routes ALTER COLUMN wall_id DROP NOT NULL;
+
+-- Add venue link and physical/community climbing metadata
+ALTER TABLE public.routes
+  ADD COLUMN IF NOT EXISTS venue_id UUID REFERENCES public.venues(id) ON DELETE SET NULL,
+  ADD COLUMN IF NOT EXISTS discipline TEXT NOT NULL DEFAULT 'board'
+    CHECK (discipline IN ('boulder', 'sport', 'trad', 'top_rope', 'board', 'other')),
+  ADD COLUMN IF NOT EXISTS grade_system TEXT NOT NULL DEFAULT 'v_scale'
+    CHECK (grade_system IN ('v_scale', 'font', 'yds', 'custom')),
+  ADD COLUMN IF NOT EXISTS grade_label TEXT
+    CHECK (grade_label IS NULL OR length(grade_label) <= 24),
+  ADD COLUMN IF NOT EXISTS height_m NUMERIC(6, 2)
+    CHECK (height_m IS NULL OR height_m > 0),
+  ADD COLUMN IF NOT EXISTS rock_type TEXT
+    CHECK (rock_type IS NULL OR (length(trim(rock_type)) >= 1 AND length(rock_type) <= 120)),
+  ADD COLUMN IF NOT EXISTS terrain TEXT
+    CHECK (terrain IS NULL OR terrain IN ('slab', 'vertical', 'overhang', 'roof'));
+
+-- Backfill existing routes: preserve existing grade_v/grade_font and populate canonical grade_label
+UPDATE public.routes
+   SET grade_label = COALESCE(grade_v, grade_font),
+       grade_system = CASE
+         WHEN grade_v IS NOT NULL THEN 'v_scale'
+         WHEN grade_font IS NOT NULL THEN 'font'
+         ELSE grade_system
+       END
+ WHERE grade_label IS NULL AND (grade_v IS NOT NULL OR grade_font IS NOT NULL);
+
+CREATE INDEX IF NOT EXISTS idx_routes_venue_id ON public.routes(venue_id);
+CREATE INDEX IF NOT EXISTS idx_routes_discipline ON public.routes(discipline);
+CREATE INDEX IF NOT EXISTS idx_routes_grade_system ON public.routes(grade_system);
+
+-- ============================================================================
+-- PARENT VISIBILITY SECURITY DEFINER PREDICATES
+-- Fixed search_path SECURITY DEFINER predicates that bypass caller RLS on parent
+-- tables (walls, venues) to reliably distinguish genuinely missing/local records
+-- from existing hidden/private records, while enforcing caller owner/moderator/public rules.
+-- ============================================================================
+CREATE OR REPLACE FUNCTION public.is_wall_accessible(target_wall_id TEXT)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT CASE
+    -- NULL wall_id (e.g. outdoor crag routes) requires no wall
+    WHEN target_wall_id IS NULL THEN true
+    -- If the wall exists in public.walls, it MUST be public, caller-owned, or caller is moderator
+    WHEN EXISTS (SELECT 1 FROM public.walls WHERE id::text = target_wall_id) THEN
+      EXISTS (
+        SELECT 1 FROM public.walls
+         WHERE id::text = target_wall_id
+           AND (is_public = true OR user_id = auth.uid() OR public.is_moderator())
+      )
+    -- Local/unregistered wall IDs (e.g. 'default-wall') with no server record are allowed
+    ELSE true
+  END;
+$$;
+REVOKE ALL ON FUNCTION public.is_wall_accessible(text) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.is_wall_accessible(text) TO anon, authenticated;
+
+CREATE OR REPLACE FUNCTION public.is_venue_accessible(target_venue_id UUID)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT CASE
+    WHEN target_venue_id IS NULL THEN true
+    ELSE EXISTS (
+      SELECT 1 FROM public.venues
+       WHERE id = target_venue_id
+         AND (is_public = true OR user_id = auth.uid() OR public.is_moderator())
+    )
+  END;
+$$;
+REVOKE ALL ON FUNCTION public.is_venue_accessible(uuid) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.is_venue_accessible(uuid) TO anon, authenticated;
+
+CREATE OR REPLACE FUNCTION public.is_route_accessible(target_route_id UUID)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT EXISTS (
+    SELECT 1 FROM public.routes r
+     WHERE r.id = target_route_id
+       AND (r.is_public = true OR r.user_id = auth.uid() OR public.is_moderator())
+       AND public.is_wall_accessible(r.wall_id)
+       AND public.is_venue_accessible(r.venue_id)
+  );
+$$;
+REVOKE ALL ON FUNCTION public.is_route_accessible(uuid) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.is_route_accessible(uuid) TO anon, authenticated;
+
+-- Enforce underlying wall and venue visibility for public routes:
+-- A public route on a private wall or private venue cannot be viewed by everyone.
+DROP POLICY IF EXISTS "Public routes are viewable by everyone" ON public.routes;
+CREATE POLICY "Public routes are viewable by everyone" ON public.routes
+  FOR SELECT TO anon, authenticated
+  USING (
+    is_public = true
+    AND public.is_wall_accessible(wall_id)
+    AND public.is_venue_accessible(venue_id)
+  );
+
+-- ============================================================================
+-- 3. CLIMBING SESSIONS PRIVATE CONTEXT (CONDITIONS & NOTES)
+-- ============================================================================
+ALTER TABLE public.climbing_sessions
+  ADD COLUMN IF NOT EXISTS conditions TEXT
+    CHECK (conditions IS NULL OR (length(trim(conditions)) >= 1 AND length(conditions) <= 500)),
+  ADD COLUMN IF NOT EXISTS notes TEXT
+    CHECK (notes IS NULL OR (length(trim(notes)) >= 1 AND length(notes) <= 1000));
+
+-- ============================================================================
+-- 4. ATTEMPT LINK CUTOVER: board_route_id -> route_id
+-- ============================================================================
+DO $$
+BEGIN
+  IF EXISTS (
+    SELECT 1 FROM information_schema.columns
+     WHERE table_schema = 'public'
+       AND table_name = 'climb_attempts'
+       AND column_name = 'board_route_id'
+  ) THEN
+    ALTER TABLE public.climb_attempts RENAME COLUMN board_route_id TO route_id;
+  END IF;
+END $$;
+
+ALTER INDEX IF EXISTS public.idx_climb_attempts_board_route_id RENAME TO idx_climb_attempts_route_id;
+CREATE INDEX IF NOT EXISTS idx_climb_attempts_route_id ON public.climb_attempts(route_id);
+
+-- Update prevent_social_parent_change() for route_id and new social models
+CREATE OR REPLACE FUNCTION public.prevent_social_parent_change()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+BEGIN
+  IF TG_TABLE_NAME = 'climbing_sessions'
+     AND NEW.user_id IS DISTINCT FROM OLD.user_id THEN
+    RAISE EXCEPTION 'session user_id is immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'climb_attempts'
+     AND (NEW.user_id IS DISTINCT FROM OLD.user_id
+       OR NEW.session_id IS DISTINCT FROM OLD.session_id) THEN
+    RAISE EXCEPTION 'attempt ownership and parent keys are immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'climb_attempts'
+     AND NEW.route_id IS DISTINCT FROM OLD.route_id
+     AND NOT (
+       OLD.route_id IS NOT NULL
+       AND NEW.route_id IS NULL
+       AND NOT EXISTS (
+         SELECT 1 FROM public.routes AS r WHERE r.id = OLD.route_id
+       )
+     ) THEN
+    RAISE EXCEPTION 'attempt route_id is immutable while the route exists' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'session_posts'
+     AND (
+       NEW.id IS DISTINCT FROM OLD.id
+       OR NEW.created_at IS DISTINCT FROM OLD.created_at
+       OR NEW.user_id IS DISTINCT FROM OLD.user_id
+       OR NEW.session_id IS DISTINCT FROM OLD.session_id
+       OR NEW.featured_attempt_id IS DISTINCT FROM OLD.featured_attempt_id
+     ) THEN
+    RAISE EXCEPTION 'post identity, cursor fields, ownership, session_id, and featured_attempt_id are immutable'
+      USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'session_post_likes'
+     AND (NEW.post_id IS DISTINCT FROM OLD.post_id
+       OR NEW.user_id IS DISTINCT FROM OLD.user_id) THEN
+    RAISE EXCEPTION 'like parent and owner are immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'session_post_comments'
+     AND (NEW.post_id IS DISTINCT FROM OLD.post_id
+       OR NEW.user_id IS DISTINCT FROM OLD.user_id) THEN
+    RAISE EXCEPTION 'comment parent and owner are immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'venues'
+     AND NEW.user_id IS DISTINCT FROM OLD.user_id THEN
+    RAISE EXCEPTION 'venue user_id is immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'follows'
+     AND (NEW.follower_id IS DISTINCT FROM OLD.follower_id
+       OR NEW.following_id IS DISTINCT FROM OLD.following_id) THEN
+    RAISE EXCEPTION 'follow keys are immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'route_bookmarks'
+     AND (NEW.user_id IS DISTINCT FROM OLD.user_id
+       OR NEW.route_id IS DISTINCT FROM OLD.route_id) THEN
+    RAISE EXCEPTION 'bookmark keys are immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'meetups'
+     AND NEW.organizer_id IS DISTINCT FROM OLD.organizer_id THEN
+    RAISE EXCEPTION 'meetup organizer_id is immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'meetup_attendees'
+     AND (NEW.meetup_id IS DISTINCT FROM OLD.meetup_id
+       OR NEW.user_id IS DISTINCT FROM OLD.user_id) THEN
+    RAISE EXCEPTION 'attendance parent and owner are immutable' USING ERRCODE = '42501';
+  ELSIF TG_TABLE_NAME = 'meetup_comments'
+     AND (NEW.meetup_id IS DISTINCT FROM OLD.meetup_id
+       OR NEW.user_id IS DISTINCT FROM OLD.user_id) THEN
+    RAISE EXCEPTION 'meetup comment parent and owner are immutable' USING ERRCODE = '42501';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_venues_prevent_parent_change ON public.venues;
+CREATE TRIGGER trg_venues_prevent_parent_change
+  BEFORE UPDATE ON public.venues
+  FOR EACH ROW
+  EXECUTE FUNCTION public.prevent_social_parent_change();
+
+-- ============================================================================
+-- 5. FOLLOWS TABLE (SOCIAL GRAPH)
+-- ============================================================================
+CREATE TABLE IF NOT EXISTS public.follows (
+  follower_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
+  following_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+  PRIMARY KEY (follower_id, following_id),
+  CONSTRAINT follows_no_self_follow CHECK (follower_id <> following_id)
+);
+
+CREATE INDEX IF NOT EXISTS idx_follows_following_id ON public.follows(following_id);
+CREATE INDEX IF NOT EXISTS idx_follows_follower_id ON public.follows(follower_id);
+
+ALTER TABLE public.follows ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY "follows_select_public" ON public.follows
+  FOR SELECT TO anon, authenticated
+  USING (true);
+
+CREATE POLICY "follows_insert_owner" ON public.follows
+  FOR INSERT TO authenticated
+  WITH CHECK (auth.uid() = follower_id);
+
+CREATE POLICY "follows_delete_owner" ON public.follows
+  FOR DELETE TO authenticated
+  USING (auth.uid() = follower_id OR public.is_moderator());
+
+GRANT SELECT ON TABLE public.follows TO anon, authenticated;
+GRANT INSERT, DELETE ON TABLE public.follows TO authenticated;
+
+DROP TRIGGER IF EXISTS trg_follows_prevent_parent_change ON public.follows;
+CREATE TRIGGER trg_follows_prevent_parent_change
+  BEFORE UPDATE ON public.follows
+  FOR EACH ROW
+  EXECUTE FUNCTION public.prevent_social_parent_change();
+
+-- ============================================================================
+-- 6. ROUTE BOOKMARKS (OWNER-ONLY SAVED ROUTES)
+-- ============================================================================
+CREATE TABLE IF NOT EXISTS public.route_bookmarks (
+  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
+  route_id UUID NOT NULL REFERENCES public.routes(id) ON DELETE CASCADE,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+  PRIMARY KEY (user_id, route_id)
+);
+
+CREATE INDEX IF NOT EXISTS idx_route_bookmarks_route_id ON public.route_bookmarks(route_id);
+CREATE INDEX IF NOT EXISTS idx_route_bookmarks_user_id ON public.route_bookmarks(user_id);
+
+ALTER TABLE public.route_bookmarks ENABLE ROW LEVEL SECURITY;
+
+-- Owner-only read: only accessible routes (with accessible wall & venue) may be observed
+CREATE POLICY "route_bookmarks_select_owner" ON public.route_bookmarks
+  FOR SELECT TO authenticated
+  USING (
+    auth.uid() = user_id
+    AND public.is_route_accessible(route_id)
+  );
+
+-- Owner-only write: only accessible routes (with accessible wall & venue) may be bookmarked
+CREATE POLICY "route_bookmarks_insert_owner" ON public.route_bookmarks
+  FOR INSERT TO authenticated
+  WITH CHECK (
+    auth.uid() = user_id
+    AND public.is_route_accessible(route_id)
+  );
+
+CREATE POLICY "route_bookmarks_delete_owner" ON public.route_bookmarks
+  FOR DELETE TO authenticated
+  USING (auth.uid() = user_id);
+
+GRANT SELECT, INSERT, DELETE ON TABLE public.route_bookmarks TO authenticated;
+
+DROP TRIGGER IF EXISTS trg_route_bookmarks_prevent_parent_change ON public.route_bookmarks;
+CREATE TRIGGER trg_route_bookmarks_prevent_parent_change
+  BEFORE UPDATE ON public.route_bookmarks
+  FOR EACH ROW
+  EXECUTE FUNCTION public.prevent_social_parent_change();
+
+-- ============================================================================
+-- 7. ACTIVITY EVENTS (COMMUNITY NOTIFICATIONS INBOX)
+-- ============================================================================
+CREATE TABLE IF NOT EXISTS public.activity_events (
+  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
+  recipient_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
+  actor_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
+  kind TEXT NOT NULL CHECK (kind IN ('like', 'comment', 'follow', 'crew_send')),
+  post_id UUID REFERENCES public.session_posts(id) ON DELETE CASCADE,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
+  read_at TIMESTAMPTZ CHECK (read_at IS NULL OR read_at <= now()),
+  CONSTRAINT activity_events_no_self_notification CHECK (recipient_id <> actor_id)
+);
+
+-- Deduplication indexes for transitions
+CREATE UNIQUE INDEX IF NOT EXISTS idx_activity_events_like_uniq
+  ON public.activity_events(recipient_id, actor_id, kind, post_id)
+  WHERE kind = 'like';
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_activity_events_follow_uniq
+  ON public.activity_events(recipient_id, actor_id, kind)
+  WHERE kind = 'follow';
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_activity_events_crew_send_uniq
+  ON public.activity_events(recipient_id, actor_id, kind, post_id)
+  WHERE kind = 'crew_send';
+
+CREATE INDEX IF NOT EXISTS idx_activity_events_recipient_cursor
+  ON public.activity_events(recipient_id, created_at DESC, id DESC);
+
+CREATE INDEX IF NOT EXISTS idx_activity_events_recipient_unread
+  ON public.activity_events(recipient_id)
+  WHERE read_at IS NULL;
+
+ALTER TABLE public.activity_events ENABLE ROW LEVEL SECURITY;
+
+-- Recipient-only read
+CREATE POLICY "activity_events_select_recipient" ON public.activity_events
+  FOR SELECT TO authenticated
+  USING (auth.uid() = recipient_id);
+
+-- Recipient-only mark-read (UPDATE)
+CREATE POLICY "activity_events_update_recipient" ON public.activity_events
+  FOR UPDATE TO authenticated
+  USING (auth.uid() = recipient_id)
+  WITH CHECK (auth.uid() = recipient_id);
+
+-- Recipient-only delete
+CREATE POLICY "activity_events_delete_recipient" ON public.activity_events
+  FOR DELETE TO authenticated
+  USING (auth.uid() = recipient_id OR public.is_moderator());
+
+GRANT SELECT, UPDATE, DELETE ON TABLE public.activity_events TO authenticated;
+
+-- Prevent client tampering of immutable activity event attributes
+CREATE OR REPLACE FUNCTION public.prevent_activity_event_tampering()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+BEGIN
+  IF NEW.id IS DISTINCT FROM OLD.id
+     OR NEW.recipient_id IS DISTINCT FROM OLD.recipient_id
+     OR NEW.actor_id IS DISTINCT FROM OLD.actor_id
+     OR NEW.kind IS DISTINCT FROM OLD.kind
+     OR NEW.post_id IS DISTINCT FROM OLD.post_id
+     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
+    RAISE EXCEPTION 'activity event fields are immutable; only read_at can be updated' USING ERRCODE = '42501';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_prevent_activity_event_tampering ON public.activity_events;
+CREATE TRIGGER trg_prevent_activity_event_tampering
+  BEFORE UPDATE ON public.activity_events
+  FOR EACH ROW
+  EXECUTE FUNCTION public.prevent_activity_event_tampering();
+
+-- Event Triggers: like, comment, follow, and crew_send transitions
+CREATE OR REPLACE FUNCTION public.handle_session_post_like_activity()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  p_author UUID;
+BEGIN
+  IF TG_OP = 'INSERT' THEN
+    SELECT user_id INTO p_author FROM public.session_posts WHERE id = NEW.post_id;
+    IF p_author IS NOT NULL AND p_author <> NEW.user_id THEN
+      INSERT INTO public.activity_events (recipient_id, actor_id, kind, post_id, created_at)
+      VALUES (p_author, NEW.user_id, 'like', NEW.post_id, NEW.created_at)
+      ON CONFLICT DO NOTHING;
+    END IF;
+    RETURN NEW;
+  ELSIF TG_OP = 'DELETE' THEN
+    DELETE FROM public.activity_events
+     WHERE kind = 'like' AND actor_id = OLD.user_id AND post_id = OLD.post_id;
+    RETURN OLD;
+  END IF;
+  RETURN NULL;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_session_post_like_activity ON public.session_post_likes;
+CREATE TRIGGER trg_session_post_like_activity
+  AFTER INSERT OR DELETE ON public.session_post_likes
+  FOR EACH ROW
+  EXECUTE FUNCTION public.handle_session_post_like_activity();
+
+CREATE OR REPLACE FUNCTION public.handle_session_post_comment_activity()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+DECLARE
+  p_author UUID;
+BEGIN
+  IF TG_OP = 'INSERT' THEN
+    SELECT user_id INTO p_author FROM public.session_posts WHERE id = NEW.post_id;
+    IF p_author IS NOT NULL AND p_author <> NEW.user_id THEN
+      INSERT INTO public.activity_events (recipient_id, actor_id, kind, post_id, created_at)
+      VALUES (p_author, NEW.user_id, 'comment', NEW.post_id, NEW.created_at);
+    END IF;
+    RETURN NEW;
+  ELSIF TG_OP = 'DELETE' THEN
+    IF NOT EXISTS (
+      SELECT 1 FROM public.session_post_comments
+       WHERE post_id = OLD.post_id AND user_id = OLD.user_id AND id <> OLD.id
+    ) THEN
+      DELETE FROM public.activity_events
+       WHERE kind = 'comment' AND actor_id = OLD.user_id AND post_id = OLD.post_id;
+    END IF;
+    RETURN OLD;
+  END IF;
+  RETURN NULL;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_session_post_comment_activity ON public.session_post_comments;
+CREATE TRIGGER trg_session_post_comment_activity
+  AFTER INSERT OR DELETE ON public.session_post_comments
+  FOR EACH ROW
+  EXECUTE FUNCTION public.handle_session_post_comment_activity();
+
+CREATE OR REPLACE FUNCTION public.handle_follow_activity()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+BEGIN
+  IF TG_OP = 'INSERT' THEN
+    IF NEW.following_id <> NEW.follower_id THEN
+      INSERT INTO public.activity_events (recipient_id, actor_id, kind, post_id, created_at)
+      VALUES (NEW.following_id, NEW.follower_id, 'follow', NULL, NEW.created_at)
+      ON CONFLICT DO NOTHING;
+    END IF;
+    RETURN NEW;
+  ELSIF TG_OP = 'DELETE' THEN
+    DELETE FROM public.activity_events
+     WHERE kind = 'follow' AND actor_id = OLD.follower_id AND recipient_id = OLD.following_id;
+    RETURN OLD;
+  END IF;
+  RETURN NULL;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_follow_activity ON public.follows;
+CREATE TRIGGER trg_follow_activity
+  AFTER INSERT OR DELETE ON public.follows
+  FOR EACH ROW
+  EXECUTE FUNCTION public.handle_follow_activity();
+
+CREATE OR REPLACE FUNCTION public.handle_session_post_crew_send_activity()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+BEGIN
+  IF TG_OP = 'INSERT' THEN
+    INSERT INTO public.activity_events (recipient_id, actor_id, kind, post_id, created_at)
+    SELECT f.follower_id, NEW.user_id, 'crew_send', NEW.id, NEW.created_at
+      FROM public.follows f
+     WHERE f.following_id = NEW.user_id
+       AND f.follower_id <> NEW.user_id
+    ON CONFLICT DO NOTHING;
+    RETURN NEW;
+  END IF;
+  RETURN NULL;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_session_post_crew_send_activity ON public.session_posts;
+CREATE TRIGGER trg_session_post_crew_send_activity
+  AFTER INSERT ON public.session_posts
+  FOR EACH ROW
+  EXECUTE FUNCTION public.handle_session_post_crew_send_activity();
+
+-- ============================================================================
+-- 8. RPC: get_session_feed (REPLACES OLD SIGNATURE WITHOUT OVERLOAD)
+-- ============================================================================
+DROP FUNCTION IF EXISTS public.get_session_feed(timestamptz, uuid, uuid, integer);
+
+CREATE OR REPLACE FUNCTION public.get_session_feed(
+  before_created_at TIMESTAMPTZ DEFAULT NULL,
+  before_id UUID DEFAULT NULL,
+  author_filter UUID DEFAULT NULL,
+  page_size INTEGER DEFAULT 20,
+  following_only BOOLEAN DEFAULT false,
+  post_filter UUID DEFAULT NULL
+)
+RETURNS SETOF JSONB
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT jsonb_build_object(
+    'id', sp.id,
+    'user_id', sp.user_id,
+    'session_id', sp.session_id,
+    'featured_attempt_id', sp.featured_attempt_id,
+    'caption', sp.caption,
+    'image_path', sp.image_path,
+    'image_alt', sp.image_alt,
+    'overlay_style', sp.overlay_style,
+    'created_at', sp.created_at,
+    'updated_at', sp.updated_at,
+    'author', jsonb_build_object(
+      'id', p.id,
+      'username', p.username,
+      'full_name', p.full_name,
+      'avatar_url', p.avatar_url,
+      'bio', p.bio,
+      'home_area', p.home_area,
+      'is_followed', EXISTS (
+        SELECT 1 FROM public.follows f
+         WHERE f.follower_id = auth.uid() AND f.following_id = p.id
+      )
+    ),
+    'session', jsonb_build_object(
+      'id', cs.id,
+      'venue_name', cs.venue_name,
+      'started_at', cs.started_at,
+      'ended_at', cs.ended_at,
+      'duration_seconds', ROUND(EXTRACT(EPOCH FROM (cs.ended_at - cs.started_at)))::INTEGER,
+      'attempt_count', (SELECT count(*)::INTEGER FROM public.climb_attempts AS ca_all WHERE ca_all.session_id = cs.id),
+      'send_count', (SELECT count(*)::INTEGER FROM public.climb_attempts AS ca_sends WHERE ca_sends.session_id = cs.id AND ca_sends.outcome = 'sent'),
+      'featured_attempt', jsonb_build_object(
+        'id', ca.id,
+        'route_id', CASE
+          WHEN ca.route_id IS NOT NULL AND (r.id IS NOT NULL) THEN ca.route_id
+          ELSE NULL
+        END,
+        'route_name', ca.route_name,
+        'discipline', ca.discipline,
+        'grade_system', ca.grade_system,
+        'grade_label', ca.grade_label,
+        'outcome', ca.outcome,
+        'attempt_number', ca.attempt_number,
+        'occurred_at', ca.occurred_at
+      ),
+      'attempt_timeline', CASE
+        WHEN sp.overlay_style = 'attempt_timeline' THEN (
+          SELECT timeline.timeline
+            FROM public.session_post_attempt_timeline_snapshots AS timeline
+           WHERE timeline.post_id = sp.id
+        )
+        ELSE NULL
+      END
+    ),
+    'route', CASE
+      WHEN ca.route_id IS NOT NULL AND (r.id IS NOT NULL) THEN
+        jsonb_build_object(
+          'id', r.id,
+          'name', r.name,
+          'description', r.description,
+          'discipline', r.discipline,
+          'grade_system', r.grade_system,
+          'grade_label', r.grade_label,
+          'height_m', r.height_m,
+          'rock_type', r.rock_type,
+          'terrain', r.terrain,
+          'image_url', CASE
+            WHEN r.wall_id IS NOT NULL AND public.is_wall_accessible(r.wall_id) THEN COALESCE(
+              r.wall_image_url,
+              (SELECT w.image_url FROM public.walls w WHERE w.id::text = r.wall_id)
+            )
+            WHEN r.wall_id IS NULL THEN r.wall_image_url
+            ELSE NULL
+          END,
+          'holds', r.holds,
+          'venue', CASE
+            WHEN v.id IS NOT NULL THEN jsonb_build_object(
+              'id', v.id,
+              'name', v.name,
+              'kind', v.kind,
+              'area', v.area,
+              'description', v.description,
+              'image_url', v.image_url
+            )
+            ELSE NULL
+          END,
+          'author_id', r.user_id,
+          'is_saved', EXISTS (
+            SELECT 1 FROM public.route_bookmarks rb
+             WHERE rb.route_id = r.id AND rb.user_id = auth.uid()
+          ),
+          'created_at', r.created_at
+        )
+      ELSE NULL
+    END,
+    'like_count', (SELECT count(*)::INTEGER FROM public.session_post_likes AS spl WHERE spl.post_id = sp.id),
+    'comment_count', (SELECT count(*)::INTEGER FROM public.session_post_comments AS spc WHERE spc.post_id = sp.id),
+    'is_liked', EXISTS (
+      SELECT 1 FROM public.session_post_likes AS spl
+       WHERE spl.post_id = sp.id AND spl.user_id = auth.uid()
+    )
+  )
+  FROM public.session_posts AS sp
+  JOIN public.climbing_sessions AS cs ON cs.id = sp.session_id
+  JOIN public.climb_attempts AS ca ON ca.id = sp.featured_attempt_id
+  JOIN public.profiles AS p ON p.id = sp.user_id
+  LEFT JOIN public.routes AS r ON r.id = ca.route_id
+    AND (r.is_public = true OR r.user_id = auth.uid() OR public.is_moderator())
+    AND public.is_wall_accessible(r.wall_id)
+    AND public.is_venue_accessible(r.venue_id)
+  LEFT JOIN public.venues AS v ON v.id = r.venue_id
+    AND (v.is_public = true OR v.user_id = auth.uid() OR public.is_moderator())
+  WHERE (author_filter IS NULL OR sp.user_id = author_filter)
+    AND (post_filter IS NULL OR sp.id = post_filter)
+    AND (
+      NOT following_only
+      OR EXISTS (
+        SELECT 1 FROM public.follows f
+         WHERE f.follower_id = auth.uid() AND f.following_id = sp.user_id
+      )
+    )
+    AND (
+      (before_created_at IS NULL AND before_id IS NULL)
+      OR (
+        before_created_at IS NOT NULL
+        AND before_id IS NOT NULL
+        AND (sp.created_at, sp.id) < (before_created_at, before_id)
+      )
+    )
+  ORDER BY sp.created_at DESC, sp.id DESC
+  LIMIT LEAST(GREATEST(COALESCE(page_size, 20), 1), 50);
+$$;
+
+REVOKE ALL ON FUNCTION public.get_session_feed(timestamptz, uuid, uuid, integer, boolean, uuid) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.get_session_feed(timestamptz, uuid, uuid, integer, boolean, uuid) TO anon, authenticated;
+
+-- ============================================================================
+-- 9. RPC: get_explore_routes
+-- ============================================================================
+CREATE OR REPLACE FUNCTION public.get_explore_routes(
+  search_text TEXT DEFAULT '',
+  venue_filter UUID DEFAULT NULL,
+  saved_only BOOLEAN DEFAULT false,
+  before_created_at TIMESTAMPTZ DEFAULT NULL,
+  before_id UUID DEFAULT NULL,
+  page_size INTEGER DEFAULT 30
+)
+RETURNS SETOF JSONB
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT jsonb_build_object(
+    'id', r.id,
+    'name', r.name,
+    'description', r.description,
+    'discipline', r.discipline,
+    'grade_system', r.grade_system,
+    'grade_label', r.grade_label,
+    'height_m', r.height_m,
+    'rock_type', r.rock_type,
+    'terrain', r.terrain,
+    'image_url', CASE
+      WHEN r.wall_id IS NOT NULL AND public.is_wall_accessible(r.wall_id) THEN COALESCE(
+        r.wall_image_url,
+        (SELECT w.image_url FROM public.walls w WHERE w.id::text = r.wall_id)
+      )
+      WHEN r.wall_id IS NULL THEN r.wall_image_url
+      ELSE NULL
+    END,
+    'holds', r.holds,
+    'venue', CASE
+      WHEN v.id IS NOT NULL THEN jsonb_build_object(
+        'id', v.id,
+        'name', v.name,
+        'kind', v.kind,
+        'area', v.area,
+        'description', v.description,
+        'image_url', v.image_url
+      )
+      ELSE NULL
+    END,
+    'author_id', r.user_id,
+    'is_saved', EXISTS (
+      SELECT 1 FROM public.route_bookmarks rb
+       WHERE rb.route_id = r.id AND rb.user_id = auth.uid()
+    ),
+    'created_at', r.created_at
+  )
+  FROM public.routes r
+  LEFT JOIN public.venues v ON v.id = r.venue_id
+    AND (v.is_public = true OR v.user_id = auth.uid() OR public.is_moderator())
+  WHERE (r.is_public = true OR r.user_id = auth.uid() OR public.is_moderator())
+    AND public.is_wall_accessible(r.wall_id)
+    AND public.is_venue_accessible(r.venue_id)
+    AND (venue_filter IS NULL OR r.venue_id = venue_filter)
+    AND (
+      NOT saved_only OR EXISTS (
+        SELECT 1 FROM public.route_bookmarks rb
+         WHERE rb.route_id = r.id AND rb.user_id = auth.uid()
+      )
+    )
+    AND (
+      search_text IS NULL OR trim(search_text) = ''
+      OR r.name ILIKE '%' || trim(search_text) || '%'
+      OR (r.description IS NOT NULL AND r.description ILIKE '%' || trim(search_text) || '%')
+      OR (v.name IS NOT NULL AND v.name ILIKE '%' || trim(search_text) || '%')
+    )
+    AND (
+      (before_created_at IS NULL AND before_id IS NULL)
+      OR (
+        before_created_at IS NOT NULL
+        AND before_id IS NOT NULL
+        AND (r.created_at, r.id) < (before_created_at, before_id)
+      )
+    )
+  ORDER BY r.created_at DESC, r.id DESC
+  LIMIT LEAST(GREATEST(COALESCE(page_size, 30), 1), 100);
+$$;
+
+REVOKE ALL ON FUNCTION public.get_explore_routes(text, uuid, boolean, timestamptz, uuid, integer) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.get_explore_routes(text, uuid, boolean, timestamptz, uuid, integer) TO anon, authenticated;
+
+-- ============================================================================
+-- 10. RPC: search_climbers
+-- ============================================================================
+CREATE OR REPLACE FUNCTION public.search_climbers(
+  search_text TEXT DEFAULT '',
+  page_size INTEGER DEFAULT 30
+)
+RETURNS SETOF JSONB
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT jsonb_build_object(
+    'id', p.id,
+    'username', p.username,
+    'full_name', p.full_name,
+    'avatar_url', p.avatar_url,
+    'bio', p.bio,
+    'home_area', p.home_area,
+    'is_followed', EXISTS (
+      SELECT 1 FROM public.follows f
+       WHERE f.follower_id = auth.uid() AND f.following_id = p.id
+    ),
+    'follower_count', (
+      SELECT count(*)::INTEGER FROM public.follows f
+       WHERE f.following_id = p.id
+    ),
+    'following_count', (
+      SELECT count(*)::INTEGER FROM public.follows f
+       WHERE f.follower_id = p.id
+    )
+  )
+  FROM public.profiles p
+  WHERE (
+    search_text IS NULL OR trim(search_text) = ''
+    OR p.username ILIKE '%' || trim(search_text) || '%'
+    OR (p.full_name IS NOT NULL AND p.full_name ILIKE '%' || trim(search_text) || '%')
+    OR (p.home_area IS NOT NULL AND p.home_area ILIKE '%' || trim(search_text) || '%')
+  )
+  ORDER BY p.username ASC
+  LIMIT LEAST(GREATEST(COALESCE(page_size, 30), 1), 100);
+$$;
+
+REVOKE ALL ON FUNCTION public.search_climbers(text, integer) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.search_climbers(text, integer) TO anon, authenticated;
+
+-- ============================================================================
+-- 11. RPC: get_activity
+-- ============================================================================
+CREATE OR REPLACE FUNCTION public.get_activity(
+  before_created_at TIMESTAMPTZ DEFAULT NULL,
+  before_id UUID DEFAULT NULL,
+  page_size INTEGER DEFAULT 30
+)
+RETURNS SETOF JSONB
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public, pg_temp
+AS $$
+  SELECT jsonb_build_object(
+    'id', ae.id,
+    'kind', ae.kind,
+    'actor', jsonb_build_object(
+      'id', p.id,
+      'username', p.username,
+      'full_name', p.full_name,
+      'avatar_url', p.avatar_url,
+      'home_area', p.home_area
+    ),
+    'post_id', ae.post_id,
+    'created_at', ae.created_at,
+    'read_at', ae.read_at
+  )
+  FROM public.activity_events ae
+  JOIN public.profiles p ON p.id = ae.actor_id
+  WHERE ae.recipient_id = auth.uid()
+    AND (
+      (before_created_at IS NULL AND before_id IS NULL)
+      OR (
+        before_created_at IS NOT NULL
+        AND before_id IS NOT NULL
+        AND (ae.created_at, ae.id) < (before_created_at, before_id)
+      )
+    )
+  ORDER BY ae.created_at DESC, ae.id DESC
+  LIMIT LEAST(GREATEST(COALESCE(page_size, 30), 1), 100);
+$$;
+
+REVOKE ALL ON FUNCTION public.get_activity(timestamptz, uuid, integer) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION public.get_activity(timestamptz, uuid, integer) TO authenticated;
diff --git a/supabase/tests/migration_014_verification.sql b/supabase/tests/migration_014_verification.sql
new file mode 100644
index 0000000000000000000000000000000000000000..7e9a9f3cc58fe8488f056dc7006d9b889b735a24
--- /dev/null
+++ b/supabase/tests/migration_014_verification.sql
@@ -0,0 +1,262 @@
+-- migration_014_verification.sql
+-- Standalone SQL verification script for Migration 014 schema, RLS policies,
+-- immutability triggers, activity event generation, and community RPCs.
+-- Executable in standard PostgreSQL / psql without requiring GoTrue or PostgREST.
+-- Runs completely inside a transaction and rolls back at the end.
+
+BEGIN;
+
+-- Setup test users in auth.users and public.profiles
+DO $$
+DECLARE
+  v_user1 UUID := '11111111-1111-4111-8111-111111111111';
+  v_user2 UUID := '22222222-2222-4222-8222-222222222222';
+  v_venue_pub UUID := '33333333-3333-4333-8333-333333333333';
+  v_venue_priv UUID := '44444444-4444-4444-8444-444444444444';
+  v_route_pub UUID := '55555555-5555-4555-8555-555555555555';
+  v_route_priv UUID := '66666666-6666-4666-8666-666666666666';
+  v_session UUID := '77777777-7777-4777-8777-777777777777';
+  v_attempt UUID := '88888888-8888-4888-8888-888888888888';
+  v_wall_priv UUID := 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
+  v_route_pub_priv_wall UUID := 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb';
+  v_session_priv_wall UUID := 'cccccccc-cccc-4ccc-8ccc-cccccccccccc';
+  v_attempt_priv_wall UUID := 'dddddddd-dddd-4ddd-8ddd-dddddddddddd';
+  v_post_priv_wall UUID := 'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee';
+  v_post UUID := '99999999-9999-4999-8999-999999999999';
+  v_feed_row JSONB;
+  v_explore_row JSONB;
+  v_climber_row JSONB;
+  v_activity_row JSONB;
+  v_count INT;
+BEGIN
+  -- 1. Create auth users and profiles
+  INSERT INTO auth.users (id, email)
+  VALUES (v_user1, 'test-user1@example.com'),
+         (v_user2, 'test-user2@example.com')
+  ON CONFLICT (id) DO NOTHING;
+
+  INSERT INTO public.profiles (id, username, full_name, home_area)
+  VALUES (v_user1, 'climber_one', 'Climber One', 'Boulder'),
+         (v_user2, 'climber_two', 'Climber Two', 'Golden')
+  ON CONFLICT (id) DO UPDATE
+    SET username = EXCLUDED.username, full_name = EXCLUDED.full_name, home_area = EXCLUDED.home_area;
+
+  -- 2. Test Venues Creation and RLS
+  INSERT INTO public.venues (id, user_id, name, kind, area, description, is_public)
+  VALUES (v_venue_pub, v_user1, 'Public Crag', 'crag', 'Boulder Canyon', 'Granite crag', true),
+         (v_venue_priv, v_user2, 'Secret Crag', 'crag', 'Hidden', 'Private spot', false);
+
+  -- 3. Test Routes Extension (nullable wall_id, venue_id, discipline, metadata)
+  INSERT INTO public.routes (id, user_id, wall_id, name, venue_id, discipline, grade_system, grade_label, height_m, rock_type, terrain, is_public)
+  VALUES (v_route_pub, v_user1, NULL, 'Redpoint Ridge', v_venue_pub, 'sport', 'yds', '5.12a', 27.0, 'Limestone', 'overhang', true),
+         (v_route_priv, v_user2, NULL, 'Hidden Project', v_venue_priv, 'boulder', 'v_scale', 'V10', 4.0, 'Granite', 'roof', false);
+
+  -- 4. Test Sessions conditions & notes and Attempts route_id cutover
+  INSERT INTO public.climbing_sessions (id, user_id, venue_name, conditions, notes, started_at, ended_at)
+  VALUES (v_session, v_user1, 'Public Crag', 'Clear, 65F', 'Sent project first go', now() - interval '2 hours', now());
+
+  -- Create private wall owned by user2 and public route on it
+  INSERT INTO public.walls (id, user_id, name, description, image_url, is_public)
+  VALUES (v_wall_priv, v_user2, 'Secret Wall', 'Private', 'https://secret.example.com/wall.jpg', false);
+
+  INSERT INTO public.routes (id, user_id, wall_id, name, is_public)
+  VALUES (v_route_pub_priv_wall, v_user2, v_wall_priv::text, 'Public Route on Secret Wall', true);
+
+  INSERT INTO public.climbing_sessions (id, user_id, venue_name, started_at, ended_at)
+  VALUES (v_session_priv_wall, v_user2, 'Secret Wall', now() - interval '1 hour', now());
+
+  INSERT INTO public.climb_attempts (id, session_id, user_id, route_id, route_name, discipline, grade_system, grade_label, outcome, attempt_number, occurred_at)
+  VALUES (v_attempt_priv_wall, v_session_priv_wall, v_user2, v_route_pub_priv_wall, 'Attempt on Secret Wall', 'board', 'v_scale', 'V4', 'sent', 1, now());
+
+  INSERT INTO public.session_posts (id, user_id, session_id, featured_attempt_id, caption, image_path, image_alt, overlay_style)
+  VALUES (v_post_priv_wall, v_user2, v_session_priv_wall, v_attempt_priv_wall, 'Secret wall post', v_user2 || '/' || v_post_priv_wall || '.jpg', 'alt', 'stats');
+  INSERT INTO public.climb_attempts (id, session_id, user_id, route_id, route_name, discipline, grade_system, grade_label, outcome, attempt_number, occurred_at)
+  VALUES (v_attempt, v_session, v_user1, v_route_pub, 'Redpoint Ridge', 'sport', 'yds', '5.12a', 'sent', 1, now() - interval '1 hour');
+
+  -- Verify route_id immutability trigger
+  BEGIN
+    UPDATE public.climb_attempts SET route_id = v_route_priv WHERE id = v_attempt;
+    RAISE EXCEPTION 'FAILED: attempt route_id mutation was not blocked';
+  EXCEPTION WHEN SQLSTATE '42501' THEN
+    -- Expected 42501 error
+    NULL;
+  END;
+
+  -- 5. Test Session Post and Timeline
+  INSERT INTO public.session_posts (id, user_id, session_id, featured_attempt_id, caption, image_path, image_alt, overlay_style)
+  VALUES (v_post, v_user1, v_session, v_attempt, 'Great day out', v_user1 || '/' || v_post || '.jpg', 'Climbing Redpoint Ridge', 'stats');
+
+  -- 6. Test Follows and Activity Trigger
+  INSERT INTO public.follows (follower_id, following_id)
+  VALUES (v_user2, v_user1);
+
+  -- Verify self-follow check constraint
+  BEGIN
+    INSERT INTO public.follows (follower_id, following_id) VALUES (v_user1, v_user1);
+    RAISE EXCEPTION 'FAILED: self-follow was not blocked by check constraint';
+  EXCEPTION WHEN check_violation THEN
+    -- Expected check violation
+    NULL;
+  END;
+
+  -- Verify follow activity event was created for following_id (v_user1)
+  SELECT count(*) INTO v_count
+    FROM public.activity_events
+   WHERE recipient_id = v_user1 AND actor_id = v_user2 AND kind = 'follow';
+  IF v_count <> 1 THEN
+    RAISE EXCEPTION 'FAILED: follow activity event was not generated by trigger (count = %)', v_count;
+  END IF;
+
+  -- 7. Test Likes and Activity Trigger
+  INSERT INTO public.session_post_likes (post_id, user_id)
+  VALUES (v_post, v_user2);
+
+  SELECT count(*) INTO v_count
+    FROM public.activity_events
+   WHERE recipient_id = v_user1 AND actor_id = v_user2 AND kind = 'like' AND post_id = v_post;
+  IF v_count <> 1 THEN
+    RAISE EXCEPTION 'FAILED: like activity event was not generated by trigger (count = %)', v_count;
+  END IF;
+
+  -- Unlike removes activity event
+  DELETE FROM public.session_post_likes WHERE post_id = v_post AND user_id = v_user2;
+  SELECT count(*) INTO v_count
+    FROM public.activity_events
+   WHERE recipient_id = v_user1 AND actor_id = v_user2 AND kind = 'like' AND post_id = v_post;
+  IF v_count <> 0 THEN
+    RAISE EXCEPTION 'FAILED: like activity event was not removed on unlike (count = %)', v_count;
+  END IF;
+
+  -- 8. Test Route Bookmarks
+  INSERT INTO public.route_bookmarks (user_id, route_id)
+  VALUES (v_user2, v_route_pub);
+
+  -- 9. Test RPC get_session_feed
+  -- Caller as v_user2 (follows v_user1)
+  PERFORM set_config('request.jwt.claim.sub', v_user2::text, true);
+
+  SELECT row_to_json(f)::jsonb INTO v_feed_row
+    FROM public.get_session_feed(page_size => 1) f
+   LIMIT 1;
+
+  IF v_feed_row IS NULL THEN
+    RAISE EXCEPTION 'FAILED: get_session_feed returned no rows';
+  END IF;
+
+  IF (v_feed_row->'author'->>'is_followed')::boolean IS NOT TRUE THEN
+    RAISE EXCEPTION 'FAILED: get_session_feed did not report author.is_followed = true';
+  END IF;
+
+  IF v_feed_row->'route' IS NULL OR (v_feed_row->'route'->>'id')::uuid <> v_route_pub THEN
+    RAISE EXCEPTION 'FAILED: get_session_feed did not include top-level CommunityRoute object';
+  END IF;
+
+  IF (v_feed_row->'session'->'featured_attempt'->>'route_id')::uuid <> v_route_pub THEN
+    RAISE EXCEPTION 'FAILED: get_session_feed did not include featured_attempt.route_id';
+  END IF;
+
+  -- Verify conditions and notes are NOT leaked in feed session
+  IF v_feed_row->'session' ? 'conditions' OR v_feed_row->'session' ? 'notes' THEN
+    RAISE EXCEPTION 'FAILED: get_session_feed leaked private session conditions/notes';
+  END IF;
+
+  -- 10. Test RPC get_explore_routes
+  SELECT row_to_json(r)::jsonb INTO v_explore_row
+    FROM public.get_explore_routes(saved_only => true, page_size => 1) r
+   LIMIT 1;
+
