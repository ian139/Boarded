+  SELECT row_to_json(a)::jsonb INTO v_activity_row
+    FROM public.get_activity(page_size => 1) a
+   LIMIT 1;
+
+  IF v_activity_row IS NULL OR (v_activity_row->>'kind') <> 'follow' THEN
+    RAISE EXCEPTION 'FAILED: get_activity failed to return follow event';
+  END IF;
+
+  IF (v_activity_row->'actor'->>'username') <> 'climber_two' THEN
+    RAISE EXCEPTION 'FAILED: get_activity did not join actor profile';
+  END IF;
+  -- 13. Test Public Route on Private Wall (Parent Visibility Protection)
+  -- Caller as v_user1 (does NOT own v_wall_priv)
+  PERFORM set_config('request.jwt.claim.sub', v_user1::text, true);
