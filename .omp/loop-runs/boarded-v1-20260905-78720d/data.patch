+  IF public.is_wall_accessible(v_wall_priv::text) IS TRUE THEN
+    RAISE EXCEPTION 'FAILED: is_wall_accessible returned true for private wall to non-owner';
+  END IF;
+  IF public.is_wall_accessible(NULL) IS NOT TRUE THEN
+    RAISE EXCEPTION 'FAILED: is_wall_accessible returned false for NULL wall_id';
+  END IF;
+  IF public.is_route_accessible(v_route_pub_priv_wall) IS TRUE THEN
+    RAISE EXCEPTION 'FAILED: is_route_accessible returned true for public route on private wall to non-owner';
+  END IF;
+  IF public.is_route_accessible(v_route_pub) IS NOT TRUE THEN
+    RAISE EXCEPTION 'FAILED: is_route_accessible returned false for public accessible route';
+  END IF;
+
+
+  -- Explore routes must NOT return public route on private wall
+  SELECT count(*) INTO v_count
+    FROM public.get_explore_routes(page_size => 50) r
+   WHERE (r->>'id')::uuid = v_route_pub_priv_wall;
+  IF v_count <> 0 THEN
+    RAISE EXCEPTION 'FAILED: get_explore_routes leaked public route on private wall to non-owner';
