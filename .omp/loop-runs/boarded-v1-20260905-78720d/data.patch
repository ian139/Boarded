+    const rank = gradeRank(attempt.grade_label, attempt.grade_system);
+    if (rank < 0) continue;
+
+    const candidate: RankedGrade = {
+      system: attempt.grade_system,
+      label: attempt.grade_label,
+      rank,
+    };
+
+    if (!bestGrade) {
+      bestGrade = candidate;
+    } else if (candidate.rank > bestGrade.rank) {
+      bestGrade = candidate;
+    } else if (
+      candidate.rank === bestGrade.rank &&
+      candidate.label.localeCompare(bestGrade.label) > 0
+    ) {
+      bestGrade = candidate;
+    }
+  }
+
+  return {
+    sessionCount,
+    sendCount,
+    attemptCount,
+    sendRate,
+    bestGrade,
+  };
