+/**
+ * Session-derived profile statistics calculated from private sessions and
+ * attempts only. Matches native ProfileStatisticsCalculator logic.
+ */
+export const calculateProfileStatistics = (
+  sessions: readonly ClimbingSession[],
+  attempts: readonly ClimbAttempt[]
+): ProfileStatistics => {
+  const sessionCount = sessions.length;
+  const attemptCount = attempts.length;
+  const sentAttempts = attempts.filter((a) => a.outcome === 'sent');
+  const sendCount = sentAttempts.length;
+  const sendRate = attemptCount > 0 ? sendCount / attemptCount : null;
+
+  let bestGrade: RankedGrade | null = null;
+
