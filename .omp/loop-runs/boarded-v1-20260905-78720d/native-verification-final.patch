+    func testActivityIndependentSnapshotsDoNotDoubleDecrementOverlappingRead() async throws {
+        let actor = ActivityActor(id: userID, username: "climber", fullName: nil)
+        let eventA = ActivityEvent(
+            id: UUID(uuidString: "bbbbbbbb-1111-4bbb-8bbb-bbbbbbbbbbbb")!,
+            kind: .like, actor: actor, postId: nil,
+            createdAt: Date(timeIntervalSince1970: 200), readAt: nil
+        )
+        let eventB = ActivityEvent(
+            id: UUID(uuidString: "bbbbbbbb-2222-4bbb-8bbb-bbbbbbbbbbbb")!,
+            kind: .follow, actor: actor, postId: nil,
+            createdAt: Date(timeIntervalSince1970: 100), readAt: nil
+        )
+        let repository = IndependentActivitySnapshotRepository(events: [eventA, eventB])
+        let model = ActivityViewModel(repository: repository)
+        await model.load()
+        XCTAssertEqual(model.unreadCount, 2)
+
+        await repository.beginOverlap()
+        let refresh = Task { await model.load() }
+        await repository.eventsCaptured.waitForStart()
+        await model.markRead(eventID: eventA.id)
+        XCTAssertEqual(model.unreadCount, 1)
+        await repository.countAfterRead.release()
+        await refresh.value
+
+        XCTAssertEqual(model.unreadCount, 1, "The count snapshot already excludes A; B is still unread")
+        XCTAssertEqual(model.events.first(where: { $0.id == eventA.id })?.isRead, true)
+        XCTAssertEqual(model.events.first(where: { $0.id == eventB.id })?.isRead, false)
+        XCTAssertNil(model.errorMessage)
+    }
