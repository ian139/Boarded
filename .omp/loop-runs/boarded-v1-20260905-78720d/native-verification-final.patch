+/// Captures stale event rows before the read, but fetches the authoritative count after it.
+private actor IndependentActivitySnapshotRepository: CommunityRepository {
+    private let base: MockCommunityRepository
+    private var overlaps = false
+    let eventsCaptured = ReplayGate()
+    let countAfterRead = ReplayGate()
+
+    init(events: [ActivityEvent]) {
+        base = MockCommunityRepository(activityEvents: events)
+    }
+
+    func beginOverlap() { overlaps = true }
+
+    func fetchActivity(beforeCreatedAt: Date?, beforeID: UUID?, pageSize: Int) async throws -> [ActivityEvent] {
+        let snapshot = try await base.fetchActivity(beforeCreatedAt: beforeCreatedAt, beforeID: beforeID, pageSize: pageSize)
+        if overlaps {
+            await eventsCaptured.markStarted()
+        }
+        return snapshot
+    }
+
+    func fetchUnreadActivityCount() async throws -> Int {
+        if overlaps { await countAfterRead.waitForRelease() }
+        return try await base.fetchUnreadActivityCount()
+    }
+
+    func markActivityRead(eventID: UUID) async throws {
+        try await base.markActivityRead(eventID: eventID)
+    }
+
+    func markAllActivityRead() async throws {
+        try await base.markAllActivityRead()
+    }
+
+    func fetchExploreRoutes(searchText: String, venueFilter: UUID?, savedOnly: Bool, beforeCreatedAt: Date?, beforeID: UUID?, pageSize: Int) async throws -> [CommunityRoute] {
+        try await base.fetchExploreRoutes(searchText: searchText, venueFilter: venueFilter, savedOnly: savedOnly, beforeCreatedAt: beforeCreatedAt, beforeID: beforeID, pageSize: pageSize)
+    }
+
+    func fetchVenues(query: String?) async throws -> [CommunityVenue] {
+        try await base.fetchVenues(query: query)
+    }
+
+    func searchClimbers(query: String, pageSize: Int) async throws -> [CommunityClimber] {
+        try await base.searchClimbers(query: query, pageSize: pageSize)
+    }
+
+    func toggleBookmark(routeID: UUID) async throws -> Bool {
+        try await base.toggleBookmark(routeID: routeID)
+    }
+
+    func toggleFollow(climberID: UUID) async throws -> Bool {
+        try await base.toggleFollow(climberID: climberID)
+    }
+
+    func createVenue(name: String, kind: VenueKind, area: String?, description: String?) async throws -> CommunityVenue {
+        try await base.createVenue(name: name, kind: kind, area: area, description: description)
+    }
+
+    func createRoute(venueID: UUID?, name: String, discipline: ClimbDiscipline, gradeSystem: GradeSystem, gradeLabel: String?, heightM: Double?, rockType: String?, terrain: RouteTerrain?) async throws -> CommunityRoute {
+        try await base.createRoute(venueID: venueID, name: name, discipline: discipline, gradeSystem: gradeSystem, gradeLabel: gradeLabel, heightM: heightM, rockType: rockType, terrain: terrain)
+    }
+}
