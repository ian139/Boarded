+    private func reveal(_ element: XCUIElement, forInteraction: Bool = true, file: StaticString = #filePath, line: UInt = #line) {
+        for _ in 0..<12 {
+            let scroll = app.scrollViews.allElementsBoundByIndex.first(where: \.isHittable)
+            var visibleFrame = app.windows.firstMatch.frame
+            if let scroll { visibleFrame = visibleFrame.intersection(scroll.frame) }
+            let tabs = self.element("main-tabs")
+            if tabs.exists && tabs.isHittable {
+                visibleFrame.size.height = max(0, min(visibleFrame.maxY, tabs.frame.minY) - visibleFrame.minY)
+            }
+            for bar in app.navigationBars.allElementsBoundByIndex where bar.isHittable {
+                let bottom = visibleFrame.maxY
+                visibleFrame.origin.y = max(visibleFrame.minY, bar.frame.maxY)
+                visibleFrame.size.height = max(0, bottom - visibleFrame.minY)
+            }
+            for keyboard in app.keyboards.allElementsBoundByIndex where keyboard.exists {
+                if visibleFrame.intersects(keyboard.frame) {
+                    visibleFrame.size.height = max(0, keyboard.frame.minY - visibleFrame.minY)
+                }
+            }
+            if element.exists {
+                if forInteraction && element.isHittable { return }
+                if !forInteraction && !element.frame.isEmpty && visibleFrame.contains(element.frame) { return }
+            }
+            guard scroll != nil, !visibleFrame.isEmpty else {
+                XCTFail("No visible scroll area can reveal \(element)", file: file, line: line)
+                return
+            }
+            let scrollDown = element.exists && element.frame.midY < visibleFrame.midY
+            let window = app.windows.firstMatch
+            let origin = window.coordinate(withNormalizedOffset: .zero)
+            let x = visibleFrame.midX - window.frame.minX
+            let top = visibleFrame.minY - window.frame.minY
+            let start = origin.withOffset(CGVector(dx: x, dy: top + visibleFrame.height * (scrollDown ? 0.35 : 0.65)))
+            let end = origin.withOffset(CGVector(dx: x, dy: top + visibleFrame.height * (scrollDown ? 0.65 : 0.35)))
+            start.press(forDuration: 0.01, thenDragTo: end)
+        }
+        XCTFail("Expected reachable content: \(element)", file: file, line: line)
+    }
