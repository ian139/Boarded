+private struct TabHouseIconShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        let scale = min(rect.width / 24.0, rect.height / 24.0)
+        let offsetX = (rect.width - 24.0 * scale) / 2.0
+        let offsetY = (rect.height - 24.0 * scale) / 2.0
+
+        // SVG: M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z
+        path.move(to: CGPoint(x: 3.0, y: 9.0))
+        path.addLine(to: CGPoint(x: 12.0, y: 2.0))
+        path.addLine(to: CGPoint(x: 21.0, y: 9.0))
+        path.addLine(to: CGPoint(x: 21.0, y: 20.0))
+        path.addCurve(to: CGPoint(x: 19.0, y: 22.0), control1: CGPoint(x: 21.0, y: 21.10), control2: CGPoint(x: 20.10, y: 22.0))
+        path.addLine(to: CGPoint(x: 5.0, y: 22.0))
+        path.addCurve(to: CGPoint(x: 3.0, y: 20.0), control1: CGPoint(x: 3.90, y: 22.0), control2: CGPoint(x: 3.0, y: 21.10))
+        path.closeSubpath()
+
+        // SVG polyline: 9 22 9 12 15 12 15 22
+        path.move(to: CGPoint(x: 9.0, y: 22.0))
+        path.addLine(to: CGPoint(x: 9.0, y: 12.0))
+        path.addLine(to: CGPoint(x: 15.0, y: 12.0))
+        path.addLine(to: CGPoint(x: 15.0, y: 22.0))
+
+        return path.applying(CGAffineTransform(scaleX: scale, y: scale).concatenating(CGAffineTransform(translationX: offsetX, y: offsetY)))
+    }
+}
+
+private struct TabCompassIconShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        let scale = min(rect.width / 24.0, rect.height / 24.0)
+        let offsetX = (rect.width - 24.0 * scale) / 2.0
+        let offsetY = (rect.height - 24.0 * scale) / 2.0
+
+        // SVG circle: cx=12, cy=12, r=10
+        path.addEllipse(in: CGRect(x: 2.0, y: 2.0, width: 20.0, height: 20.0))
+
+        // SVG polygon: points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"
+        path.move(to: CGPoint(x: 16.24, y: 7.76))
+        path.addLine(to: CGPoint(x: 14.12, y: 14.12))
+        path.addLine(to: CGPoint(x: 7.76, y: 16.24))
+        path.addLine(to: CGPoint(x: 9.88, y: 9.88))
+        path.closeSubpath()
+
+        return path.applying(CGAffineTransform(scaleX: scale, y: scale).concatenating(CGAffineTransform(translationX: offsetX, y: offsetY)))
+    }
+}
+
+private struct TabPulseIconShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        let scale = min(rect.width / 24.0, rect.height / 24.0)
+        let offsetX = (rect.width - 24.0 * scale) / 2.0
+        let offsetY = (rect.height - 24.0 * scale) / 2.0
+
+        // SVG path: M22 12h-4l-3 9L9 3l-3 9H2
+        path.move(to: CGPoint(x: 22.0, y: 12.0))
+        path.addLine(to: CGPoint(x: 18.0, y: 12.0))
+        path.addLine(to: CGPoint(x: 15.0, y: 21.0))
+        path.addLine(to: CGPoint(x: 9.0, y: 3.0))
+        path.addLine(to: CGPoint(x: 6.0, y: 12.0))
+        path.addLine(to: CGPoint(x: 2.0, y: 12.0))
+
+        return path.applying(CGAffineTransform(scaleX: scale, y: scale).concatenating(CGAffineTransform(translationX: offsetX, y: offsetY)))
+    }
+}
+
+private struct TabPersonIconShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        let scale = min(rect.width / 24.0, rect.height / 24.0)
+        let offsetX = (rect.width - 24.0 * scale) / 2.0
+        let offsetY = (rect.height - 24.0 * scale) / 2.0
+
+        // SVG circle: cx=12, cy=7, r=4
+        path.addEllipse(in: CGRect(x: 8.0, y: 3.0, width: 8.0, height: 8.0))
+
+        // SVG path: M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2
+        path.move(to: CGPoint(x: 20.0, y: 21.0))
+        path.addLine(to: CGPoint(x: 20.0, y: 19.0))
+        path.addCurve(to: CGPoint(x: 16.0, y: 15.0), control1: CGPoint(x: 20.0, y: 16.79), control2: CGPoint(x: 18.21, y: 15.0))
+        path.addLine(to: CGPoint(x: 8.0, y: 15.0))
+        path.addCurve(to: CGPoint(x: 4.0, y: 19.0), control1: CGPoint(x: 5.79, y: 15.0), control2: CGPoint(x: 4.0, y: 16.79))
+        path.addLine(to: CGPoint(x: 4.0, y: 21.0))
+
+        return path.applying(CGAffineTransform(scaleX: scale, y: scale).concatenating(CGAffineTransform(translationX: offsetX, y: offsetY)))
+    }
+}
+
+private struct RaisedButtonHitShape: Shape {
+    var overhang: CGFloat = 12
+
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        path.addRect(CGRect(
+            x: rect.minX,
+            y: rect.minY - overhang,
+            width: rect.width,
+            height: rect.height + overhang
+        ))
+        return path
+    }
+}
