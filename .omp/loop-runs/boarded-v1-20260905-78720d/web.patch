+              </svg>
+            </button>
+          )}
+
+          {/* View Route Details / Holds if applicable */}
+          {onOpenRoute && (item.route?.id || item.session.featured_attempt.route_id) && (
+            <button
+              type="button"
+              onClick={() => onOpenRoute(item.route?.id || item.session.featured_attempt.route_id!)}
+              className="flex min-h-[44px] items-center gap-1.5 px-3 rounded-lg text-xs font-semibold text-[#345CFF] hover:bg-[#345CFF]/10 transition-colors"
+            >
+              <span>Beta</span>
+              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                <path strokeLinecap="round" strokeLinejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
+              </svg>
+            </button>
+          )}
+        </div>
+      </footer>
+    </article>
+  );
+}
