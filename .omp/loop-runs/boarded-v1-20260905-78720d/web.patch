+                      <h3 className="text-base font-semibold text-[#F4F2EB] tracking-tight mb-1">
+                        {r.name}
+                      </h3>
+
+                      <div className="flex items-center gap-2 text-xs text-[#A8ABB3] flex-wrap">
+                        {r.venue?.name && (
+                          <span className="text-[#345CFF] font-medium">{r.venue.name}</span>
+                        )}
+                        <span className="capitalize">{r.discipline}</span>
+                        {r.terrain && <span>· {r.terrain}</span>}
+                        {r.height_m && <span>· {r.height_m}m</span>}
+                      </div>
+                    </div>
+
+                    {r.description && (
+                      <p className="text-xs text-[#A8ABB3]/80 line-clamp-2 mt-3 pt-2 border-t border-divider/40">
+                        {r.description}
+                      </p>
+                    )}
+                  </div>
+                ))}
+              </div>
+            )}
+          </section>
+        )}
+
+        {/* TAB 2: VENUES */}
+        {activeTab === 'venues' && (
+          <section className="space-y-4">
+            <div className="flex items-center justify-between text-xs text-[#A8ABB3]">
+              <span>Discovered Crags, Gyms, and Boards</span>
+              <button
+                type="button"
+                onClick={() => setIsNewVenueOpen(true)}
+                className="text-xs font-semibold text-[#345CFF] hover:underline"
+              >
+                + Register New Venue
+              </button>
+            </div>
+
+            {isVenuesLoading ? (
+              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 py-8">
+                {[1, 2].map((i) => (
+                  <div key={i} className="h-28 rounded-xl bg-[#171A22]/40 border border-divider animate-pulse" />
+                ))}
+              </div>
+            ) : venues.length === 0 ? (
+              <div className="py-16 text-center border border-divider rounded-2xl bg-[#0D0F14] p-6">
+                <p className="font-display text-xl font-semibold italic text-[#F4F2EB] mb-2">
+                  No Venues Found
+                </p>
+                <p className="text-xs text-[#A8ABB3] mb-4">
+                  Add the first climbing gym or outdoor crag in your area.
+                </p>
+                <button
+                  type="button"
+                  onClick={() => setIsNewVenueOpen(true)}
+                  className="min-h-[44px] px-5 rounded-xl bg-[#345CFF] text-[#F4F2EB] text-xs font-semibold hover:bg-[#2747D9] transition-colors"
+                >
+                  Add Venue
+                </button>
+              </div>
+            ) : (
+              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+                {venues.map((v) => (
+                  <div
+                    key={v.id}
+                    className="p-4 rounded-xl border border-divider bg-[#0D0F14] flex flex-col justify-between"
+                  >
+                    <div>
+                      <div className="flex items-center justify-between mb-1.5">
+                        <span className="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-[#171A22] border border-divider text-[#345CFF]">
+                          {v.kind}
+                        </span>
+                        {v.area && (
+                          <span className="text-xs text-[#A8ABB3] truncate max-w-[160px]">
+                            {v.area}
+                          </span>
+                        )}
+                      </div>
+                      <h3 className="text-base font-semibold text-[#F4F2EB]">{v.name}</h3>
+                      {v.description && (
+                        <p className="text-xs text-[#A8ABB3] mt-1.5 line-clamp-2">{v.description}</p>
+                      )}
+                    </div>
+                  </div>
+                ))}
+              </div>
+            )}
+          </section>
+        )}
+
+        {/* TAB 3: CLIMBERS */}
+        {activeTab === 'climbers' && (
+          <section className="space-y-4">
+            <div className="flex items-center justify-between text-xs text-[#A8ABB3]">
+              <span>Climbers & Route Setters</span>
+              <span className="tabular-nums">{climbers.length} climbers</span>
+            </div>
+
+            {isClimbersLoading ? (
+              <div className="space-y-3 py-6">
+                {[1, 2, 3].map((i) => (
+                  <div key={i} className="h-16 rounded-xl bg-[#171A22]/40 border border-divider animate-pulse" />
+                ))}
+              </div>
+            ) : climbers.length === 0 ? (
+              <div className="py-16 text-center border border-divider rounded-2xl bg-[#0D0F14] p-6">
+                <p className="font-display text-xl font-semibold italic text-[#F4F2EB] mb-2">
+                  No Climbers Found
+                </p>
+                <p className="text-xs text-[#A8ABB3]">
+                  Try searching by username or display name.
+                </p>
+              </div>
+            ) : (
+              <div className="space-y-3">
+                {climbers.map((climber) => {
+                  const isFollowing = followedClimberIds.has(climber.id);
+                  const isMe = user?.id === climber.id;
+                  const name = climber.full_name || climber.username || 'Climber';
+
+                  return (
+                    <div
+                      key={climber.id}
+                      className="flex items-center justify-between p-3.5 rounded-xl border border-divider bg-[#0D0F14]"
+                    >
+                      <Link
+                        href={`/profile?id=${climber.id}`}
+                        className="flex items-center gap-3 min-w-0 flex-1 hover:opacity-90 transition-opacity"
+                      >
+                        <div className="h-10 w-10 rounded-full bg-[#171A22] border border-divider flex items-center justify-center text-sm font-semibold text-[#345CFF] flex-shrink-0">
+                          {climber.avatar_url ? (
+                            <img src={climber.avatar_url} alt={name} className="h-full w-full rounded-full object-cover" />
+                          ) : (
+                            name.charAt(0).toUpperCase()
+                          )}
+                        </div>
+                        <div className="min-w-0">
+                          <p className="text-sm font-semibold text-[#F4F2EB] truncate">{name}</p>
+                          <p className="text-xs text-[#A8ABB3] truncate">
+                            {climber.username ? `@${climber.username}` : ''}
+                            {climber.home_area ? ` · ${climber.home_area}` : ''}
+                          </p>
+                        </div>
+                      </Link>
+
+                      {!isMe && (
+                        <button
+                          type="button"
+                          onClick={() => handleToggleFollowClimber(climber)}
+                          className={cn(
+                            'min-h-[38px] px-4 rounded-xl text-xs font-semibold transition-colors flex-shrink-0',
+                            isFollowing
+                              ? 'border border-divider bg-[#171A22] text-[#A8ABB3] hover:text-[#F4F2EB]'
+                              : 'bg-[#345CFF] text-[#F4F2EB] hover:bg-[#2747D9]'
+                          )}
+                        >
+                          {isFollowing ? 'Following' : '+ Follow'}
+                        </button>
+                      )}
+                    </div>
+                  );
+                })}
+              </div>
+            )}
+          </section>
+        )}
+
+        {/* TAB 4: BOARD STUDIO (Preserved existing Wall & Route management) */}
+        {activeTab === 'board_studio' && (
+          <section className="space-y-6">
+            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-2xl border border-divider bg-[#0D0F14]">
+              <div>
+                <h2 className="text-base font-semibold text-[#F4F2EB]">
+                  Interactive Board Studio
+                </h2>
+                <p className="text-xs text-[#A8ABB3] mt-0.5">
+                  Selected Wall: <span className="text-[#345CFF] font-medium">{selectedWall?.name || 'All Walls'}</span>
+                </p>
+              </div>
+
+              <div className="flex items-center gap-2">
+                <button
+                  type="button"
+                  onClick={() => setShowWallPicker(true)}
+                  className="min-h-[40px] px-4 rounded-xl border border-divider bg-[#171A22] text-xs font-semibold text-[#F4F2EB] hover:bg-white/[0.04] transition-colors"
+                >
+                  Change Wall
+                </button>
+                <Link
+                  href="/editor"
+                  className="min-h-[40px] px-4 rounded-xl bg-[#345CFF] text-[#F4F2EB] text-xs font-semibold hover:bg-[#2747D9] transition-colors inline-flex items-center gap-1.5"
+                >
+                  <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.5v15m7.5-7.5h-15" />
+                  </svg>
+                  <span>Create Board Route</span>
+                </Link>
+              </div>
+            </div>
+
+            {/* Board routes listing */}
+            <div className="space-y-4">
+              <h3 className="text-sm font-semibold text-[#F4F2EB]">
+                Routes on {selectedWall?.name || 'Climbing Wall'}
+              </h3>
+              <RouteList
+                routes={boardRoutes}
+                wallImageUrl={selectedWall?.image_url || '/walls/demo-wall.jpg'}
+                wallImageWidth={selectedWall?.image_width}
+                wallImageHeight={selectedWall?.image_height}
+                onViewRoute={(r) => setActiveRouteToView(r)}
+                onEditRoute={(r) => router.push(`/editor?edit=${r.id}`)}
+                onDeleteRoute={(r) => deleteBoardRoute(r.id)}
+                onLogClimb={() => router.push('/log')}
+              />
+            </div>
+          </section>
+        )}
+      </main>
+
+      {/* Modals & Dialogs */}
+      <NewVenueModal
+        isOpen={isNewVenueOpen}
+        onClose={() => setIsNewVenueOpen(false)}
+        onVenueCreated={(newV) => setVenues((prev) => [newV, ...prev])}
+      />
+
+      <NewRouteModal
+        isOpen={isNewRouteOpen}
+        onClose={() => setIsNewRouteOpen(false)}
+        onRouteCreated={(newR) => setRoutes((prev) => [newR, ...prev])}
+      />
+
+      {/* Wall Picker Dialog for Board Studio */}
+      <WallPickerDialog
+        open={showWallPicker}
+        onOpenChange={setShowWallPicker}
+        walls={walls}
+        selectedWall={selectedWall}
+        onSelectWall={(wall) => {
+          setSelectedWall(wall);
+          setShowWallPicker(false);
+        }}
+        onNewRoute={() => {
+          setShowWallPicker(false);
+          router.push('/editor');
+        }}
+      />
+
+      {/* Route Viewer Modal */}
+      {activeRouteToView && (
+        <RouteViewerDialog
+          route={activeRouteToView}
+          onOpenChange={(open) => !open && setActiveRouteToView(null)}
+          wallImageUrl={activeRouteToView.wall_image_url || selectedWall?.image_url || '/walls/demo-wall.jpg'}
+        />
+      )}
+    </div>
+  );
+}
