+'use client';
+
+import { useState, useEffect, useCallback, useRef } from 'react';
+import Link from 'next/link';
+import { useRouter } from 'next/navigation';
+import { toast } from 'sonner';
+import { cn } from '@/lib/utils';
+import { createClient } from '@/lib/supabase/client';
+import { useUserStore } from '@/lib/stores/user-store';
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+import type {
+  ClimbingSession,
+  ClimbAttempt,
+  ClimbDiscipline,
+  GradeSystem,
+  AttemptOutcome,
+  OverlayStyle,
+} from '@boarded/shared/types';
+
+export default function LogPage() {
+  const router = useRouter();
+  const { user } = useUserStore();
+  const fileInputRef = useRef<HTMLInputElement>(null);
+
+  // Active session state
+  const [activeSession, setActiveSession] = useState<ClimbingSession | null>(null);
+  const [attempts, setAttempts] = useState<ClimbAttempt[]>([]);
+  const [elapsedSeconds, setElapsedSeconds] = useState(0);
+
+  // Past sessions
+  const [pastSessions, setPastSessions] = useState<ClimbingSession[]>([]);
+  const [isLoadingHistory, setIsLoadingHistory] = useState(false);
+
+  // Start session form
+  const [venueName, setVenueName] = useState('Stonegate');
+  const [conditions, setConditions] = useState('');
+  const [sessionNotes, setSessionNotes] = useState('');
+  const [isStartingSession, setIsStartingSession] = useState(false);
+
+  // Log attempt form
+  const [routeName, setRouteName] = useState('');
+  const [discipline, setDiscipline] = useState<ClimbDiscipline>('sport');
+  const [gradeSystem, setGradeSystem] = useState<GradeSystem>('yds');
+  const [gradeLabel, setGradeLabel] = useState('5.12a');
+  const [outcome, setOutcome] = useState<AttemptOutcome>('sent');
+  const [attemptNotes, setAttemptNotes] = useState('');
+  const [isLoggingAttempt, setIsLoggingAttempt] = useState(false);
+
+  // Finish & Publish modal state
