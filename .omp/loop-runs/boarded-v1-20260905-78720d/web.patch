+              type="button"
+              onClick={onClose}
+              className="min-h-[44px] px-4 rounded-xl border border-divider text-xs font-semibold text-[#A8ABB3] hover:text-[#F4F2EB] transition-colors"
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={isSubmitting || !name.trim()}
+              className="min-h-[44px] px-6 rounded-xl bg-[#345CFF] text-[#F4F2EB] text-xs font-semibold hover:bg-[#2747D9] transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
+            >
+              {isSubmitting ? 'Creating...' : 'Create Venue'}
+            </button>
+          </div>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/components/feed/CommentsSheet.tsx b/components/feed/CommentsSheet.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..12b6bf85880ea31077311fb87f416d8e9113e13a
--- /dev/null
+++ b/components/feed/CommentsSheet.tsx
@@ -0,0 +1,221 @@
+'use client';
+
+import { useState, useEffect } from 'react';
+import { toast } from 'sonner';
+import { createClient } from '@/lib/supabase/client';
+import { useUserStore } from '@/lib/stores/user-store';
+import type { SessionFeedItem } from '@boarded/shared/types';
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
+
+interface CommentRecord {
+  id: string;
+  post_id: string;
+  user_id: string;
+  content: string;
+  created_at: string;
+  author?: {
+    username: string | null;
+    full_name: string | null;
+    avatar_url: string | null;
+  };
+}
+
+interface CommentsSheetProps {
+  item: SessionFeedItem | null;
+  isOpen: boolean;
+  onClose: () => void;
+  onCommentAdded?: () => void;
+}
+
+export function CommentsSheet({ item, isOpen, onClose, onCommentAdded }: CommentsSheetProps) {
+  const { user } = useUserStore();
+  const [comments, setComments] = useState<CommentRecord[]>([]);
+  const [isLoading, setIsLoading] = useState(false);
+  const [newComment, setNewComment] = useState('');
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  useEffect(() => {
+    if (!item || !isOpen) {
+      setComments([]);
+      return;
+    }
+
+    let isMounted = true;
+    const fetchComments = async () => {
+      setIsLoading(true);
+      try {
+        const supabase = createClient();
+        const { data, error } = await supabase
+          .from('session_post_comments')
+          .select('id, post_id, user_id, content, created_at, author:profiles!session_post_comments_user_id_fkey(username, full_name, avatar_url)')
+          .eq('post_id', item.id)
+          .order('created_at', { ascending: true });
+
+        if (error) throw error;
+        if (isMounted) {
+          interface RawCommentRow {
+            id: string;
+            post_id: string;
+            user_id: string;
+            content: string;
+            created_at: string;
+            author?: { username: string | null; full_name: string | null; avatar_url: string | null } | { username: string | null; full_name: string | null; avatar_url: string | null }[];
+          }
+          const rawRows = (data || []) as unknown as RawCommentRow[];
+          const formatted = rawRows.map((row) => ({
+            id: row.id,
+            post_id: row.post_id,
+            user_id: row.user_id,
+            content: row.content,
+            created_at: row.created_at,
+            author: Array.isArray(row.author) ? row.author[0] : row.author,
+          }));
+          setComments(formatted);
+        }
+      } catch {
+        // Table may be empty or error
+      } finally {
+        if (isMounted) setIsLoading(false);
+      }
+    };
+
+    fetchComments();
+    return () => {
+      isMounted = false;
+    };
+  }, [item, isOpen]);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!user) {
+      toast.error('Please sign in to comment');
+      return;
+    }
+    const trimmed = newComment.trim();
+    if (!trimmed || !item) return;
+
+    setIsSubmitting(true);
+    try {
+      const supabase = createClient();
+      const { data, error } = await supabase
+        .from('session_post_comments')
+        .insert({
+          post_id: item.id,
+          user_id: user.id,
+          content: trimmed,
+        })
+        .select(`
+          id,
+          post_id,
+          user_id,
+          content,
+          created_at,
+          author:profiles!session_post_comments_user_id_fkey(username, full_name, avatar_url)
+        `)
+        .single();
+
+      if (error) throw error;
+
+      const newRecord: CommentRecord = {
+        id: data.id,
+        post_id: data.post_id,
+        user_id: data.user_id,
+        content: data.content,
+        created_at: data.created_at,
+        author: {
+          username: user.displayName || 'Me',
+          full_name: user.displayName || 'Me',
+          avatar_url: null,
+        },
+      };
+
+      setComments((prev) => [...prev, newRecord]);
+      setNewComment('');
+      toast.success('Comment posted');
+      onCommentAdded?.();
+    } catch {
+      toast.error('Unable to post comment');
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const formatCommentTime = (ts: string) => {
+    const d = new Date(ts);
+    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + ' · ' + d.toLocaleDateString([], { month: 'short', day: 'numeric' });
+  };
+
+  return (
+    <Dialog open={isOpen} onOpenChange={(open) => !open && onClose()}>
+      <DialogContent className="sm:max-w-lg bg-[#0D0F14] border-divider text-[#F4F2EB] p-0 flex flex-col max-h-[85vh] overflow-hidden">
+        <DialogHeader className="p-4 border-b border-divider flex-shrink-0">
+          <DialogTitle className="text-base font-semibold text-[#F4F2EB] flex items-center justify-between">
+            <span>Comments</span>
+            {item && (
+              <span className="text-xs font-normal text-[#A8ABB3]">
+                {item.session.featured_attempt.route_name}
+              </span>
+            )}
+          </DialogTitle>
+        </DialogHeader>
+
+        {/* Comment List */}
+        <div className="flex-1 overflow-y-auto p-4 space-y-4 min-h-[220px]">
+          {isLoading ? (
+            <div className="flex items-center justify-center h-32 text-xs text-[#A8ABB3]">
+              Loading comments...
+            </div>
+          ) : comments.length === 0 ? (
+            <div className="flex flex-col items-center justify-center h-40 text-center text-xs text-[#A8ABB3]">
+              <svg className="w-8 h-8 text-[#A8ABB3]/40 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 21c-.473 0-.898-.242-1.144-.627a1.125 1.125 0 01-.137-.962 4.49 4.49 0 00.923-1.785A8.967 8.967 0 013 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
+              </svg>
+              <span>No comments yet. Start the beta conversation!</span>
+            </div>
+          ) : (
+            comments.map((comment) => {
+              const name = comment.author?.full_name || comment.author?.username || 'Climber';
+              return (
+                <div key={comment.id} className="flex items-start gap-3 text-sm">
+                  <div className="flex-shrink-0 h-8 w-8 rounded-full bg-[#171A22] border border-divider flex items-center justify-center text-xs font-semibold text-[#345CFF]">
+                    {comment.author?.avatar_url ? (
+                      <img src={comment.author.avatar_url} alt={name} className="h-full w-full rounded-full object-cover" />
+                    ) : (
+                      name.charAt(0).toUpperCase()
+                    )}
+                  </div>
+                  <div className="flex-1 min-w-0 bg-[#171A22]/50 rounded-xl p-3 border border-divider/40">
+                    <div className="flex items-baseline justify-between gap-2 mb-1">
+                      <span className="font-semibold text-xs text-[#F4F2EB]">{name}</span>
+                      <time className="text-[10px] text-[#A8ABB3]">{formatCommentTime(comment.created_at)}</time>
+                    </div>
+                    <p className="text-xs text-[#F4F2EB]/90 break-words leading-relaxed">{comment.content}</p>
+                  </div>
+                </div>
+              );
+            })
+          )}
+        </div>
+
+        {/* Comment Input */}
+        <form onSubmit={handleSubmit} className="p-3 border-t border-divider bg-[#0A0B10] flex items-center gap-2">
+          <input
+            type="text"
+            value={newComment}
+            onChange={(e) => setNewComment(e.target.value)}
+            placeholder={user ? "Add beta or congratulations..." : "Sign in to comment"}
+            disabled={!user || isSubmitting}
+            className="flex-1 min-h-[44px] bg-[#171A22] border border-divider rounded-xl px-3.5 text-xs text-[#F4F2EB] placeholder:text-[#A8ABB3] focus:outline-none focus:ring-2 focus:ring-[#345CFF]"
+          />
+          <button
+            type="submit"
+            disabled={!user || !newComment.trim() || isSubmitting}
+            className="min-h-[44px] px-4 rounded-xl bg-[#345CFF] text-[#F4F2EB] text-xs font-semibold disabled:opacity-40 disabled:cursor-not-allowed hover:bg-[#2747D9] transition-colors"
+          >
+            Post
+          </button>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
diff --git a/components/feed/FeedCard.tsx b/components/feed/FeedCard.tsx
