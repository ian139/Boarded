+'use client';
+
+import { useState, useEffect, useCallback } from 'react';
+import Link from 'next/link';
+import { useRouter } from 'next/navigation';
+import { toast } from 'sonner';
+import { cn } from '@/lib/utils';
+import { createClient } from '@/lib/supabase/client';
+import { useUserStore } from '@/lib/stores/user-store';
+import type { ActivityEvent, ActivityEventKind } from '@boarded/shared/types';
+
+export default function ActivityPage() {
+  const router = useRouter();
+  const { user } = useUserStore();
+
+  const [events, setEvents] = useState<ActivityEvent[]>([]);
+  const [isLoading, setIsLoading] = useState(true);
+  const [isMarkingAllRead, setIsMarkingAllRead] = useState(false);
+
+  const fetchActivity = useCallback(async () => {
+    if (!user) {
+      setIsLoading(false);
+      return;
+    }
+
+    setIsLoading(true);
+    try {
+      const supabase = createClient();
+      const { data, error } = await supabase.rpc('get_activity', {
+        page_size: 30,
+      });
+
+      if (error) {
+        // Fallback to direct table query
+        const { data: directData } = await supabase
+          .from('activity_events')
+          .select(`
+            id,
+            kind,
+            post_id,
+            created_at,
+            read_at,
+            actor:profiles!activity_events_actor_id_fkey(id, username, full_name, avatar_url, home_area)
+          `)
+          .eq('recipient_id', user.id)
+          .order('created_at', { ascending: false })
+          .limit(30);
+
+        if (directData) {
+          interface RawActivityRow {
+            id: string;
+            kind: ActivityEventKind;
+            post_id: string | null;
+            created_at: string;
+            read_at: string | null;
+            actor?: { id: string; username: string | null; full_name: string | null; avatar_url: string | null; home_area: string | null } | { id: string; username: string | null; full_name: string | null; avatar_url: string | null; home_area: string | null }[];
+          }
+          const raw = directData as unknown as RawActivityRow[];
+          setEvents(
+            raw.map((r) => ({
+              id: r.id,
+              kind: r.kind,
+              post_id: r.post_id,
+              created_at: r.created_at,
+              read_at: r.read_at,
+              actor: Array.isArray(r.actor) ? r.actor[0] : (r.actor || { id: '', username: null, full_name: 'Climber', avatar_url: null, home_area: null }),
+            }))
+          );
+        }
+      } else {
+        setEvents((data || []) as ActivityEvent[]);
+      }
+    } catch {
+      // Fallback
+    } finally {
+      setIsLoading(false);
+    }
+  }, [user]);
+
+  useEffect(() => {
+    fetchActivity();
+  }, [fetchActivity]);
+
+  // Mark all as read
+  const handleMarkAllRead = async () => {
+    if (!user) return;
+    setIsMarkingAllRead(true);
+    try {
+      const supabase = createClient();
+      const now = new Date().toISOString();
+      const { error } = await supabase
+        .from('activity_events')
+        .update({ read_at: now })
+        .eq('recipient_id', user.id)
+        .is('read_at', null);
+
+      if (error) throw error;
+
+      setEvents((prev) => prev.map((e) => ({ ...e, read_at: now })));
+      toast.success('All notifications marked as read');
+    } catch {
+      toast.error('Unable to mark notifications read');
+    } finally {
+      setIsMarkingAllRead(false);
+    }
+  };
+
+  // Handle clicking an activity event
+  const handleEventClick = async (event: ActivityEvent) => {
+    // Mark this event as read if unread
+    if (!event.read_at && user) {
+      try {
+        const supabase = createClient();
+        await supabase
+          .from('activity_events')
+          .update({ read_at: new Date().toISOString() })
+          .eq('id', event.id);
+
+        setEvents((prev) =>
+          prev.map((e) => (e.id === event.id ? { ...e, read_at: new Date().toISOString() } : e))
+        );
+      } catch {
+        // Non-blocking
+      }
+    }
+
+    if (event.kind === 'follow') {
+      router.push(`/profile?id=${event.actor.id}`);
+    } else if (event.post_id) {
+      router.push(`/app#post-${event.post_id}`);
+    }
+  };
+
+  const formatRelativeTime = (timestamp: string) => {
+    const date = new Date(timestamp);
+    const now = new Date();
+    const diffSec = Math.floor((now.getTime() - date.getTime()) / 1000);
+    if (diffSec < 60) return 'just now';
+    const diffMin = Math.floor(diffSec / 60);
+    if (diffMin < 60) return `${diffMin}m`;
+    const diffHours = Math.floor(diffMin / 60);
+    if (diffHours < 24) return `${diffHours}h`;
+    const diffDays = Math.floor(diffHours / 24);
+    if (diffDays < 7) return `${diffDays}d`;
+    return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
+  };
+
+  const getEventIcon = (kind: ActivityEventKind) => {
+    switch (kind) {
+      case 'like':
+        return (
+          <div className="h-7 w-7 rounded-full bg-white/10 text-[#F4F2EB] flex items-center justify-center">
+            <svg className="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
+              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
+            </svg>
+          </div>
+        );
+      case 'comment':
+        return (
+          <div className="h-7 w-7 rounded-full bg-[#345CFF]/15 text-[#345CFF] flex items-center justify-center">
+            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 21c-.473 0-.898-.242-1.144-.627a1.125 1.125 0 01-.137-.962 4.49 4.49 0 00.923-1.785A8.967 8.967 0 013 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
+            </svg>
+          </div>
+        );
+      case 'follow':
+        return (
+          <div className="h-7 w-7 rounded-full bg-[#345CFF]/15 text-[#345CFF] flex items-center justify-center">
+            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.375 12.375 0 014 19.235z" />
+            </svg>
+          </div>
+        );
+      case 'crew_send':
+        return (
+          <div className="h-7 w-7 rounded-full bg-[#32D583]/15 text-[#32D583] flex items-center justify-center">
+            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M4.5 12.75l6 6 9-13.5" />
+            </svg>
+          </div>
+        );
+    }
+  };
+
+  const getEventText = (event: ActivityEvent) => {
+    const actorName = event.actor.full_name || event.actor.username || 'A climber';
+    switch (event.kind) {
+      case 'like':
+        return <span><strong className="text-[#F4F2EB]">{actorName}</strong> gave kudos to your climb.</span>;
+      case 'comment':
+        return <span><strong className="text-[#F4F2EB]">{actorName}</strong> commented on your session.</span>;
+      case 'follow':
+        return <span><strong className="text-[#F4F2EB]">{actorName}</strong> started following your sends.</span>;
+      case 'crew_send':
+        return <span><strong className="text-[#F4F2EB]">{actorName}</strong> sent a project!</span>;
+    }
+  };
+
+  const unreadCount = events.filter((e) => !e.read_at).length;
+
+  return (
+    <div className="min-h-dvh bg-[#0A0B10] text-[#F4F2EB] pb-28 md:pb-16">
+      {/* Top Header */}
+      <header className="sticky top-0 md:top-16 z-30 border-b border-divider bg-[#0A0B10]/95 backdrop-blur-md px-4 sm:px-8 py-3.5">
+        <div className="max-w-2xl mx-auto flex items-center justify-between">
+          <div className="flex items-center gap-3">
+            <h1 className="font-display text-2xl font-semibold italic text-[#F4F2EB]">
+              Activity
+            </h1>
+            {unreadCount > 0 && (
+              <span className="px-2 py-0.5 rounded-full bg-[#345CFF]/15 border border-[#345CFF]/30 text-xs font-semibold text-[#345CFF] tabular-nums">
+                {unreadCount} new
+              </span>
+            )}
+          </div>
+
+          {unreadCount > 0 && (
+            <button
+              type="button"
+              onClick={handleMarkAllRead}
+              disabled={isMarkingAllRead}
+              className="text-xs font-semibold text-[#A8ABB3] hover:text-[#F4F2EB] transition-colors"
+            >
+              Mark all read
