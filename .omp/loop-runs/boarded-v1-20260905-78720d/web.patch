index 0000000000000000000000000000000000000000..cfaf02698d6c5613a1c71a5a9b94e87ef0d81732
--- /dev/null
+++ b/components/feed/FeedCard.tsx
@@ -0,0 +1,438 @@
+'use client';
+
+import { useState } from 'react';
+import Image from 'next/image';
+import Link from 'next/link';
+import { toast } from 'sonner';
+import { cn } from '@/lib/utils';
+import { createClient } from '@/lib/supabase/client';
+import { useUserStore } from '@/lib/stores/user-store';
+import type { SessionFeedItem } from '@boarded/shared/types';
+
+interface FeedCardProps {
+  item: SessionFeedItem;
+  onOpenComments: (item: SessionFeedItem) => void;
+  onOpenRoute?: (routeId: string) => void;
+}
+
+export function FeedCard({ item, onOpenComments, onOpenRoute }: FeedCardProps) {
+  const { user } = useUserStore();
+  const [isLiked, setIsLiked] = useState(item.is_liked);
+  const [likeCount, setLikeCount] = useState(item.like_count);
+  const [isSaved, setIsSaved] = useState(item.route?.is_saved ?? false);
+  const [isFollowed, setIsFollowed] = useState(item.author.is_followed);
+  const [isLikePending, setIsLikePending] = useState(false);
+  const [isFollowPending, setIsFollowPending] = useState(false);
+  const [isSavePending, setIsSavePending] = useState(false);
+
+  const supabase = createClient();
+  const isAuthor = user?.id === item.user_id;
+
+  const handleToggleLike = async () => {
+    if (!user) {
+      toast.error('Sign in to send kudos');
+      return;
+    }
+    if (isLikePending) return;
+
+    const previousLiked = isLiked;
+    const previousCount = likeCount;
+    const newLiked = !previousLiked;
+    const newCount = newLiked ? previousCount + 1 : Math.max(0, previousCount - 1);
+
+    setIsLiked(newLiked);
+    setLikeCount(newCount);
+    setIsLikePending(true);
+
+    try {
+      if (newLiked) {
+        const { error } = await supabase.from('session_post_likes').insert({
+          post_id: item.id,
+          user_id: user.id,
+        });
+        if (error && error.code !== '23505') throw error;
+      } else {
+        const { error } = await supabase
+          .from('session_post_likes')
+          .delete()
+          .eq('post_id', item.id)
+          .eq('user_id', user.id);
+        if (error) throw error;
+      }
+    } catch {
+      setIsLiked(previousLiked);
+      setLikeCount(previousCount);
+      toast.error('Unable to update kudos');
+    } finally {
+      setIsLikePending(false);
+    }
+  };
+
+  const handleToggleFollow = async () => {
+    if (!user) {
+      toast.error('Sign in to follow climbers');
+      return;
+    }
+    if (isFollowPending || isAuthor) return;
+
+    const previousFollowed = isFollowed;
+    const newFollowed = !previousFollowed;
+    setIsFollowed(newFollowed);
+    setIsFollowPending(true);
+
+    try {
+      if (newFollowed) {
+        const { error } = await supabase.from('follows').insert({
+          follower_id: user.id,
+          following_id: item.user_id,
+        });
+        if (error && error.code !== '23505') throw error;
+        toast.success(`Following ${item.author.full_name || item.author.username || 'climber'}`);
+      } else {
+        const { error } = await supabase
+          .from('follows')
+          .delete()
+          .eq('follower_id', user.id)
+          .eq('following_id', item.user_id);
+        if (error) throw error;
+      }
+    } catch {
+      setIsFollowed(previousFollowed);
+      toast.error('Unable to update follow');
+    } finally {
+      setIsFollowPending(false);
+    }
+  };
+
+  const handleToggleSave = async () => {
+    const routeId = item.route?.id || item.session.featured_attempt.route_id;
+    if (!routeId) return;
+    if (!user) {
+      toast.error('Sign in to bookmark routes');
+      return;
+    }
+    if (isSavePending) return;
+
+    const previousSaved = isSaved;
+    const newSaved = !previousSaved;
+    setIsSaved(newSaved);
+    setIsSavePending(true);
+
+    try {
+      if (newSaved) {
+        const { error } = await supabase.from('route_bookmarks').insert({
+          user_id: user.id,
+          route_id: routeId,
+        });
+        if (error && error.code !== '23505') throw error;
+        toast.success('Route saved to bookmarks');
+      } else {
+        const { error } = await supabase
+          .from('route_bookmarks')
+          .delete()
+          .eq('user_id', user.id)
+          .eq('route_id', routeId);
+        if (error) throw error;
+        toast.info('Route removed from bookmarks');
+      }
+    } catch {
+      setIsSaved(previousSaved);
+      toast.error('Unable to update bookmark');
+    } finally {
+      setIsSavePending(false);
+    }
+  };
+
+  const handleShare = async () => {
+    const shareUrl = typeof window !== 'undefined' ? `${window.location.origin}/app#post-${item.id}` : '';
+    const shareData = {
+      title: `${item.author.full_name || item.author.username || 'Climber'} on Boarded`,
+      text: `${item.session.featured_attempt.route_name} (${item.session.featured_attempt.grade_label})`,
+      url: shareUrl,
+    };
+
+    if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
+      try {
+        await navigator.share(shareData);
+        return;
+      } catch {
+        // Fallback to copy clipboard if canceled or failed
+      }
+    }
+
+    try {
+      await navigator.clipboard.writeText(shareUrl);
+      toast.success('Link copied to clipboard');
+    } catch {
+      toast.error('Unable to copy link');
+    }
+  };
+
+  const formatRelativeTime = (timestamp: string) => {
+    const date = new Date(timestamp);
+    const now = new Date();
+    const diffSec = Math.floor((now.getTime() - date.getTime()) / 1000);
+    if (diffSec < 60) return 'just now';
+    const diffMin = Math.floor(diffSec / 60);
+    if (diffMin < 60) return `${diffMin}m`;
+    const diffHours = Math.floor(diffMin / 60);
+    if (diffHours < 24) return `${diffHours}h`;
+    const diffDays = Math.floor(diffHours / 24);
+    if (diffDays < 7) return `${diffDays}d`;
+    return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
+  };
+
+  const authorName = item.author.full_name || item.author.username || 'Anonymous Climber';
+  const featured = item.session.featured_attempt;
+  const isSent = featured.outcome === 'sent';
+  const attributes = [
+    featured.discipline ? featured.discipline.charAt(0).toUpperCase() + featured.discipline.slice(1) : null,
+    item.route?.height_m ? `${item.route.height_m} m` : null,
+    item.route?.rock_type || null,
+    item.route?.terrain ? item.route.terrain.charAt(0).toUpperCase() + item.route.terrain.slice(1) : null,
+  ].filter(Boolean);
+
+  const displayImage = item.image_path || '/brand/stonegate-hero.png';
+
+  return (
+    <article
+      id={`post-${item.id}`}
+      className="w-full max-w-xl mx-auto border border-divider bg-[#0D0F14] rounded-2xl overflow-hidden transition-colors duration-150"
+    >
+      {/* Author Header */}
+      <header className="flex items-center justify-between px-4 py-3.5 border-b border-divider/60">
+        <div className="flex items-center gap-3 min-w-0">
+          <Link
+            href={`/profile?id=${item.user_id}`}
+            className="flex-shrink-0 h-10 w-10 rounded-full bg-[#171A22] border border-divider overflow-hidden flex items-center justify-center text-sm font-semibold text-[#345CFF] hover:opacity-90 transition-opacity"
+          >
+            {item.author.avatar_url ? (
+              <img
+                src={item.author.avatar_url}
+                alt={authorName}
+                className="h-full w-full object-cover"
+              />
+            ) : (
+              authorName.charAt(0).toUpperCase()
+            )}
+          </Link>
+          <div className="min-w-0">
+            <div className="flex items-center gap-2">
+              <Link
+                href={`/profile?id=${item.user_id}`}
+                className="text-sm font-semibold text-[#F4F2EB] truncate hover:underline"
+              >
+                {authorName}
+              </Link>
+              {!isAuthor && (
+                <button
+                  type="button"
+                  onClick={handleToggleFollow}
+                  disabled={isFollowPending}
+                  className={cn(
+                    'text-xs font-medium px-2 py-0.5 rounded transition-colors',
+                    isFollowed
+                      ? 'text-[#A8ABB3] hover:text-[#F4F2EB]'
+                      : 'text-[#345CFF] hover:text-[#345CFF]/80 font-semibold'
+                  )}
+                >
+                  {isFollowed ? 'Following' : '+ Follow'}
+                </button>
+              )}
+            </div>
+            <p className="text-xs text-[#A8ABB3] truncate">
+              {item.session.venue_name || 'Climbing Session'}
+              <span className="mx-1">·</span>
+              <time dateTime={item.created_at}>{formatRelativeTime(item.created_at)}</time>
+            </p>
+          </div>
+        </div>
+
+        <button
+          type="button"
+          onClick={handleShare}
+          title="Share climb"
+          className="flex h-10 w-10 items-center justify-center rounded-lg text-[#A8ABB3] hover:text-[#F4F2EB] hover:bg-white/[0.04] transition-colors"
+        >
+          <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.8}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
+          </svg>
+        </button>
+      </header>
+
+      {/* Photography & Scrim Overlay */}
+      <div className="relative w-full aspect-[4/5] sm:aspect-[4/5] bg-[#0A0B10] overflow-hidden">
+        <Image
+          src={displayImage}
+          alt={item.image_alt || `${featured.route_name} climb photograph`}
+          fill
+          sizes="(max-width: 640px) 100vw, 576px"
+          className="object-cover"
+          priority
+        />
+        {/* Obsidian fade scrim */}
+        <div className="absolute inset-0 bg-gradient-to-t from-[#0A0B10] via-[#0A0B10]/50 to-transparent pointer-events-none" />
+
+        {/* Top-right overlay badge: outcome & style */}
+        <div className="absolute top-4 right-4 flex items-center gap-2">
+          {item.session.send_count > 0 && (
+            <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#171A22]/90 border border-divider text-xs font-medium text-[#F4F2EB] backdrop-blur-sm">
+              <span className="h-2 w-2 rounded-full bg-[#32D583]" />
+              {item.session.send_count} {item.session.send_count === 1 ? 'send' : 'sends'}
+            </span>
+          )}
+        </div>
+
+        {/* Bottom factual shelf over photo */}
+        <div className="absolute bottom-0 left-0 right-0 p-5 pt-12 flex flex-col gap-2 pointer-events-auto">
+          {/* Outcome & Route Name */}
+          <div className="flex items-baseline gap-2.5 flex-wrap">
+            <span
+              className={cn(
+                'inline-flex items-center gap-1 text-sm font-semibold tracking-wide uppercase',
+                isSent ? 'text-[#32D583]' : 'text-[#A8ABB3]'
+              )}
+            >
+              {isSent && (
+                <svg className="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
+                  <path fillRule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clipRule="evenodd" />
+                </svg>
+              )}
+              {isSent ? 'Sent' : 'Attempted'}
+            </span>
+            <h2 className="text-xl sm:text-2xl font-semibold text-[#F4F2EB] tracking-tight">
+              {featured.route_name}
+            </h2>
+          </div>
+
+          {/* Grade & Route metadata */}
+          <div className="flex items-center gap-3 flex-wrap">
+            <span className="font-display text-3xl sm:text-4xl font-semibold italic text-[#F4F2EB] leading-none">
+              {featured.grade_label}
+            </span>
+            {attributes.length > 0 && (
+              <span className="text-sm font-medium text-[#F4F2EB]/80">
+                {attributes.join(' · ')}
+              </span>
+            )}
+          </div>
+
+          {/* Session Facts */}
+          <div className="flex items-center gap-2 text-xs font-medium text-[#A8ABB3] tabular-nums mt-0.5">
+            <span>
+              {featured.attempt_number}{' '}
+              {featured.attempt_number === 1 ? 'try' : 'tries'}
+            </span>
