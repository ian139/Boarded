+'use client';
+
+import Link from 'next/link';
+import { usePathname } from 'next/navigation';
+import { useState, useEffect } from 'react';
+import { cn } from '@/lib/utils';
+import { createClient } from '@/lib/supabase/client';
+import { useUserStore } from '@/lib/stores/user-store';
+
+interface NavItem {
+  href: string;
+  label: string;
+  badge?: boolean;
+}
+
+export function DesktopNav() {
+  const pathname = usePathname();
+  const { user } = useUserStore();
+  const [hasUnreadActivity, setHasUnreadActivity] = useState(false);
+
+  useEffect(() => {
+    if (!user) {
+      setHasUnreadActivity(false);
+      return;
+    }
+
+    let isMounted = true;
+    const checkUnread = async () => {
+      try {
+        const supabase = createClient();
+        const { count, error } = await supabase
+          .from('activity_events')
+          .select('*', { count: 'exact', head: true })
+          .eq('recipient_id', user.id)
+          .is('read_at', null);
+
+        if (!error && isMounted) {
+          setHasUnreadActivity((count || 0) > 0);
+        }
+      } catch {
+        // Fallback silently if offline
+      }
+    };
+
+    checkUnread();
+    const interval = setInterval(checkUnread, 30000);
+    return () => {
+      isMounted = false;
+      clearInterval(interval);
+    };
+  }, [user, pathname]);
+
+  if (pathname === '/') {
+    return null;
+  }
+
+  const navItems: NavItem[] = [
+    { href: '/app', label: 'Feed' },
+    { href: '/explore', label: 'Explore' },
+    { href: '/log', label: 'Log' },
+    { href: '/activity', label: 'Activity', badge: hasUnreadActivity },
+    { href: '/profile', label: 'Profile' },
+  ];
+
+  return (
+    <header className="sticky top-0 z-40 hidden md:flex h-16 w-full items-center justify-between border-b border-divider bg-[#0A0B10]/95 px-8 backdrop-blur-md">
+      <div className="flex items-center gap-8">
+        <Link
+          href="/app"
+          className="font-display text-2xl font-semibold italic tracking-tight text-[#F4F2EB] transition-opacity hover:opacity-90"
+        >
+          Boarded
+        </Link>
+        <nav aria-label="Desktop primary navigation" className="flex items-center gap-1">
+          {navItems.map((item) => {
+            const isActive = pathname === item.href || (item.href !== '/app' && pathname.startsWith(item.href));
+
+            return (
+              <Link
+                key={item.href}
+                href={item.href}
+                aria-current={isActive ? 'page' : undefined}
+                className={cn(
+                  'relative flex items-center gap-1.5 px-4 py-2 text-sm font-medium transition-colors duration-150 rounded-lg',
+                  isActive
+                    ? 'text-[#F4F2EB] bg-white/[0.06]'
+                    : 'text-[#A8ABB3] hover:text-[#F4F2EB] hover:bg-white/[0.03]'
+                )}
+              >
+                <span>{item.label}</span>
+                {item.badge && (
+                  <span className="flex h-2 w-2 rounded-full bg-[#345CFF]" />
+                )}
+                {isActive && (
+                  <span className="absolute bottom-0 left-4 right-4 h-[2px] rounded-full bg-[#345CFF]" />
+                )}
+              </Link>
+            );
+          })}
+        </nav>
+      </div>
+
+      <div className="flex items-center gap-4">
+        <Link
+          href="/editor"
+          className="inline-flex items-center justify-center gap-2 rounded-lg border border-divider bg-[#171A22] px-3.5 py-1.5 text-xs font-semibold text-[#F4F2EB] transition-colors hover:border-[#345CFF]/40 hover:bg-[#171A22]/80"
+        >
+          <svg className="w-4 h-4 text-[#345CFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
+          </svg>
+          <span>Board Studio</span>
+        </Link>
+
+        {user ? (
+          <div className="flex items-center gap-3">
+            <Link
+              href="/settings"
+              title="Settings"
+              className="flex h-9 w-9 items-center justify-center rounded-lg border border-divider text-[#A8ABB3] transition-colors hover:border-white/20 hover:text-[#F4F2EB]"
+            >
+              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.8}>
+                <path strokeLinecap="round" strokeLinejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.6 6.6 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
+                <path strokeLinecap="round" strokeLinejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
+              </svg>
+            </Link>
+            <Link
+              href="/profile"
+              className="flex items-center gap-2 rounded-full border border-divider bg-[#171A22] py-1 pl-1 pr-3 transition-colors hover:border-white/20"
+            >
+              <div className="flex h-7 w-7 items-center justify-center rounded-full bg-[#345CFF]/20 text-xs font-semibold text-[#345CFF]">
+                {user.displayName?.charAt(0).toUpperCase() || 'C'}
+              </div>
+              <span className="text-xs font-medium text-[#F4F2EB]">{user.displayName || 'Climber'}</span>
+            </Link>
+          </div>
+        ) : (
+          <Link
+            href="/login"
+            className="rounded-lg bg-[#345CFF] px-4 py-1.5 text-xs font-semibold text-[#F4F2EB] transition-colors hover:bg-[#2747D9]"
+          >
+            Sign in
+          </Link>
+        )}
+      </div>
+    </header>
+  );
+}
