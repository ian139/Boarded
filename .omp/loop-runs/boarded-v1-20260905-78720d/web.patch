+            <h2 className="font-display text-2xl font-semibold italic text-[#F4F2EB] mb-2">
+              Sign In for Activity
+            </h2>
+            <p className="text-xs text-[#A8ABB3] mb-6 max-w-sm mx-auto">
+              Follow climbers and share sessions to receive kudos, comments, and send alerts.
+            </p>
+            <Link
+              href="/login"
+              className="min-h-[44px] px-6 rounded-xl bg-[#345CFF] text-[#F4F2EB] text-xs font-semibold hover:bg-[#2747D9] transition-colors inline-flex items-center"
+            >
+              Sign In
+            </Link>
+          </div>
+        ) : isLoading ? (
+          <div className="space-y-3 py-4">
+            {[1, 2, 3, 4].map((i) => (
+              <div key={i} className="h-16 rounded-xl bg-[#171A22]/40 border border-divider animate-pulse" />
+            ))}
+          </div>
+        ) : events.length === 0 ? (
+          <div className="py-16 text-center border border-divider rounded-2xl bg-[#0D0F14] p-6">
+            <div className="h-12 w-12 rounded-full bg-[#345CFF]/10 text-[#345CFF] flex items-center justify-center mx-auto mb-4">
+              <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.75}>
+                <path strokeLinecap="round" strokeLinejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
+              </svg>
+            </div>
+            <h2 className="font-display text-2xl font-semibold italic text-[#F4F2EB] mb-2">
+              All Caught Up
+            </h2>
+            <p className="text-xs text-[#A8ABB3] max-w-sm mx-auto mb-6">
+              When other climbers send kudos on your sessions, comment on beta, or follow your sends, notifications will appear here.
+            </p>
+            <Link
+              href="/explore"
+              className="min-h-[44px] px-6 rounded-xl bg-[#171A22] border border-divider text-[#F4F2EB] text-xs font-semibold hover:bg-white/[0.04] transition-colors inline-flex items-center"
+            >
+              Explore Climbers & Routes
+            </Link>
+          </div>
+        ) : (
+          <div className="space-y-2">
+            {events.map((event) => {
+              const isUnread = !event.read_at;
+
+              return (
+                <div
+                  key={event.id}
+                  onClick={() => handleEventClick(event)}
+                  className={cn(
+                    'flex items-center justify-between p-3.5 rounded-xl border transition-all cursor-pointer',
+                    isUnread
+                      ? 'border-[#345CFF]/30 bg-[#171A22]/80 hover:bg-[#171A22]'
+                      : 'border-divider bg-[#0D0F14] hover:bg-white/[0.02]'
+                  )}
+                >
+                  <div className="flex items-center gap-3 min-w-0 flex-1">
+                    {/* Actor avatar with event type badge */}
+                    <div className="relative flex-shrink-0">
+                      <div className="h-10 w-10 rounded-full bg-[#171A22] border border-divider flex items-center justify-center text-xs font-semibold text-[#345CFF] overflow-hidden">
+                        {event.actor.avatar_url ? (
+                          <img
+                            src={event.actor.avatar_url}
+                            alt={event.actor.full_name || 'Actor'}
+                            className="h-full w-full object-cover"
+                          />
+                        ) : (
+                          (event.actor.full_name || event.actor.username || 'C').charAt(0).toUpperCase()
+                        )}
+                      </div>
+                      <div className="absolute -bottom-1 -right-1 scale-75">
+                        {getEventIcon(event.kind)}
+                      </div>
+                    </div>
+
+                    <div className="min-w-0 pr-2">
+                      <p className="text-xs text-[#F4F2EB]/90 leading-snug">
+                        {getEventText(event)}
+                      </p>
+                      <p className="text-[10px] text-[#A8ABB3] mt-0.5">
+                        <time dateTime={event.created_at}>{formatRelativeTime(event.created_at)}</time>
+                        {event.actor.home_area ? ` · ${event.actor.home_area}` : ''}
+                      </p>
+                    </div>
+                  </div>
+
+                  {isUnread && (
+                    <span className="h-2 w-2 rounded-full bg-[#345CFF] flex-shrink-0" />
+                  )}
+                </div>
+              );
+            })}
+          </div>
+        )}
+      </main>
+    </div>
+  );
+}
