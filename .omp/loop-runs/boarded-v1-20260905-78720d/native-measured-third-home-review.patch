+/// DOM RM-0: lucide bell outline, `M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9`
+/// in a 24-unit viewBox, scaled to its rendered frame.
+private struct NotificationBellBodyShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        let scale = min(rect.width / 24.0, rect.height / 24.0)
+        let offsetX = (rect.width - 24.0 * scale) / 2.0
+        let offsetY = (rect.height - 24.0 * scale) / 2.0
+
+        // Dome arc (A6 6 0 0 0 6 8): center (12,8) r6, 0°→180°, clockwise true
+        // (verified against Path.addArc: true gives the upper bbox 6..12, y 2..8).
+        path.move(to: CGPoint(x: 18.0, y: 8.0))
+        path.addArc(
+            center: CGPoint(x: 12.0, y: 8.0),
+            radius: 6.0,
+            startAngle: .degrees(0),
+            endAngle: .degrees(180),
+            clockwise: true
+        )
+        path.addCurve(
+            to: CGPoint(x: 3.0, y: 17.0),
+            control1: CGPoint(x: 6.0, y: 15.0),
+            control2: CGPoint(x: 3.0, y: 17.0)
+        )
+        path.addLine(to: CGPoint(x: 21.0, y: 17.0))
+        // `s-3-2-3-9` follows `h18`, so the smooth-cubic first control is the
+        // current point (21,17) — `h` resets cubic control reflection history.
+        path.addCurve(
+            to: CGPoint(x: 18.0, y: 8.0),
+            control1: CGPoint(x: 21.0, y: 17.0),
+            control2: CGPoint(x: 18.0, y: 15.0)
+        )
+
+        return path.applying(
+            CGAffineTransform(scaleX: scale, y: scale)
+                .concatenating(CGAffineTransform(translationX: offsetX, y: offsetY))
+        )
+    }
+}
+
+/// DOM RN-0: lucide clapper, `M13.73 21a2 2 0 0 1-3.46 0` in a 24-unit viewBox.
+private struct NotificationBellClapperShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        let scale = min(rect.width / 24.0, rect.height / 24.0)
+        let offsetX = (rect.width - 24.0 * scale) / 2.0
+        let offsetY = (rect.height - 24.0 * scale) / 2.0
+
+        // Arc `a2 2 0 0 1-3.46 0`: endpoints (13.73,21) and (10.27,21), r 2,
+        // sweep 1 → bulges downward. Center sits above the chord at distance
+        // sqrt(r² − 1.73²) ≈ 1.00354 (exact half-chord, not rounded 30°/150°);
+        // clockwise false gives the lower arc (verified against Path.addArc).
+        let radius: CGFloat = 2.0
+        let halfChord: CGFloat = 1.73
+        let centerY = 21.0 - (radius * radius - halfChord * halfChord).squareRoot()
+        let angle = atan2(21.0 - centerY, halfChord)
+        path.move(to: CGPoint(x: 13.73, y: 21.0))
+        path.addArc(
+            center: CGPoint(x: 12.0, y: centerY),
+            radius: radius,
+            startAngle: .radians(Double(angle)),
+            endAngle: .radians(Double.pi - Double(angle)),
+            clockwise: false
+        )
+
+        return path.applying(
+            CGAffineTransform(scaleX: scale, y: scale)
+                .concatenating(CGAffineTransform(translationX: offsetX, y: offsetY))
+        )
+    }
+}
