+import { describe, it, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  routes,
+  validateAttempt,
+  sanitizeText,
+  mayaPost,
+  INITIAL_COMMENTS,
+  INITIAL_JOURNAL_DATA,
+  type AttemptInput,
+  type Entry,
+} from './journal.ts';
+import {
+  useJournal,
+  STORAGE_KEY,
+  validateAndSanitizeData,
+} from './store.ts';
+
+// Mock localStorage for node:test environment
+class MockLocalStorage {
+  private store: Map<string, string> = new Map();
+  public shouldThrowOnSet = false;
+
+  getItem(key: string): string | null {
+    return this.store.has(key) ? this.store.get(key)! : null;
+  }
+
+  setItem(key: string, value: string): void {
+    if (this.shouldThrowOnSet) {
+      throw new Error('QuotaExceededError: storage write blocked');
+    }
+    this.store.set(key, value);
+  }
+
+  removeItem(key: string): void {
+    this.store.delete(key);
+  }
+
+  clear(): void {
+    this.store.clear();
+    this.shouldThrowOnSet = false;
+  }
+}
+
+describe('Domain invariants: routes and seed data', () => {
+  it('exposes redpoint-ridge and two believable alternative routes', () => {
+    assert.equal(routes.length, 3);
+    const redpoint = routes.find((r) => r.id === 'redpoint-ridge');
+    assert.ok(redpoint, 'Redpoint Ridge must exist');
+    assert.equal(redpoint.grade, '5.12a');
+    assert.equal(redpoint.crag, 'Stonegate');
+    assert.equal(redpoint.type, 'Sport');
+    assert.equal(redpoint.rock, 'Limestone');
+    assert.equal(redpoint.style, 'Overhang');
+
+    const bishop = routes.find((r) => r.crag === 'Bishop');
+    assert.ok(bishop, 'Bishop boulder alternative must exist');
+  });
+
+  it('exposes canonical mayaPost with exact display and UTC seed times', () => {
+    assert.equal(mayaPost.id, 'maya-redpoint');
+    assert.equal(mayaPost.author, 'Maya K.');
+    assert.equal(mayaPost.routeId, 'redpoint-ridge');
+    assert.equal(mayaPost.type, 'Sport');
+    assert.equal(mayaPost.outcome, 'sent');
+    assert.equal(mayaPost.attempts, 6);
+    assert.equal(mayaPost.timestamp, '2026-09-06T09:00:00Z');
+    assert.equal(mayaPost.caption, 'Six tries. One quiet moment when it all clicked.');
+    assert.equal(mayaPost.photoUrl, '/boarded/redpoint-ridge.webp');
+    assert.equal(mayaPost.initialCommentsCount, 12);
+  });
+
+  it('provides 12 genuine, readable seed comments matching mayaPost initialCommentsCount', () => {
+    assert.equal(INITIAL_COMMENTS.length, 12);
+    const mayaComments = INITIAL_COMMENTS.filter((c) => c.postId === 'maya-redpoint');
+    assert.equal(mayaComments.length, 12);
+    for (const c of mayaComments) {
+      assert.ok(c.id, 'Comment id required');
+      assert.ok(c.text.length > 5, 'Comment text must be substantive');
+      assert.ok(c.author.length > 0, 'Comment author required');
+      assert.ok(c.createdAt, 'Comment createdAt required');
+    }
+  });
+});
+
+describe('Domain validation: validateAttempt', () => {
+  it('rejects missing or unknown routes', () => {
+    const invalidRoute: AttemptInput = {
+      routeId: 'non-existent-crag-route',
+      date: '2026-09-06',
+      attempts: 2,
+      conditions: 'Dry and crisp',
+      notes: 'Good rest at the third bolt',
+    };
+    const errors = validateAttempt(invalidRoute);
+    assert.ok(errors.routeId, 'Must flag invalid routeId');
+  });
+
+  it('enforces strict YYYY-MM-DD date contract and rejects invalid calendar days', () => {
+    const base: AttemptInput = {
+      routeId: 'redpoint-ridge',
+      date: 'yesterday',
+      attempts: 1,
+      conditions: '',
+      notes: '',
+    };
+    assert.ok(validateAttempt(base).date, 'Must reject relative date strings');
+
+    base.date = '09/06/2026';
+    assert.ok(validateAttempt(base).date, 'Must reject US formatted dates');
+
+    base.date = '2026-02-31';
+    // JavaScript Date parsing may reject or wrap; ensure validation flags invalid
+    base.date = '2026-13-45';
+    assert.ok(validateAttempt(base).date, 'Must reject impossible month/day');
+
+    base.date = '2026-09-06';
+    assert.equal(validateAttempt(base).date, undefined, 'Must accept YYYY-MM-DD');
+  });
+
+  it('enforces positive integer attempts bounded within 1..100', () => {
+    const base: AttemptInput = {
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 0,
+      conditions: '',
+      notes: '',
+    };
+    assert.ok(validateAttempt(base).attempts, 'Must reject 0 attempts');
+
+    base.attempts = -3;
+    assert.ok(validateAttempt(base).attempts, 'Must reject negative attempts');
+
+    base.attempts = 1.5;
+    assert.ok(validateAttempt(base).attempts, 'Must reject fractional attempts');
+
+    base.attempts = 101;
+    assert.ok(validateAttempt(base).attempts, 'Must reject attempt count > 100');
+
+    base.attempts = 6;
+    assert.equal(validateAttempt(base).attempts, undefined, 'Accepts valid attempt count');
+  });
+
+  it('enforces sensible length limits on conditions and notes', () => {
+    const base: AttemptInput = {
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 1,
+      conditions: 'x'.repeat(501),
+      notes: 'y'.repeat(1001),
+    };
+    const errors = validateAttempt(base);
+    assert.ok(errors.conditions, 'Must reject conditions > 500 chars');
+    assert.ok(errors.notes, 'Must reject notes > 1000 chars');
+  });
+});
+
+describe('Sanitization: sanitizeText', () => {
+  it('strips unsafe angle brackets and trims excessive whitespace', () => {
+    const malicious = '  <script>alert("xss")</script>Crux was slick  ';
+    const clean = sanitizeText(malicious);
+    assert.equal(clean, 'scriptalert("xss")/scriptCrux was slick');
+    assert.ok(!clean.includes('<'));
+    assert.ok(!clean.includes('>'));
+  });
+});
+
+describe('State transitions: attempt -> sent -> published', () => {
+  let mockStorage: MockLocalStorage;
+
+  beforeEach(() => {
+    mockStorage = new MockLocalStorage();
+    (globalThis as unknown as { window: { localStorage: MockLocalStorage } }).window = {
+      localStorage: mockStorage,
+    };
+    useJournal.setState({
+      entries: [],
+      savedRouteIds: [],
+      likedPostIds: [],
+      comments: [...INITIAL_JOURNAL_DATA.comments],
+      followingMaya: true,
+      activityRead: false,
+      ready: true,
+      error: null,
+    });
+  });
+
+  it('records an attempt with initial outcome="attempted" and published=false', () => {
+    const result = useJournal.getState().recordAttempt({
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 4,
+      conditions: 'Crisp morning, 12C',
+      notes: 'Linked through crux move cleanly',
+    });
+
+    assert.ok('id' in result, 'Must return generated entry id on success');
+    const entries = useJournal.getState().entries;
+    assert.equal(entries.length, 1);
+    assert.equal(entries[0].id, result.id);
+    assert.equal(entries[0].outcome, 'attempted');
+    assert.equal(entries[0].published, false);
+  });
+
+  it('forbids publishing an unsent attempt', () => {
+    const recordRes = useJournal.getState().recordAttempt({
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 2,
+      conditions: '',
+      notes: '',
+    });
+    assert.ok('id' in recordRes);
+
+    const publishRes = useJournal.getState().publish(recordRes.id, 'Tried hard today!');
+    assert.ok('error' in publishRes, 'Publishing unsent attempt must return an error');
+    assert.match(publishRes.error, /has not been sent/i);
+
+    const entry = useJournal.getState().entries.find((e) => e.id === recordRes.id);
+    assert.equal(entry?.published, false, 'Entry must remain unpublished');
+  });
+
+  it('transitions attempt to sent, then allows publishing', () => {
+    const recordRes = useJournal.getState().recordAttempt({
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 6,
+      conditions: 'Dry rock',
+      notes: 'Everything clicked on try 6',
+    });
+    assert.ok('id' in recordRes);
+
+    const sentRes = useJournal.getState().markSent(recordRes.id);
+    assert.deepEqual(sentRes, { ok: true });
+
+    let entry = useJournal.getState().entries.find((e) => e.id === recordRes.id);
+    assert.equal(entry?.outcome, 'sent');
+
+    const pubRes = useJournal.getState().publish(recordRes.id, 'Sent on try 6!');
+    assert.deepEqual(pubRes, { ok: true });
+
+    entry = useJournal.getState().entries.find((e) => e.id === recordRes.id);
+    assert.equal(entry?.published, true);
+    assert.equal(entry?.caption, 'Sent on try 6!');
+  });
+
+  it('guarantees idempotency on repeated markSent and publish calls', () => {
+    const recordRes = useJournal.getState().recordAttempt({
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 1,
+      conditions: '',
+      notes: '',
+    });
+    assert.ok('id' in recordRes);
+
+    // Call markSent multiple times
+    assert.deepEqual(useJournal.getState().markSent(recordRes.id), { ok: true });
+    assert.deepEqual(useJournal.getState().markSent(recordRes.id), { ok: true });
+    assert.equal(useJournal.getState().entries.length, 1);
+
+    // Call publish multiple times
+    assert.deepEqual(useJournal.getState().publish(recordRes.id, 'First try send'), { ok: true });
+    assert.deepEqual(useJournal.getState().publish(recordRes.id, 'First try send'), { ok: true });
+    assert.equal(useJournal.getState().entries.length, 1);
+  });
+
+  it('safely handles missing entry operations without crashing or corrupting', () => {
+    const nonExistent = 'entry-missing-999';
+    assert.ok('error' in useJournal.getState().markSent(nonExistent));
+    assert.ok('error' in useJournal.getState().publish(nonExistent, 'Ghost send'));
+    assert.ok('error' in useJournal.getState().deleteEntry(nonExistent));
+  });
+});
+
+describe('Deletion and restoration recovery', () => {
+  let mockStorage: MockLocalStorage;
+
+  beforeEach(() => {
+    mockStorage = new MockLocalStorage();
+    (globalThis as unknown as { window: { localStorage: MockLocalStorage } }).window = {
+      localStorage: mockStorage,
+    };
+    useJournal.setState({
+      entries: [],
+      savedRouteIds: [],
+      likedPostIds: [],
+      comments: [...INITIAL_JOURNAL_DATA.comments],
+      followingMaya: true,
+      activityRead: false,
+      ready: true,
+      error: null,
+    });
+  });
+
+  it('supports deleting an entry and restoring it for UI undo/recovery', () => {
+    const recordRes = useJournal.getState().recordAttempt({
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 3,
+      conditions: 'Sunny',
+      notes: 'Resting before the roof',
+    });
+    assert.ok('id' in recordRes);
+
+    const savedEntry = { ...useJournal.getState().entries[0] };
+    assert.equal(useJournal.getState().entries.length, 1);
+
+    // Delete
+    const delRes = useJournal.getState().deleteEntry(recordRes.id);
+    assert.deepEqual(delRes, { ok: true });
+    assert.equal(useJournal.getState().entries.length, 0);
+
+    // Restore
+    const restoreRes = useJournal.getState().restoreEntry(savedEntry);
+    assert.deepEqual(restoreRes, { ok: true });
+    assert.equal(useJournal.getState().entries.length, 1);
+    assert.equal(useJournal.getState().entries[0].id, recordRes.id);
+
+    // Repeated restore is idempotent
+    assert.deepEqual(useJournal.getState().restoreEntry(savedEntry), { ok: true });
+    assert.equal(useJournal.getState().entries.length, 1);
+  });
+});
+
+describe('Storage resilience and corruption protection', () => {
+  let mockStorage: MockLocalStorage;
+
+  beforeEach(() => {
+    mockStorage = new MockLocalStorage();
+    (globalThis as unknown as { window: { localStorage: MockLocalStorage } }).window = {
+      localStorage: mockStorage,
+    };
+  });
+
+  it('validates schema and rejects fatally malformed persisted shapes', () => {
+    assert.equal(validateAndSanitizeData(null), null);
+    assert.equal(validateAndSanitizeData('arbitrary string'), null);
+    assert.equal(validateAndSanitizeData({ entries: 'not-an-array' }), null);
+    assert.equal(validateAndSanitizeData([1, 2, 3]), null);
+  });
+
+  it('preserves corrupted storage without silently resetting or wiping user data', () => {
+    // Write malformed JSON to storage
+    mockStorage.setItem(STORAGE_KEY, '{ malformed json: not valid ...');
+
+    useJournal.getState().initialize();
+
+    const state = useJournal.getState();
+    assert.ok(state.ready, 'Store should become ready');
+    assert.ok(state.error, 'Store must report visible error');
+    assert.match(state.error!, /malformed JSON/i);
+
+    // Verify storage key was NOT overwritten
+    assert.equal(mockStorage.getItem(STORAGE_KEY), '{ malformed json: not valid ...');
+  });
+
+  it('retains in-memory state and fails visibly when storage writes fail', () => {
+    useJournal.getState().initialize();
+    mockStorage.shouldThrowOnSet = true; // Simulate quota exceeded / storage blocked
+
+    const result = useJournal.getState().recordAttempt({
+      routeId: 'redpoint-ridge',
+      date: '2026-09-06',
+      attempts: 5,
+      conditions: '',
+      notes: '',
+    });
+
+    // Must NOT falsely report success
+    assert.ok('error' in result, 'Action must return error when durability fails');
+    assert.match(result.error, /storage write failed/i);
+
+    // Must visibly set error on store
+    const state = useJournal.getState();
+    assert.ok(state.error, 'Store must reflect visible storage error');
+
+    // In-memory data is retained so user work is not lost
+    assert.equal(state.entries.length, 1, 'In-memory entries must be preserved despite write failure');
+    assert.equal(state.entries[0].attempts, 5);
+  });
+});
