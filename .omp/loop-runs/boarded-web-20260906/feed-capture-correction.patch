+    if (!mainRef.current) return;
+
+    // Check if destination h1 already exists
+    const existingHeading = mainRef.current.querySelector<HTMLElement>('h1');
+    if (existingHeading) {
+      existingHeading.setAttribute('tabIndex', '-1');
+      existingHeading.focus({ preventScroll: true });
+      return;
     }
+
+    // If child is suspended or mounting asynchronously, wait for destination h1 via bounded MutationObserver
+    let observer: MutationObserver | null = null;
+    let timeoutId: number | null = null;
+
+    const cleanup = () => {
+      if (observer) {
+        observer.disconnect();
+        observer = null;
+      }
+      if (timeoutId) {
+        clearTimeout(timeoutId);
+        timeoutId = null;
+      }
+    };
+
+    observer = new MutationObserver(() => {
+      if (mainRef.current) {
+        const heading = mainRef.current.querySelector<HTMLElement>('h1');
+        if (heading) {
+          cleanup();
+          heading.setAttribute('tabIndex', '-1');
+          heading.focus({ preventScroll: true });
+        }
+      }
+    });
+
+    observer.observe(mainRef.current, {
+      childList: true,
+      subtree: true,
+    });
+
+    // Fallback: disconnect after 1500ms and focus h1 or main
+    timeoutId = window.setTimeout(() => {
+      cleanup();
+      if (mainRef.current) {
+        const heading = mainRef.current.querySelector<HTMLElement>('h1');
+        if (heading) {
+          heading.setAttribute('tabIndex', '-1');
+          heading.focus({ preventScroll: true });
+        } else {
+          mainRef.current.focus({ preventScroll: true });
+        }
+      }
+    }, 1500);
+
+    return cleanup;
   }, [pathname]);
 
