new file mode 100644
index 0000000000000000000000000000000000000000..3fba7267b077e07d453a5fce20d7bd458723ea57
--- /dev/null
+++ b/app/app/boarded.css
@@ -0,0 +1,638 @@
+@font-face {
+  font-family: "Cormorant Garamond";
+  src: url("/fonts/CormorantGaramond-SemiBoldItalic.ttf") format("truetype");
+  font-weight: 600;
+  font-style: italic;
+  font-display: swap;
+}
+
+/* ==========================================================================
+   Root Theme Container & Tokens
+   ========================================================================== */
+.boarded {
+  --color-bg-base: #0A0B10;
+  --color-bg-elevated: #171A22;
+  --color-bg-subtle: #1F232D;
+  --color-text-primary: #F4F2EB;
+  --color-text-secondary: rgba(244, 242, 235, 0.70);
+  --color-text-tertiary: rgba(244, 242, 235, 0.46);
+  --color-text-disabled: rgba(244, 242, 235, 0.26);
+
+  /* Prompt Override: Electric Indigo for agency; Send Green strictly for sends */
+  --color-action-primary: #345CFF;
+  --color-action-hover: #2649E0;
+  --color-action-soft: rgba(52, 92, 255, 0.16);
+  --color-send: #32D583;
+  --color-send-soft: rgba(50, 213, 131, 0.16);
+
+  --color-danger: #FF5C5C;
+  --color-warning: #F6C85F;
+  --color-border-default: rgba(244, 242, 235, 0.14);
+  --color-border-subtle: rgba(244, 242, 235, 0.08);
+
+  --color-focus-inner: #345CFF;
+  --color-focus-outer: #F4F2EB;
+
+  --font-serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
+  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+
+  --space-1: 4px;
+  --space-2: 8px;
+  --space-3: 12px;
+  --space-4: 16px;
+  --space-6: 24px;
+  --space-8: 32px;
+  --space-12: 48px;
+
+  --radius-sm: 4px;
+  --radius-md: 8px;
+  --radius-lg: 12px;
+  --radius-full: 9999px;
+
+  background-color: var(--color-bg-base);
+  color: var(--color-text-primary);
+  font-family: var(--font-sans);
+  color-scheme: dark;
+  min-height: 100dvh;
+  box-sizing: border-box;
+}
+
+.boarded *,
+.boarded *::before,
+.boarded *::after {
+  box-sizing: border-box;
+}
+
+/* ==========================================================================
+   Focus & Accessibility Discipline
+   ========================================================================== */
+.boarded :focus-visible {
+  outline: 2px solid var(--color-focus-inner);
+  outline-offset: 2px;
+  box-shadow: 0 0 0 1px var(--color-focus-outer);
+}
+
+.boarded .b-skip-link {
+  position: absolute;
+  top: -120px;
+  left: 16px;
+  z-index: 1000;
+  background: var(--color-action-primary);
+  color: var(--color-text-primary);
+  padding: 12px 18px;
+  border-radius: var(--radius-md);
+  font-weight: 600;
+  font-size: 14px;
+  text-decoration: none;
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
+  transition: top 0.15s ease-out;
+}
+
+.boarded .b-skip-link:focus {
+  top: 16px;
+}
+
+/* Live region for storage alerts / error banners */
+.boarded .b-live-alert {
+  background-color: #261616;
+  border: 1px solid var(--color-danger);
+  color: var(--color-text-primary);
+  padding: 12px 16px;
+  border-radius: var(--radius-md);
+  margin-bottom: var(--space-4);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  font-size: 14px;
+  line-height: 20px;
+}
+
+/* ==========================================================================
+   Landmark & Page Containers
+   ========================================================================== */
+.boarded .b-shell-layout {
+  display: flex;
+  min-height: 100dvh;
+  width: 100%;
+}
+
+.boarded .b-main {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: var(--space-4) var(--space-4) 96px var(--space-4);
+}
+
+@media (min-width: 1024px) {
+  .boarded .b-main {
+    padding: var(--space-8) var(--space-8) var(--space-12) var(--space-8);
+  }
+}
+
+.boarded .b-page {
+  width: 100%;
+  max-width: 680px;
+  margin: 0 auto;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6);
+}
+
+.boarded .b-page-header {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  padding-bottom: var(--space-3);
+  border-bottom: 1px solid var(--color-border-subtle);
+}
+
+/* ==========================================================================
+   Typography Classes
+   ========================================================================== */
+.boarded .b-serif {
+  font-family: var(--font-serif);
+  font-weight: 600;
+  font-style: italic;
+  letter-spacing: -0.015em;
+}
+
+.boarded .b-eyebrow {
+  font-family: var(--font-sans);
+  font-size: 11px;
+  font-weight: 700;
+  line-height: 16px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+}
+
+.boarded .b-muted {
+  color: var(--color-text-secondary);
+}
+
+.boarded .b-tertiary {
+  color: var(--color-text-tertiary);
+  font-size: 13px;
+  line-height: 18px;
+}
+
+/* ==========================================================================
+   Interactive Controls & Buttons (Min 44x44 target)
+   ========================================================================== */
+.boarded .b-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  min-height: 44px;
+  min-width: 44px;
+  padding: 10px 18px;
+  border-radius: var(--radius-md);
+  border: 1px solid var(--color-border-default);
+  background-color: var(--color-bg-elevated);
+  color: var(--color-text-primary);
+  font-family: var(--font-sans);
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 20px;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
+  user-select: none;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.boarded .b-button:hover {
+  background-color: var(--color-bg-subtle);
+  border-color: rgba(244, 242, 235, 0.28);
+}
+
+.boarded .b-button:active {
+  transform: scale(0.98);
+}
+
+.boarded .b-button:disabled {
+  opacity: 0.45;
+  cursor: not-allowed;
+  pointer-events: none;
+}
+
+.boarded .b-button-primary {
+  background-color: var(--color-action-primary);
+  border-color: var(--color-action-primary);
+  color: #FFFFFF;
+}
+
+.boarded .b-button-primary:hover {
+  background-color: var(--color-action-hover);
+  border-color: var(--color-action-hover);
+}
+
+.boarded .b-button-danger {
+  background-color: transparent;
+  border-color: var(--color-danger);
+  color: var(--color-danger);
+}
+
+.boarded .b-button-danger:hover {
+  background-color: rgba(255, 92, 92, 0.12);
+}
+
+.boarded .b-button-ghost {
+  background-color: transparent;
+  border-color: transparent;
+  color: var(--color-text-secondary);
+}
+
+.boarded .b-button-ghost:hover {
+  background-color: var(--color-bg-subtle);
+  color: var(--color-text-primary);
+}
+
+/* Action Chips (Like, Comment, Save, Share) */
+.boarded .b-action-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 44px;
+  padding: 8px 14px;
+  border-radius: var(--radius-md);
+  border: 1px solid var(--color-border-subtle);
+  background-color: rgba(23, 26, 34, 0.7);
+  color: var(--color-text-secondary);
+  font-family: var(--font-sans);
+  font-size: 13px;
+  font-weight: 500;
+  cursor: pointer;
+  text-decoration: none;
+  transition: all 0.15s ease;
+}
+
+.boarded .b-action-chip:hover {
+  background-color: var(--color-bg-subtle);
+  color: var(--color-text-primary);
+  border-color: var(--color-border-default);
+}
+
+.boarded .b-action-chip[data-active="true"] {
+  background-color: var(--color-action-soft);
+  color: var(--color-text-primary);
+  border-color: var(--color-action-primary);
+}
+
+/* ==========================================================================
+   Surfaces, Panels & Facts
+   ========================================================================== */
+.boarded .b-panel {
+  background-color: var(--color-bg-elevated);
+  border: 1px solid var(--color-border-default);
+  border-radius: var(--radius-lg);
+  padding: var(--space-4);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+
+@media (min-width: 640px) {
+  .boarded .b-panel {
+    padding: var(--space-6);
+  }
+}
+
+.boarded .b-shelf {
+  background-color: rgba(10, 11, 16, 0.6);
+  border: 1px solid var(--color-border-subtle);
+  border-radius: var(--radius-md);
+  padding: var(--space-3);
+}
+
+.boarded .b-facts {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-2) var(--space-4);
+  font-size: 13px;
+  line-height: 18px;
+  color: var(--color-text-secondary);
+}
+
+.boarded .b-fact-item {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+/* Status Badges (Sends only in green) */
+.boarded .b-status {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  padding: 4px 10px;
+  border-radius: var(--radius-full);
+  border: 1px solid var(--color-border-default);
+  background-color: rgba(244, 242, 235, 0.06);
+  color: var(--color-text-primary);
+}
+
+.boarded .b-status-sent {
+  background-color: var(--color-send-soft);
+  border-color: rgba(50, 213, 131, 0.35);
+  color: var(--color-send);
+}
+
+.boarded .b-status-attempt {
+  background-color: rgba(244, 242, 235, 0.08);
+  border-color: rgba(244, 242, 235, 0.18);
+  color: var(--color-text-secondary);
+}
+
+/* ==========================================================================
+   Layout Helpers
+   ========================================================================== */
+.boarded .b-stack {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+
+.boarded .b-inline {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+}
+
+.boarded .b-field {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.boarded .b-field label {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--color-text-secondary);
+}
+
+.boarded .b-field input,
+.boarded .b-field textarea,
+.boarded .b-field select {
+  min-height: 44px;
+  padding: 10px 14px;
+  background-color: var(--color-bg-elevated);
+  border: 1px solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  color: var(--color-text-primary);
+  font-family: var(--font-sans);
+  font-size: 15px;
+}
+
+.boarded .b-field input:focus,
+.boarded .b-field textarea:focus,
+.boarded .b-field select:focus {
+  border-color: var(--color-action-primary);
+  outline: 2px solid var(--color-action-primary);
+  outline-offset: 1px;
+}
+
+.boarded .b-errors {
+  color: var(--color-danger);
+  font-size: 13px;
+  line-height: 18px;
+}
+
+/* ==========================================================================
+   Photo Component Styles
+   ========================================================================== */
+.boarded .b-photo {
+  position: relative;
+  width: 100%;
+  border-radius: var(--radius-lg);
+  overflow: hidden;
+  background-color: #12141C;
+  border: 1px solid var(--color-border-subtle);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.boarded .b-photo img {
+  width: 100%;
+  height: auto;
+  max-height: 520px;
+  object-fit: cover;
+  display: block;
+}
+
+.boarded .b-photo-fallback {
+  padding: var(--space-8) var(--space-4);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  gap: var(--space-2);
+  color: var(--color-text-tertiary);
+  width: 100%;
+  min-height: 280px;
+}
+
+/* ==========================================================================
+   Navigation: Desktop Sidebar & Mobile Bottom Navigation
+   ========================================================================== */
+.boarded .b-desktop-nav {
+  display: none;
+}
+
+@media (min-width: 1024px) {
+  .boarded .b-desktop-nav {
+    display: flex;
+    flex-direction: column;
+    width: 260px;
+    flex-shrink: 0;
+    padding: var(--space-8) var(--space-6);
+    border-right: 1px solid var(--color-border-subtle);
+    background-color: var(--color-bg-base);
+    position: sticky;
+    top: 0;
+    height: 100dvh;
+    overflow-y: auto;
+  }
+}
+
+.boarded .b-brand-link {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  text-decoration: none;
+  color: var(--color-text-primary);
+  margin-bottom: var(--space-8);
+}
+
+.boarded .b-brand-logo {
+  font-family: var(--font-serif);
+  font-size: 28px;
+  line-height: 32px;
+  letter-spacing: -0.02em;
+  font-style: italic;
+  font-weight: 600;
+}
+
+.boarded .b-nav-list {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.boarded .b-nav-item {
+  margin: 0;
+}
+
+.boarded .b-nav-link {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  min-height: 44px;
+  padding: 10px 14px;
+  border-radius: var(--radius-md);
+  color: var(--color-text-secondary);
+  font-size: 15px;
+  font-weight: 500;
+  text-decoration: none;
+  transition: all 0.15s ease;
+  border: 1px solid transparent;
+}
+
+.boarded .b-nav-link:hover {
+  background-color: var(--color-bg-subtle);
+  color: var(--color-text-primary);
+}
+
+.boarded .b-nav-link[aria-current="page"] {
+  background-color: var(--color-action-soft);
+  color: var(--color-text-primary);
+  border-color: rgba(52, 92, 255, 0.4);
+  font-weight: 600;
+}
+
+.boarded .b-nav-icon {
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+}
+
+/* Mobile Header (Slim brand header) */
+.boarded .b-mobile-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--color-border-subtle);
+  background-color: var(--color-bg-base);
+  position: sticky;
+  top: 0;
+  z-index: 40;
+}
+
+@media (min-width: 1024px) {
+  .boarded .b-mobile-header {
+    display: none;
+  }
+}
+
+/* Mobile Reachable 5-Destination Navigation */
+.boarded .b-mobile-nav {
+  position: fixed;
+  bottom: 0;
+  left: 0;
+  right: 0;
+  z-index: 50;
+  background-color: var(--color-bg-base);
+  border-top: 1px solid var(--color-border-subtle);
+  padding: 6px 8px env(safe-area-inset-bottom, 8px) 8px;
+  display: flex;
+  justify-content: space-around;
+  align-items: center;
+  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
+}
+
+@media (min-width: 1024px) {
+  .boarded .b-mobile-nav {
+    display: none;
+  }
+}
+
+.boarded .b-mobile-nav-link {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  min-width: 44px;
+  padding: 4px 8px;
+  border-radius: var(--radius-md);
+  color: var(--color-text-secondary);
+  font-size: 11px;
+  font-weight: 500;
+  text-decoration: none;
+  gap: 3px;
+  flex: 1 1 0;
+  max-width: 72px;
+  text-align: center;
+  transition: color 0.15s ease;
+}
+
+.boarded .b-mobile-nav-link[aria-current="page"] {
+  color: var(--color-action-primary);
+  font-weight: 700;
+}
+
+.boarded .b-mobile-nav-link:hover {
+  color: var(--color-text-primary);
+}
+
+/* ==========================================================================
+   High Contrast & Reduced Motion Media Queries
+   ========================================================================== */
+@media (forced-colors: active) {
+  .boarded :focus-visible {
+    outline: 2px solid Highlight;
+    box-shadow: none;
+  }
+  .boarded .b-panel,
+  .boarded .b-button,
+  .boarded .b-status,
+  .boarded .b-action-chip,
+  .boarded .b-nav-link {
+    border: 1px solid ButtonText;
+  }
+  .boarded .b-button-primary {
+    background-color: Highlight;
+    color: HighlightText;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .boarded,
+  .boarded *,
+  .boarded *::before,
+  .boarded *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
